 		session := tcpNat.LookupBack(connPort)
@@ -403,6 +415,43 @@ func (s *System) acceptLoop(listener net.Listener, tcpNat *TCPNat) {
 	}
 }
 
+// relisten replaces a TCP listener that failed without being closed by us. Android can destroy it
+// (SOCK_DESTROY, e.g. while the VPN is rebuilt); without a new one, every new TCP connection is
+// refused until the stack restarts. Listens again on the same address and port, so the NAT keeps
+// working. Returns nil once the stack is closed.
+func (s *System) relisten(old net.Listener, network string, cause error) net.Listener {
+	if errors.Is(cause, net.ErrClosed) {
+		return nil
+	}
+	address := old.Addr().String()
+	old.Close()
+	s.logger.Warn("tcp listener ", address, " lost (", cause, "), listening again")
+	for {
+		time.Sleep(100 * time.Millisecond)
+		if s.ctx.Err() != nil {
+			return nil
+		}
+		s.listenerAccess.Lock()
+		if s.closed {
+			s.listenerAccess.Unlock()
+			return nil
+		}
+		listener, err := listenNetworkNamespace(s.ctx, s.netNs, s.listenConfig, network, address)
+		if err == nil {
+			if network == "tcp4" {
+				s.tcpListener = listener
+			} else {
+				s.tcpListener6 = listener
+			}
+			s.listenerAccess.Unlock()
+			return listener
+		}
+		s.listenerAccess.Unlock()
+		s.logger.Warn("listen again on ", address, ": ", err)
+		time.Sleep(time.Second)
+	}
+}
