@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.util.Log
+import io.nekohasekai.libbox.Libbox
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bg.BoxService
+import io.nekohasekai.sfa.bitproxy.config.ConfigGenerator
+import io.nekohasekai.sfa.bitproxy.config.GenerateResult
+import io.nekohasekai.sfa.bitproxy.config.GeneratorInput
+import io.nekohasekai.sfa.database.Profile
+import io.nekohasekai.sfa.database.ProfileManager
+import io.nekohasekai.sfa.database.Settings
+import io.nekohasekai.sfa.database.TypedProfile
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/**
+ * Generate -> check with libbox -> save into the "BitProxy" profile -> select it -> reload.
+ * Any failure before the save leaves the running config untouched (fail safe).
+ */
+object BitProxyApplier {
+    private const val TAG = "BitProxy"
+    const val PROFILE_NAME = "BitProxy"
+    private val lock = Mutex() // Apply button, network changes and app installs may race
+
+    sealed interface Outcome {
+        data class Applied(val result: GenerateResult.Ok, val reloaded: Boolean) : Outcome
+
+        data class Failed(val message: String) : Outcome
+    }
+
+    /** The config that was active before the latest Apply (every saved config passed the check). */
+    private val previousFile get() = File(BitProxyStore.dir, "previous.json")
+
+    val hasPrevious: Boolean get() = previousFile.isFile
+
+    /** [serviceRunning]: reload the running service; otherwise just save and select. */
+    suspend fun apply(serviceRunning: Boolean, ipv6: Boolean = false): Outcome = lock.withLock {
+        withContext(Dispatchers.IO) {
+            val outcome = try {
+                applyLocked(serviceRunning, ipv6)
+            } catch (e: Exception) {
+                Log.e(TAG, "apply failed", e)
+                Outcome.Failed("Unexpected error: ${e.message ?: e.javaClass.simpleName}")
+            }
+            BitProxyPrefs.recordApply(outcome)
+            outcome
+        }
+    }
+
+    private suspend fun applyLocked(serviceRunning: Boolean, ipv6: Boolean): Outcome {
+        val servers = BitProxyStore.servers()
+        val routes = AppResolver.scan().routes(BitProxyPrefs.apps)
+        val result = ConfigGenerator.generate(GeneratorInput(servers.map { it.conf }, BitProxyPrefs.selectedServer, routes, ipv6))
+        if (result is GenerateResult.Error) return Outcome.Failed(result.message)
+        result as GenerateResult.Ok
+        val json = result.json
+
+        try {
+            Libbox.checkConfig(json)
+        } catch (e: Exception) {
+            return Outcome.Failed("sing-box rejected the generated config: ${e.message}")
+        }
+
+        val profile = ensureProfile()
+        val file = File(profile.typed.path)
+        val old = file.takeIf { it.isFile }?.readText()
+        if (old == json) return Outcome.Applied(result, activate(profile, serviceRunning))
+        if (old != null && old != "{}") previousFile.writeText(old)
+        writeAtomically(file, json)
+        Log.i(TAG, "applied: server=${result.selectedTag} tun=${result.tunAddresses} rules=${result.appRuleCount}")
+        return Outcome.Applied(result, activate(profile, serviceRunning))
+    }
+
+    /** Swaps the previous config back in (and keeps the current one as "previous"). Returns a message. */
+    suspend fun restorePrevious(serviceRunning: Boolean): String = lock.withLock {
+        withContext(Dispatchers.IO) {
+            try {
+                val json = previousFile.readText()
+                Libbox.checkConfig(json)
+                val profile = ensureProfile()
+                val file = File(profile.typed.path)
+                val current = file.takeIf { it.isFile }?.readText()
+                writeAtomically(file, json)
+                if (current != null && current != "{}") previousFile.writeText(current)
+                "Restored the previous config" + if (activate(profile, serviceRunning)) " and reloaded" else ""
+            } catch (e: Exception) {
+                "Could not restore: ${e.message}"
+            }
+        }
+    }
+
+    /** The profile BitProxy owns; recreated if the user deleted it. */
+    suspend fun ensureProfile(): Profile {
+        ProfileManager.get(BitProxyPrefs.profileId)?.let { return it }
+        val typed = TypedProfile().apply { type = TypedProfile.Type.Local }
+        val dir = File(Application.application.filesDir, "configs").apply { mkdirs() }
+        typed.path = File(dir, "${ProfileManager.nextFileID()}.json").path
+        val profile = Profile(name = PROFILE_NAME, typed = typed).apply { userOrder = ProfileManager.nextOrder() }
+        File(typed.path).writeText("{}")
+        return ProfileManager.create(profile).also { BitProxyPrefs.profileId = it.id }
+    }
+
+    /** Selects the profile and reloads the service if it is running. Returns true if reloaded. */
+    private suspend fun activate(profile: Profile, serviceRunning: Boolean): Boolean {
+        Settings.selectedProfile = profile.id
+        val modeChanged = Settings.rebuildServiceMode()
+        if (!serviceRunning) return false
+        if (modeChanged) {
+            // Switching from a proxy-only profile to VPN mode needs a full restart.
+            BoxService.stop()
+            delay(1500) // ponytail: fixed wait for the old service to stop; poll status if restarts race
+            BoxService.start()
+            return true
+        }
+        return runCatching { Libbox.newStandaloneCommandClient().serviceReload() }
+            .onFailure { Log.w(TAG, "reload failed", it) }
+            .isSuccess
+    }
+
+    private fun writeAtomically(file: File, text: String) {
+        val tmp = File(file.parentFile, file.name + ".tmp")
+        tmp.writeText(text)
+        if (!tmp.renameTo(file)) {
+            tmp.delete()
+            error("could not write ${file.path}")
+        }
+    }
+}
