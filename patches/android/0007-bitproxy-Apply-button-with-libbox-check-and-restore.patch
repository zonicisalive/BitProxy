+
+    /** Last Apply result, shown on the Diagnostics screen. */
+    val lastApply: String? get() = prefs.getString("last_apply", null)
+
+    fun recordApply(outcome: BitProxyApplier.Outcome) {
+        val time = java.text.DateFormat.getDateTimeInstance().format(java.util.Date())
+        val text = when (outcome) {
+            is BitProxyApplier.Outcome.Applied -> "OK ($time): ${outcome.result.selectedTag}, ${outcome.result.appRuleCount} app rules"
+            is BitProxyApplier.Outcome.Failed -> "FAILED ($time): ${outcome.message}"
+        }
+        prefs.edit { putString("last_apply", text) }
+    }
 }
