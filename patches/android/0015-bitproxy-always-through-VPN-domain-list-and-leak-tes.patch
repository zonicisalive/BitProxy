From 2ccbac3adf7a42b6b7e0db9b64f593082b0724f9 Mon Sep 17 00:00:00 2001
From: ZonicExists <71136987+zonicisalive@users.noreply.github.com>
Date: Fri, 25 Sep 2026 00:41:52 +0530
Subject: [PATCH 15/39] bitproxy: 'always through VPN' domain list and leak
 test

Optional list of domains (with subdomains) that use the VPN even from
Direct apps; their DNS goes to the remote server too, so the lookup
doesn't leak and fails closed when the server is down. Rule order keeps
sniffing away from VPN apps: hijack-dns, VPN app rules, sniff, domains,
Direct app rules. With an empty list the config has no sniff rule at
all. 'Leak test' opens ipleak.net via the app chooser so it can be run
in a VPN app and a Direct app.
---
 .../sfa/bitproxy/BitProxyApplier.kt           |  2 +-
 .../nekohasekai/sfa/bitproxy/BitProxyPrefs.kt |  5 +++
 .../sfa/bitproxy/config/ConfigGenerator.kt    | 25 +++++++++++--
 .../sfa/bitproxy/ui/BitProxyScreen.kt         | 36 +++++++++++++++++++
 .../bitproxy/config/ConfigGeneratorTest.kt    | 20 +++++++++++
 5 files changed, 85 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyApplier.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyApplier.kt
index da2954e..54122cc 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyApplier.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyApplier.kt
@@ -56,7 +56,7 @@ object BitProxyApplier {
     private suspend fun applyLocked(serviceRunning: Boolean, ipv6: Boolean): Outcome {
         val servers = BitProxyStore.servers()
         val routes = AppResolver.scan().routes(BitProxyPrefs.apps)
-        var result = when (val r = ConfigGenerator.generate(GeneratorInput(servers.map { it.conf }, BitProxyPrefs.selectedServer, routes, ipv6, BitProxyPrefs.autoPick))) {
+        var result = when (val r = ConfigGenerator.generate(GeneratorInput(servers.map { it.conf }, BitProxyPrefs.selectedServer, routes, ipv6, BitProxyPrefs.autoPick, BitProxyPrefs.vpnDomains))) {
             is GenerateResult.Error -> return Outcome.Failed(r.message)
             is GenerateResult.Ok -> r
         }
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyPrefs.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyPrefs.kt
index e3b7c35..ec01f42 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyPrefs.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyPrefs.kt
@@ -43,6 +43,11 @@ object BitProxyPrefs {
         get() = prefs.getBoolean("applied_ipv6", false)
         set(value) = prefs.edit { putBoolean("applied_ipv6", value) }
 
+    /** One domain per line; each also matches its subdomains. */
+    var vpnDomains: List<String>
+        get() = prefs.getString("vpn_domains", "")!!.lines().map { it.trim() }.filter { it.isNotEmpty() }
+        set(value) = prefs.edit { putString("vpn_domains", value.joinToString("\n")) }
+
     var autoPick: Boolean
         get() = prefs.getBoolean("auto_pick", false)
         set(value) = prefs.edit { putBoolean("auto_pick", value) }
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/config/ConfigGenerator.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/config/ConfigGenerator.kt
index eeff66e..01b37ce 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/config/ConfigGenerator.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/config/ConfigGenerator.kt
@@ -33,6 +33,8 @@ data class GeneratorInput(
     val ipv6: Boolean = false,
     /** "VPN" becomes a urltest group that picks the fastest server instead of a manual selector. */
     val autoPick: Boolean = false,
+    /** Domains (and their subdomains) that always go through the VPN, also for Direct apps. */
+    val vpnDomains: List<String> = emptyList(),
 )
 
 sealed interface GenerateResult {
@@ -118,6 +120,7 @@ object ConfigGenerator {
             usedTags += tag
             tag to app
         }
+        val domains = input.vpnDomains.map { it.trim().trimStart('.').lowercase() }.filter { it.isNotEmpty() }.distinct()
         val vpnUids = routes.filter { it.second.viaVpn }.flatMap { it.second.uids }.distinct().sorted()
 
         val config = buildJsonObject {
@@ -144,6 +147,12 @@ object ConfigGenerator {
                             put("server", "remote")
                         }
                     }
+                    if (domains.isNotEmpty()) {
+                        addJsonObject {
+                            put("domain_suffix", buildJsonArray { domains.forEach { add(it) } })
+                            put("server", "remote")
+                        }
+                    }
                 }
                 put("final", "local")
             }
@@ -197,13 +206,25 @@ object ConfigGenerator {
                         put("action", "hijack-dns")
                     }
                     // user_id, not package_name: package rules did not match on OxygenOS.
-                    // No "sniff" before these rules: it stopped pre-match and stalled TCP.
-                    for ((tag, app) in routes) {
+                    // No "sniff" before the VPN app rules: it stopped pre-match and stalled TCP.
+                    // With a VPN domain list, sniffing happens only after them, for Direct apps.
+                    fun appRules(filter: (AppRoute) -> Boolean) = routes.filter { filter(it.second) }.forEach { (tag, app) ->
                         addJsonObject {
                             put("user_id", intArray(app.uids.sorted()))
                             put("outbound", tag)
                         }
                     }
+                    if (domains.isEmpty()) {
+                        appRules { true }
+                    } else {
+                        appRules { it.viaVpn }
+                        addJsonObject { put("action", "sniff") }
+                        addJsonObject {
+                            put("domain_suffix", buildJsonArray { domains.forEach { add(it) } })
+                            put("outbound", VPN)
+                        }
+                        appRules { !it.viaVpn }
+                    }
                 }
                 put("final", DIRECT)
             }
