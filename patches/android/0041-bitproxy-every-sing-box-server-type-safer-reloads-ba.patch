index 0000000..e402392
--- /dev/null
+++ b/app/src/test/java/io/nekohasekai/sfa/bitproxy/servers/OpenVpnProfileTest.kt
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.servers
+
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class OpenVpnProfileTest {
+    // Shape of a provider export; certificate and key bodies are dummies.
+    private val ovpn = """
+        client
+        dev tun
+        proto udp
+        remote a.example.com 1194
+        remote b.example.com 443 tcp
+        remote-random
+        cipher AES-256-GCM
+        auth SHA512
+        auth-user-pass
+        remote-cert-tls server
+        verify-x509-name server.example.com name
+        key-direction 1
+        <ca>
+        -----BEGIN CERTIFICATE-----
+        AAAA
+        -----END CERTIFICATE-----
+        </ca>
+        <tls-auth>
+        -----BEGIN OpenVPN Static key V1-----
+        BBBB
+        -----END OpenVPN Static key V1-----
+        </tls-auth>
+    """.trimIndent()
+
+    @Test fun providerProfile() {
+        assertTrue(OpenVpnProfile.looksLikeOvpn(ovpn))
+        val o = OpenVpnProfile.parse(ovpn, "Provider").server.options
+        val servers = o["servers"]!!.jsonArray.map { it.jsonObject }
+        assertEquals(listOf("udp", "tcp"), servers.map { it["network"]!!.jsonPrimitive.content })
+        assertEquals("443", servers[1]["server_port"]!!.jsonPrimitive.content)
+        val tls = o["tls"]!!.jsonObject
+        assertEquals("server.example.com", tls["server_name"]!!.jsonPrimitive.content)
+        assertEquals("tls_auth", tls["control_wrap"]!!.jsonObject["type"]!!.jsonPrimitive.content)
+        assertEquals("client", tls["control_wrap"]!!.jsonObject["direction"]!!.jsonPrimitive.content)
+        assertEquals(3, tls["certificate"]!!.jsonArray.size)
+        assertTrue(OpenVpnProfile.needsLogin(o))
+        assertFalse(OpenVpnProfile.needsLogin(OpenVpnProfile.withLogin(o, "user", "pw")))
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun separateCaFileIsRejected() {
+        OpenVpnProfile.parse("client\ndev tun\nremote a.example 1194\nca ca.crt\n", "x")
+    }
+}
diff --git a/app/src/test/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinksTest.kt b/app/src/test/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinksTest.kt
new file mode 100644
index 0000000..96a5a2f
--- /dev/null
+++ b/app/src/test/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinksTest.kt
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.servers
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/** Dummy UUIDs, passwords and keys only. */
+@OptIn(ExperimentalEncodingApi::class)
+class ShareLinksTest {
+    private val uuid = "2ac6f397-4c38-4907-8644-6e1c1e7166ff"
+
+    private fun one(link: String) = ShareLinks.parse(link).also { assertEquals(emptyList<String>(), it.errors) }.servers.single()
+    private fun JsonObject.s(path: String): String? = path.split('.').fold(this as kotlinx.serialization.json.JsonElement?) { e, k -> (e as? JsonObject)?.get(k) }?.jsonPrimitive?.content
+
+    @Test fun vlessRealityVision() {
+        val p = one("vless://$uuid@example.com:443?security=reality&sni=www.microsoft.com&fp=chrome&pbk=PUBKEY&sid=0123abcd&flow=xtls-rprx-vision&type=tcp#My%20Server")
+        assertEquals("My Server", p.name)
+        assertEquals("vless", p.type)
+        assertEquals("xtls-rprx-vision", p.options.s("flow"))
+        assertEquals("PUBKEY", p.options.s("tls.reality.public_key"))
+        assertEquals("chrome", p.options.s("tls.utls.fingerprint"))
+        assertEquals("www.microsoft.com", p.options.s("tls.server_name"))
+    }
+
+    @Test fun vlessWebSocketEarlyData() {
+        val p = one("vless://$uuid@example.com:443?security=tls&type=ws&host=cdn.example.com&path=%2Fws%3Fed%3D2048#ws")
+        assertEquals("/ws", p.options.s("transport.path"))
+        assertEquals("2048", p.options.s("transport.max_early_data"))
+        assertEquals("cdn.example.com", p.options.s("transport.headers.Host"))
+    }
+
+    @Test fun vmessV2rayN() {
+        val json = """{"v":"2","ps":"vm","add":"example.com","port":"8443","id":"$uuid","aid":"0","net":"grpc","path":"svc","tls":"tls","sni":"example.com"}"""
+        val p = one("vmess://" + Base64.encode(json.toByteArray()))
+        assertEquals("vm", p.name)
+        assertEquals("8443", p.options.s("server_port"))
+        assertEquals("grpc", p.options.s("transport.type"))
+        assertEquals("svc", p.options.s("transport.service_name"))
+        assertEquals("true", p.options.s("tls.enabled"))
+    }
+
+    @Test fun shadowsocksForms() {
+        val sip002 = one("ss://" + Base64.encode("aes-256-gcm:pa+ss".toByteArray()).trimEnd('=') + "@1.2.3.4:8388#ss")
+        assertEquals("aes-256-gcm", sip002.options.s("method"))
+        assertEquals("pa+ss", sip002.options.s("password"))
+        val plain = one("ss://2022-blake3-aes-128-gcm:c2VjcmV0c2VjcmV0MTIzNA%3D%3D@[2001:db8::1]:443#v6")
+        assertEquals("2001:db8::1", plain.options.s("server"))
+        assertEquals("c2VjcmV0c2VjcmV0MTIzNA==", plain.options.s("password"))
+        val legacy = one("ss://" + Base64.encode("chacha20-ietf-poly1305:pw@host.example:1234".toByteArray()) + "#old")
+        assertEquals("host.example", legacy.options.s("server"))
+    }
+
+    @Test fun quicProtocols() {
+        val hy2 = one("hy2://secret@example.com:443?sni=a.example&obfs=salamander&obfs-password=x&insecure=1#h")
+        assertEquals("hysteria2", hy2.type)
+        assertEquals("salamander", hy2.options.s("obfs.type"))
+        assertEquals("true", hy2.options.s("tls.insecure"))
+        val tuic = one("tuic://$uuid:pw@example.com:443?congestion_control=bbr#t")
+        assertEquals("pw", tuic.options.s("password"))
+        assertEquals("h3", tuic.options["tls"]!!.jsonObject["alpn"]!!.jsonArray.single().jsonPrimitive.content)
+    }
+
+    @Test fun trojanSocksHttpAnytls() {
+        assertEquals("true", one("trojan://pw@example.com:443#t").options.s("tls.enabled"))
+        val socks = one("socks://u:p@1.2.3.4:1080#s")
+        assertEquals("u", socks.options.s("username"))
+        assertEquals("443", one("https://u:p@proxy.example#h").options.s("server_port"))
+        assertEquals("anytls", one("anytls://pw@example.com:443#a").type)
+    }
+
+    @Test fun base64SubscriptionAndErrors() {
+        val sub = Base64.encode("trojan://pw@a.example:443#one\nvless://$uuid@b.example:443?type=xhttp#bad\n".toByteArray())
+        val r = ShareLinks.parse(sub)
+        assertEquals(listOf("one"), r.servers.map { it.name })
+        assertTrue(r.errors.single().contains("xhttp"))
+    }
+}
