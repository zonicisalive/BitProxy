index 0000000..2854ca0
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/servers/ServerImport.kt
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.servers
+
+import io.nekohasekai.sfa.bitproxy.config.ProxyServer
+import io.nekohasekai.sfa.bitproxy.providers.Http
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/**
+ * Works out what an imported file or pasted text is: WireGuard .conf, OpenVPN .ovpn, sing-box JSON
+ * (one outbound/endpoint, a list, or a whole config), share links or a subscription. Pure except
+ * for [fetchSubscription].
+ */
+object ServerImport {
+    data class Parsed(
+        /** WireGuard configs, kept as text: (file name, content). */
+        val wireGuard: List<Pair<String, String>> = emptyList(),
+        val proxies: List<ProxyServer> = emptyList(),
+        val messages: List<String> = emptyList(),
+    )
+
+    fun parse(text: String, fileName: String): Parsed {
+        val t = text.removePrefix("﻿").trim()
+        return when {
+            Regex("""(?im)^\s*\[Interface]""").containsMatchIn(t) -> Parsed(wireGuard = listOf(fileName to text))
+            t.startsWith("{") || t.startsWith("[") -> json(t, fileName)
+            fileName.endsWith(".ovpn", ignoreCase = true) || OpenVpnProfile.looksLikeOvpn(t) -> {
+                val r = OpenVpnProfile.parse(t, fileName.substringAfterLast('/').replace(Regex("""\.(ovpn|conf|txt)$""", RegexOption.IGNORE_CASE), ""))
+                Parsed(proxies = listOf(r.server), messages = r.warnings)
+            }
+            else -> ShareLinks.parse(t).let { r ->
+                if (r.servers.isEmpty() && r.errors.isEmpty()) Parsed(messages = listOf("$fileName: not a WireGuard, OpenVPN, sing-box JSON or share-link file"))
+                else Parsed(proxies = r.servers, messages = r.errors)
+            }
+        }
+    }
+
+    /** A subscription address (https://…/path), not an HTTP proxy link (which has user:pass@ or no path). */
+    fun isSubscriptionUrl(text: String): Boolean {
+        val t = text.trim()
+        if ('\n' in t || !(t.startsWith("https://") || t.startsWith("http://"))) return false
+        val uri = runCatching { java.net.URI(t) }.getOrNull() ?: return false
+        return uri.rawUserInfo == null && (uri.rawPath.orEmpty().length > 1 || uri.rawQuery != null)
+    }
+
+    /** Downloads a subscription (share links, base64 list or sing-box JSON). Network I/O. */
+    fun fetchSubscription(url: String): Parsed {
+        val body = Http.request(url.trim(), headers = mapOf("User-Agent" to "sing-box BitProxy"), error = { code, _ -> "Subscription download failed (HTTP $code)" })
+        return parse(body, url.substringAfterLast('/').substringBefore('?').ifBlank { "subscription" })
+    }
+
+    /** One outbound/endpoint object, an array of them, or a config with "outbounds"/"endpoints". */
+    private fun json(text: String, fileName: String): Parsed {
+        val root = runCatching { Http.json(text) }.getOrElse { return Parsed(messages = listOf("$fileName: invalid JSON (${it.message})")) }
+        val items: List<JsonElement> = when {
+            root is JsonArray -> root
+            root is JsonObject && ("outbounds" in root || "endpoints" in root) ->
+                (root["endpoints"] as? JsonArray).orEmpty() + (root["outbounds"] as? JsonArray).orEmpty()
+            else -> listOf(root)
+        }
+        val messages = mutableListOf<String>()
+        val proxies = items.mapNotNull { it as? JsonObject }.mapNotNull { o ->
+            val type = o["type"]?.jsonPrimitive?.content.orEmpty()
+            if (type in ProxyServer.NOT_SERVERS) return@mapNotNull null
+            if (type == "wireguard") {
+                messages += "WireGuard in JSON is skipped: import it as a .conf file (the tunnel address must match the TUN)"
+                return@mapNotNull null
+            }
+            val name = o["tag"]?.jsonPrimitive?.content?.takeIf { it.isNotBlank() } ?: "$type ${o["server"]?.jsonPrimitive?.content.orEmpty()}".trim()
+            // Tags are renamed on import, so a chain to another outbound can't be kept.
+            if ("detour" in o) messages += "$name: \"detour\" removed (chains to other outbounds aren't supported)"
+            ProxyServer(name, JsonObject(o - "tag" - "detour"))
+        }
+        if (proxies.isEmpty()) messages += "$fileName: no server outbounds in this JSON"
+        return Parsed(proxies = proxies, messages = messages)
+    }
+}
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinks.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinks.kt
new file mode 100644
index 0000000..af4fe0c
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/servers/ShareLinks.kt
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.servers
+
+import io.nekohasekai.sfa.bitproxy.config.ProxyServer
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonObjectBuilder
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+import java.net.URI
+import java.net.URLDecoder
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/**
+ * Share links (as used by v2rayN, NekoBox, Shadowrocket, sing-box clients) to sing-box outbounds:
+ * vless, vmess, trojan, ss, hysteria2/hy2, hysteria, tuic, anytls, socks, http(s), naive+https, ssh.
+ * A subscription (base64 or plain list of links) works too. Pure Kotlin, unit tested.
+ */
+@OptIn(ExperimentalEncodingApi::class)
+object ShareLinks {
+    data class Result(val servers: List<ProxyServer>, val errors: List<String>)
+
+    private val SCHEMES = setOf(
+        "vless", "vmess", "trojan", "ss", "hysteria2", "hy2", "hysteria", "tuic", "anytls",
+        "socks", "socks5", "socks5h", "http", "https", "naive+https", "naive+http", "ssh",
+    )
+
+    /** True if [text] looks like one or more share links (possibly base64-wrapped). */
+    fun looksLikeLinks(text: String) = links(text).isNotEmpty()
+
+    fun parse(text: String): Result {
+        val servers = mutableListOf<ProxyServer>()
+        val errors = mutableListOf<String>()
+        for (link in links(text)) {
+            try {
+                servers += parseLink(link)
+            } catch (e: Exception) {
+                errors += "${link.substringBefore("://")} link: ${e.message ?: e.javaClass.simpleName}"
+            }
+        }
+        return Result(servers, errors)
+    }
+
+    private fun links(text: String): List<String> {
+        fun find(t: String) = t.lines().map { it.trim() }.filter { l -> l.substringBefore("://", "").lowercase() in SCHEMES }
+        find(text).takeIf { it.isNotEmpty() }?.let { return it }
+        // Subscriptions are often one base64 blob.
+        return decodeBase64(text.filterNot { it.isWhitespace() })?.let(::find).orEmpty()
+    }
+
+    fun parseLink(link: String): ProxyServer {
+        val scheme = link.substringBefore("://").lowercase()
+        if (scheme == "vmess") return vmess(link)
+        if (scheme == "ss") return shadowsocks(link)
+        val uri = URI(link.replace(" ", "%20"))
+        val q = query(uri.rawQuery)
+        val host = uri.host?.removeSurrounding("[", "]") ?: throw IllegalArgumentException("no server address")
+        val user = uri.rawUserInfo?.let(::decode)
+        val name = uri.rawFragment?.let(::decode)?.takeIf { it.isNotBlank() }
+        fun portOr(default: Int) = uri.port.takeIf { it > 0 } ?: default
+        val options = when (scheme) {
+            "vless" -> obj("vless", host, portOr(443)) {
+                put("uuid", user ?: throw IllegalArgumentException("no UUID"))
+                q["flow"]?.takeIf { it.isNotBlank() }?.let { put("flow", it) }
+                q["packetEncoding"]?.let { put("packet_encoding", it) } ?: put("packet_encoding", "xudp")
+                tls(q, default = false)
+                transport(q)
+            }
+            "trojan" -> obj("trojan", host, portOr(443)) {
+                put("password", user ?: throw IllegalArgumentException("no password"))
+                tls(q, default = true)
+                transport(q)
+            }
+            "hysteria2", "hy2" -> obj("hysteria2", host, portOr(443)) {
+                user?.let { put("password", it) }
+                q["mport"]?.takeIf { it.isNotBlank() }?.let { ports -> putJsonArray("server_ports") { ports.split(',').forEach { add(it.replace('-', ':')) } } }
+                q["obfs"]?.takeIf { it.isNotBlank() && it != "none" }?.let { type ->
+                    putJsonObject("obfs") {
+                        put("type", type)
+                        put("password", q["obfs-password"].orEmpty())
+                    }
+                }
+                tls(q, default = true, quic = true)
+            }
+            "hysteria" -> obj("hysteria", host, portOr(443)) {
+                q["auth"]?.let { put("auth_str", it) }
+                q["upmbps"]?.toIntOrNull()?.let { put("up_mbps", it) } ?: put("up_mbps", 50)
+                q["downmbps"]?.toIntOrNull()?.let { put("down_mbps", it) } ?: put("down_mbps", 200)
+                q["obfsParam"]?.takeIf { it.isNotBlank() }?.let { put("obfs", it) }
+                tls(q + listOfNotNull(q["peer"]?.let { "sni" to it }).toMap(), default = true, quic = true)
+            }
+            "tuic" -> obj("tuic", host, portOr(443)) {
+                val (uuid, password) = (user ?: throw IllegalArgumentException("no UUID")).split(':', limit = 2).let { it[0] to it.getOrElse(1) { "" } }
+                put("uuid", uuid)
+                put("password", password)
+                q["congestion_control"]?.let { put("congestion_control", it) }
+                q["udp_relay_mode"]?.let { put("udp_relay_mode", it) }
+                tls(q + ("alpn" to (q["alpn"] ?: "h3")), default = true, quic = true)
+            }
+            "anytls" -> obj("anytls", host, portOr(443)) {
+                put("password", user ?: throw IllegalArgumentException("no password"))
+                tls(q, default = true)
+            }
+            "socks", "socks5", "socks5h" -> obj("socks", host, portOr(1080)) {
+                put("version", "5")
+                credentials(user)
+            }
+            "http", "https" -> obj("http", host, portOr(if (scheme == "https") 443 else 80)) {
+                credentials(user)
+                if (scheme == "https") tls(q, default = true)
+            }
+            "naive+https", "naive+http" -> obj("naive", host, portOr(443)) {
+                credentials(user)
+                tls(q, default = true)
+            }
+            "ssh" -> obj("ssh", host, portOr(22)) {
+                val (u, p) = (user ?: "root").split(':', limit = 2).let { it[0] to it.getOrNull(1) }
+                put("user", u)
+                p?.let { put("password", it) }
+            }
+            else -> throw IllegalArgumentException("unsupported link type")
+        }
+        return ProxyServer(name ?: defaultName(scheme, host, uri.port), options)
+    }
+
+    /** vmess://base64({"v":"2","ps":name,"add":host,"port":..,"id":uuid,"net":"ws","tls":"tls",...}) */
+    private fun vmess(link: String): ProxyServer {
+        val raw = link.substringAfter("://").substringBefore('#')
+        val json = decodeBase64(raw) ?: throw IllegalArgumentException("not a v2rayN vmess link")
+        val v = io.nekohasekai.sfa.bitproxy.providers.Http.json(json).jsonObject
+        fun f(k: String) = v[k]?.jsonPrimitive?.content?.takeIf { it.isNotBlank() }
+        val host = f("add") ?: throw IllegalArgumentException("no server address")
+        val port = f("port")?.toIntOrNull() ?: 443
+        val q = buildMap {
+            f("net")?.let { put("type", it) }
+            f("path")?.let { put("path", it) }
+            f("host")?.let { put("host", it) }
+            f("path")?.takeIf { f("net") == "grpc" }?.let { put("serviceName", it) }
+            f("sni")?.let { put("sni", it) }
+            f("alpn")?.let { put("alpn", it) }
+            f("fp")?.let { put("fp", it) }
+            if (f("tls") == "tls") put("security", "tls")
+            if (f("allowInsecure") == "1" || f("allowInsecure") == "true") put("allowInsecure", "1")
+        }
+        val options = obj("vmess", host, port) {
+            put("uuid", f("id") ?: throw IllegalArgumentException("no UUID"))
+            put("security", f("scy") ?: "auto")
+            put("alter_id", f("aid")?.toIntOrNull() ?: 0)
+            put("packet_encoding", "xudp")
+            tls(q, default = false)
+            transport(q)
+        }
+        return ProxyServer(f("ps") ?: defaultName("vmess", host, port), options)
+    }
+
+    /** SIP002 ss://base64(method:password)@host:port or ss://method:password@host:port, and the old ss://base64(all). */
+    private fun shadowsocks(link: String): ProxyServer {
+        var body = link.substringAfter("://")
+        val name = body.substringAfter('#', "").takeIf { it.isNotBlank() }?.let(::decode)
+        body = body.substringBefore('#')
+        val query = query(body.substringAfter('?', ""))
+        body = body.substringBefore('?').removeSuffix("/")
+        if ('@' !in body) body = decodeBase64(body) ?: throw IllegalArgumentException("unreadable ss link")
+        val userInfo = body.substringBeforeLast('@')
+        val hostPort = body.substringAfterLast('@')
+        val creds = if (':' in decode(userInfo)) decode(userInfo) else decodeBase64(userInfo) ?: throw IllegalArgumentException("unreadable method/password")
+        val method = creds.substringBefore(':')
+        val password = creds.substringAfter(':')
+        val host = hostPort.substringBeforeLast(':').removeSurrounding("[", "]")
+        val port = hostPort.substringAfterLast(':').toIntOrNull() ?: throw IllegalArgumentException("no port")
+        val options = obj("shadowsocks", host, port) {
+            put("method", method)
+            put("password", password)
+            query["plugin"]?.takeIf { it.isNotBlank() }?.let { plugin ->
+                put("plugin", plugin.substringBefore(';'))
+                plugin.substringAfter(';', "").takeIf { it.isNotBlank() }?.let { put("plugin_opts", it) }
+            }
+        }
+        return ProxyServer(name ?: defaultName("ss", host, port), options)
+    }
+
+    private fun obj(type: String, host: String, port: Int, body: JsonObjectBuilder.() -> Unit): JsonObject = buildJsonObject {
+        put("type", type)
+        put("server", host)
+        put("server_port", port)
+        body()
+    }
+
+    private fun JsonObjectBuilder.credentials(user: String?) {
+        user ?: return
+        // Some clients base64 the whole user:pass.
+        val plain = if (':' in user) user else decodeBase64(user)?.takeIf { ':' in it } ?: user
+        put("username", plain.substringBefore(':'))
+        plain.substringAfter(':', "").takeIf { it.isNotEmpty() }?.let { put("password", it) }
+    }
+
+    /** security=tls|reality|none, sni, alpn, fp, pbk, sid, allowInsecure/insecure. */
+    private fun JsonObjectBuilder.tls(q: Map<String, String>, default: Boolean, quic: Boolean = false) {
+        val security = q["security"]?.lowercase()
+        val enabled = when (security) {
+            "tls", "reality", "xtls" -> true
+            "none", "" -> false
+            else -> default
+        }
+        if (!enabled && !quic) return
+        putJsonObject("tls") {
+            put("enabled", true)
+            (q["sni"] ?: q["peer"])?.takeIf { it.isNotBlank() }?.let { put("server_name", it) }
+            if (q["allowInsecure"] == "1" || q["insecure"] == "1" || q["allow_insecure"] == "1" || q["allowInsecure"] == "true") put("insecure", true)
+            q["alpn"]?.takeIf { it.isNotBlank() }?.let { alpn -> putJsonArray("alpn") { alpn.split(',').forEach { add(it.trim()) } } }
+            val fp = q["fp"]?.takeIf { it.isNotBlank() && it != "none" }
+            if (fp != null || security == "reality") {
+                putJsonObject("utls") {
+                    put("enabled", true)
+                    put("fingerprint", fp ?: "chrome")
+                }
+            }
+            if (security == "reality") {
+                putJsonObject("reality") {
+                    put("enabled", true)
+                    put("public_key", q["pbk"] ?: throw IllegalArgumentException("REALITY link without public key (pbk)"))
+                    q["sid"]?.let { put("short_id", it) }
+                }
+            }
+        }
+    }
+
+    /** type=tcp|ws|grpc|http|h2|httpupgrade with path, host, serviceName. */
+    private fun JsonObjectBuilder.transport(q: Map<String, String>) {
+        when (val type = q["type"]?.lowercase() ?: "tcp") {
+            "tcp", "", "raw" -> Unit
+            "ws" -> putJsonObject("transport") {
+                put("type", "ws")
+                var path = q["path"] ?: "/"
+                // "?ed=2048" in the path is Xray's early data: sing-box has its own fields for it.
+                Regex("""[?&]ed=(\d+)""").find(path)?.let {
+                    put("max_early_data", it.groupValues[1].toInt())
+                    put("early_data_header_name", "Sec-WebSocket-Protocol")
+                    path = path.replace(it.value, "").ifEmpty { "/" }
+                }
+                put("path", path)
+                q["host"]?.takeIf { it.isNotBlank() }?.let { h -> putJsonObject("headers") { put("Host", h) } }
+            }
+            "grpc" -> putJsonObject("transport") {
+                put("type", "grpc")
+                put("service_name", q["serviceName"] ?: q["path"].orEmpty())
+            }
+            "http", "h2" -> putJsonObject("transport") {
+                put("type", "http")
+                q["path"]?.let { put("path", it) }
+                q["host"]?.takeIf { it.isNotBlank() }?.let { h -> putJsonArray("host") { h.split(',').forEach { add(it) } } }
+            }
+            "httpupgrade" -> putJsonObject("transport") {
+                put("type", "httpupgrade")
+                q["path"]?.let { put("path", it) }
+                q["host"]?.takeIf { it.isNotBlank() }?.let { put("host", it) }
+            }
+            else -> throw IllegalArgumentException("transport \"$type\" is not supported by sing-box")
+        }
+    }
+
+    private fun query(raw: String?): Map<String, String> = raw.orEmpty().split('&').filter { '=' in it }
+        .associate { decode(it.substringBefore('=')) to decode(it.substringAfter('=')) }
+
+    private fun decode(s: String): String = URLDecoder.decode(s.replace("+", "%2B"), "UTF-8")
+
+    private fun decodeBase64(s: String): String? {
+        val t = s.trim().replace('-', '+').replace('_', '/').trimEnd('=')
+        if (t.isEmpty() || !t.all { it.isLetterOrDigit() || it == '+' || it == '/' }) return null
+        return runCatching { Base64.decode(t + "=".repeat((4 - t.length % 4) % 4)).decodeToString() }.getOrNull()
+    }
+
+    private fun defaultName(scheme: String, host: String, port: Int) = "$scheme $host${if (port > 0) ":$port" else ""}"
+}
