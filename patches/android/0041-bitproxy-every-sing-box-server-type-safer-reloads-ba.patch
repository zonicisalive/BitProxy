+/**
+ * OpenVPN client profiles (.ovpn) to sing-box's "openvpn-client" endpoint. Covers what VPN
+ * providers export: remotes, inline <ca>/<cert>/<key>/<tls-auth>/<tls-crypt>, ciphers,
+ * auth-user-pass (the username/password are added later in the app). Pure Kotlin, unit tested.
+ */
+object OpenVpnProfile {
+    data class Result(val server: ProxyServer, val warnings: List<String>)
+
+    fun looksLikeOvpn(text: String) = Regex("""(?m)^\s*remote\s+\S+""").containsMatchIn(text) &&
+        Regex("""(?m)^\s*(client|dev\s+tun|<ca>|proto\s)""").containsMatchIn(text)
+
+    /** A profile that needs a login and doesn't have one yet (not put into the config until it does). */
+    fun needsLogin(options: JsonObject) = options["type"]?.jsonPrimitive?.content == "openvpn-client" &&
+        options["username"]?.jsonPrimitive?.content?.isEmpty() == true
+
+    fun withLogin(options: JsonObject, username: String, password: String) =
+        JsonObject(options + mapOf("username" to JsonPrimitive(username), "password" to JsonPrimitive(password)))
+
+    fun parse(text: String, name: String): Result {
+        val warnings = mutableListOf<String>()
+        val blocks = mutableMapOf<String, String>()
+        val directives = mutableListOf<List<String>>()
+        var block: String? = null
+        val blockText = StringBuilder()
+        for (raw in text.removePrefix("﻿").lines()) {
+            val line = raw.trim()
+            if (block != null) {
+                if (line == "</$block>") {
+                    blocks[block] = blockText.toString().trim()
+                    block = null
+                    blockText.clear()
+                } else {
+                    blockText.appendLine(line)
+                }
+                continue
+            }
+            if (line.isEmpty() || line.startsWith("#") || line.startsWith(";")) continue
+            val start = Regex("""^<([\w-]+)>$""").matchEntire(line)
+            if (start != null) {
+                block = start.groupValues[1]
+            } else {
+                directives += line.split(Regex("""\s+""")).map { it.removeSurrounding("\"") }
+            }
+        }
+        fun first(name: String) = directives.firstOrNull { it[0] == name }
+        fun arg(name: String, i: Int = 1) = first(name)?.getOrNull(i)
+
+        if (arg("dev")?.startsWith("tap") == true) throw IllegalArgumentException("$name: \"dev tap\" (layer 2) is not supported, only tun")
