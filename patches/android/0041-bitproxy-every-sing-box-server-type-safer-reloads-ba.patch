+        val defaultPort = arg("port")?.toIntOrNull() ?: 1194
+        val remotes = directives.filter { it[0] == "remote" && it.size >= 2 }.map { r ->
+            Triple(r[1], r.getOrNull(2)?.toIntOrNull() ?: defaultPort, r.getOrNull(3)?.let(::network) ?: defaultProto)
+        }
+        if (remotes.isEmpty()) throw IllegalArgumentException("$name: no \"remote\" server")
+        val ca = blocks["ca"] ?: throw IllegalArgumentException("$name: no inline <ca> certificate (a separate ca file can't be read)")
+        for (d in listOf("ca", "cert", "key", "tls-auth", "tls-crypt", "tls-crypt-v2")) {
+            if (first(d)?.getOrNull(1) != null && blocks[d] == null) throw IllegalArgumentException("$name: \"$d\" points to a separate file; use a profile with the file inlined as <$d>")
+        }
+
+        val options = buildJsonObject {
+            put("type", "openvpn-client")
+            if (remotes.size == 1) {
+                put("server", remotes[0].first)
+                put("server_port", remotes[0].second)
+                put("network", remotes[0].third)
+            } else {
+                putJsonArray("servers") {
+                    remotes.forEach { (host, port, net) ->
+                        addJsonObject {
+                            put("server", host)
+                            put("server_port", port)
+                            put("network", net)
+                        }
+                    }
+                }
+                if (first("remote-random") != null) put("remote_random", true)
+            }
+            if (first("auth-user-pass") != null) {
+                put("username", "")
+                put("password", "")
+            }
+            arg("cipher")?.let { put("cipher", it) }
+            arg("data-ciphers")?.let { c -> putJsonArray("data_ciphers") { c.split(':').forEach { add(it) } } }
+            arg("data-ciphers-fallback")?.let { put("data_ciphers_fallback", it) }
+            arg("auth")?.let { put("auth", it) }
+            arg("tun-mtu")?.toIntOrNull()?.let { put("mtu", it) }
+            arg("mssfix")?.toIntOrNull()?.let { put("mss_fix", it) }
+            arg("fragment")?.toIntOrNull()?.let { put("fragment", it) }
+            directives.firstOrNull { it[0] == "keepalive" && it.size >= 3 }?.let {
+                put("ping_interval", "${it[1]}s")
+                put("ping_restart", "${it[2]}s")
+            }
+            arg("ping")?.let { put("ping_interval", "${it}s") }
+            arg("ping-restart")?.let { put("ping_restart", "${it}s") }
+            first("compress")?.let { put("compression", it.getOrNull(1) ?: "stub") }
+            first("comp-lzo")?.let { put("compression_lzo", it.getOrNull(1) ?: "adaptive") }
+            first("allow-compression")?.getOrNull(1)?.let { put("allow_compression", it) }
+            putJsonObject("tls") {
+                put("certificate", lines(ca))
+                blocks["cert"]?.let { put("client_certificate", lines(it)) }
+                blocks["key"]?.let { put("client_key", lines(it)) }
+                first("verify-x509-name")?.let {
+                    put("server_name", it[1])
+                    it.getOrNull(2)?.let { type -> put("server_name_type", type) }
+                }
+                arg("remote-cert-tls")?.let { put("remote_certificate_tls", it) }
+                arg("tls-version-min")?.let { put("version_min", it) }
+                val wrap = listOf("tls-crypt-v2" to "tls_crypt_v2", "tls-crypt" to "tls_crypt", "tls-auth" to "tls_auth").firstOrNull { blocks[it.first] != null }
+                wrap?.let { (block, type) ->
+                    putJsonObject("control_wrap") {
+                        put("type", type)
+                        put("key", lines(blocks.getValue(block)))
+                        if (type == "tls_auth") {
+                            (arg("key-direction") ?: arg("tls-auth", 2))?.let { put("direction", if (it == "0") "server" else "client") }
+                        }
+                    }
+                }
+            }
+        }
+        return Result(ProxyServer(name, options), warnings)
+    }
+
+    private fun network(proto: String) = if (proto.startsWith("tcp")) "tcp" else "udp"
+
+    private fun lines(pem: String) = JsonArray(pem.lines().filter { it.isNotBlank() }.map(::JsonPrimitive))
+}
