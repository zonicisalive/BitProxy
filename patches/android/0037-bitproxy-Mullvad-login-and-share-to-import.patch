diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/Mullvad.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/Mullvad.kt
new file mode 100644
index 0000000..f56a3a7
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/Mullvad.kt
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.content.Context
+import androidx.core.content.edit
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bitproxy.wireguard.Curve25519
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * Mullvad login with the account number: registers one WireGuard key (a "device" on the account)
+ * and writes a .conf per chosen location into BitProxyStore, so the rest of BitProxy treats them
+ * like imported files. Uses Mullvad's public API, the same one their open-source apps use.
+ * All functions do network or file I/O: call them off the main thread.
+ */
+object Mullvad {
+    private const val API = "https://api.mullvad.net"
+    private const val PORT = 51820
+
+    data class Relay(val hostname: String, val ipv4: String, val publicKey: String, val owned: Boolean, val weight: Int)
+
+    data class Location(val code: String, val country: String, val city: String, val relays: List<Relay>) {
+        /** Also the file name, so the endpoint tag reads "mullvad-gothenburg-se". */
+        val serverName get() = "Mullvad $city ${code.substringBefore('-').uppercase()}"
+    }
+
+    data class Relays(val dns: String, val locations: List<Location>)
+
+    data class Device(val privateKey: String, val ipv4: String, val ipv6: String?)
+
+    class ApiException(message: String) : Exception(message)
+
+    private val prefs by lazy { Application.application.getSharedPreferences("bitproxy_mullvad", Context.MODE_PRIVATE) }
+
+    val account: String? get() = prefs.getString("account", null)
+    val paidUntil: String? get() = prefs.getString("expiry", null)
+    val locationCodes: Set<String> get() = prefs.getStringSet("locations", emptySet())!!
+
+    /** Logs in and makes sure this app's key is registered. Reuses the key if it's still on the account. */
+    fun login(accountNumber: String) {
+        val number = accountNumber.filter(Char::isDigit)
+        if (number.length != 16) throw ApiException("A Mullvad account number has 16 digits.")
+        val token = token(number)
+        val oldKey = prefs.getString("private_key", null)?.takeIf { prefs.getString("account", null) == number }
+        val existing = oldKey?.let { key ->
+            val pub = Curve25519.publicKey(key)
+            call("GET", "/accounts/v1/devices", token)!!.jsonArray.map { it.jsonObject }.firstOrNull { it.str("pubkey") == pub }?.let { key to it }
+        }
+        val (key, device) = existing ?: Curve25519.generate().let { pair ->
+            val body = buildJsonObject {
+                put("pubkey", pair.publicKey)
+                put("hijack_dns", false)
+            }
+            pair.privateKey to call("POST", "/accounts/v1/devices", token, body.toString())!!.jsonObject
+        }
+        val expiry = runCatching { call("GET", "/accounts/v1/accounts/me", token)!!.jsonObject.str("expiry")?.substringBefore('T') }.getOrNull()
+        prefs.edit {
+            putString("account", number)
+            putString("private_key", key)
+            putString("device_id", device.str("id"))
+            putString("ipv4", device.str("ipv4_address"))
+            putString("ipv6", device.str("ipv6_address"))
+            putString("expiry", expiry)
+        }
+        EventLog.log("Mullvad: logged in, device ${device.str("name") ?: "?"}")
+    }
+
+    fun relays(): Relays = parseRelays(http("GET", "/app/v1/relays", null, null))
+
+    /** Replaces the Mullvad servers with one per chosen location. Returns the number written. */
+    fun saveLocations(relays: Relays, codes: Set<String>): Int {
+        val device = Device(
+            prefs.getString("private_key", null) ?: throw ApiException("Log in to Mullvad first."),
+            prefs.getString("ipv4", null)!!,
+            prefs.getString("ipv6", null),
+        )
+        removeServers()
+        val files = relays.locations.filter { it.code in codes }.mapNotNull { loc ->
+            BitProxyStore.save("${loc.serverName}.conf", conf(loc.relays.first(), relays.dns, device).toByteArray()).file?.name
+        }
+        prefs.edit {
+            putStringSet("locations", codes)
+            putStringSet("files", files.toSet())
+        }
+        return files.size
+    }
+
+    /** Removes this app's key from the account (frees a device slot) and the Mullvad servers. */
+    fun logout() {
+        val number = account
+        val id = prefs.getString("device_id", null)
+        if (number != null && id != null) {
+            runCatching { call("DELETE", "/accounts/v1/devices/$id", token(number)) }
+                .onFailure { EventLog.log("Mullvad: could not remove the device: ${it.message}") }
+        }
+        removeServers()
+        prefs.edit { clear() }
+        EventLog.log("Mullvad: logged out")
+    }
+
+    private fun removeServers() {
+        val files = prefs.getStringSet("files", emptySet())!!
+        BitProxyStore.servers().filter { it.file.name in files }.forEach(BitProxyStore::delete)
+    }
+
+    private fun token(number: String): String {
+        val body = buildJsonObject { put("account_number", number) }
+        return call("POST", "/auth/v1/token", null, body.toString())!!.jsonObject.str("access_token")
+            ?: throw ApiException("Mullvad login failed.")
+    }
+
+    fun conf(relay: Relay, dns: String, device: Device) = buildString {
+        appendLine("[Interface]")
+        appendLine("PrivateKey = ${device.privateKey}")
+        appendLine("Address = " + listOfNotNull(device.ipv4, device.ipv6).joinToString(", "))
+        appendLine("DNS = $dns")
+        appendLine()
+        appendLine("# ${relay.hostname}")
+        appendLine("[Peer]")
+        appendLine("PublicKey = ${relay.publicKey}")
+        appendLine("AllowedIPs = 0.0.0.0/0, ::/0")
+        appendLine("Endpoint = ${relay.ipv4}:$PORT")
+    }
+
+    /** Active WireGuard relays grouped by city; within a city Mullvad-owned and higher weight first. */
+    fun parseRelays(json: String): Relays {
+        val root = Json.parseToJsonElement(json).jsonObject
+        val names = root["locations"]!!.jsonObject
+        val wg = root["wireguard"]!!.jsonObject
+        val locations = wg["relays"]!!.jsonArray.map { it.jsonObject }
+            .filter { it["active"]?.jsonPrimitive?.booleanOrNull == true }
+            .groupBy { it.str("location") ?: "" }
+            .mapNotNull { (code, list) ->
+                val place = names[code]?.jsonObject ?: return@mapNotNull null
+                val relays = list.mapNotNull { r ->
+                    Relay(
+                        r.str("hostname") ?: return@mapNotNull null,
+                        r.str("ipv4_addr_in") ?: return@mapNotNull null,
+                        r.str("public_key") ?: return@mapNotNull null,
+                        r["owned"]?.jsonPrimitive?.booleanOrNull == true,
+                        r["weight"]?.jsonPrimitive?.intOrNull ?: 0,
+                    )
+                }.sortedWith(compareByDescending<Relay> { it.owned }.thenByDescending { it.weight })
+                if (relays.isEmpty()) null else Location(code, place.str("country") ?: code, place.str("city") ?: code, relays)
+            }
+            .sortedWith(compareBy({ it.country }, { it.city }))
+        return Relays(wg.str("ipv4_gateway") ?: "10.64.0.1", locations)
+    }
+
+    private fun JsonObject.str(key: String) = this[key]?.jsonPrimitive?.takeIf { it.isString }?.content
+
+    private fun call(method: String, path: String, token: String?, body: String? = null): JsonElement? =
+        http(method, path, token, body).takeIf { it.isNotBlank() }?.let(Json::parseToJsonElement)
+
+    private fun http(method: String, path: String, token: String?, body: String?): String {
+        val c = URL(API + path).openConnection() as HttpURLConnection
+        try {
+            c.requestMethod = method
+            c.connectTimeout = 15_000
+            c.readTimeout = 30_000
+            c.setRequestProperty("Accept", "application/json")
+            token?.let { c.setRequestProperty("Authorization", "Bearer $it") }
+            if (body != null) {
+                c.doOutput = true
+                c.setRequestProperty("Content-Type", "application/json")
+                c.outputStream.use { it.write(body.toByteArray()) }
+            }
+            val code = c.responseCode
+            val text = (if (code < 400) c.inputStream else c.errorStream)?.bufferedReader()?.use { it.readText() }.orEmpty()
+            if (code >= 400) throw ApiException(errorMessage(code, text))
+            return text
+        } finally {
+            c.disconnect()
+        }
+    }
+
+    private fun errorMessage(code: Int, text: String): String {
+        val error = runCatching { Json.parseToJsonElement(text).jsonObject.str("code") }.getOrNull()
+        return when (error) {
+            "INVALID_ACCOUNT" -> "Wrong account number."
+            "MAX_DEVICES_REACHED" -> "This account already has the maximum number of devices. Remove one at mullvad.net/account, then try again."
+            "PUBKEY_IN_USE" -> "This key is already registered. Log out and log in again."
+            else -> if (code == 429) "Too many attempts. Wait a minute and try again." else "Mullvad API error $code${error?.let { " ($it)" } ?: ""}."
+        }
+    }
+}
