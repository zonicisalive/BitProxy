+
+/** Mullvad login and location picker on the BitProxy screen. [onServersChanged] reloads the server list. */
+@Composable
+fun MullvadCard(onServersChanged: () -> Unit) {
+    val scope = rememberCoroutineScope()
+    var account by remember { mutableStateOf(Mullvad.account) }
+    var busy by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var info by remember { mutableStateOf<String?>(null) }
+    var loginOpen by remember { mutableStateOf(false) }
+    var relays by remember { mutableStateOf<Mullvad.Relays?>(null) }
+    var confirmLogout by remember { mutableStateOf(false) }
+
+    fun run(block: suspend () -> Unit) {
+        busy = true
+        error = null
+        scope.launch {
+            try {
+                block()
+            } catch (e: Exception) {
+                error = e.message ?: e.javaClass.simpleName
+            } finally {
+                busy = false
+            }
+        }
+    }
+
+    fun openLocations() = run { relays = withContext(Dispatchers.IO) { Mullvad.relays() } }
+
+    Card(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        Column(Modifier.padding(16.dp)) {
+            Text("Mullvad", style = MaterialTheme.typography.titleMedium)
+            val status = account?.let { "Account ••••${it.takeLast(4)}" + (Mullvad.paidUntil?.let { d -> " · paid until $d" } ?: "") }
+                ?: "Log in with your account number to add Mullvad servers without downloading files."
+            Text(
+                status,
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(vertical = 8.dp),
+            )
+            error?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall) }
+            Row {
+                if (account == null) {
+                    FilledTonalButton(enabled = !busy, onClick = { loginOpen = true }) { Text("Log in") }
+                } else {
+                    FilledTonalButton(enabled = !busy, onClick = { openLocations() }) { Text(if (busy) "Loading…" else "Choose locations") }
+                    TextButton(enabled = !busy, onClick = { confirmLogout = true }) { Text("Log out") }
+                }
+            }
+        }
+    }
+
+    if (loginOpen) {
+        var number by remember { mutableStateOf("") }
+        AlertDialog(
+            onDismissRequest = { if (!busy) loginOpen = false },
+            title = { Text("Mullvad login") },
+            text = {
+                Column {
+                    OutlinedTextField(
+                        value = number,
+                        onValueChange = { number = it.filter(Char::isDigit).take(16) },
+                        label = { Text("Account number") },
+                        singleLine = true,
+                        visualTransformation = PasswordVisualTransformation(),
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
+                    )
+                    Text(
+                        "Adds one device to your account. Log out here to remove it again.",
+                        style = MaterialTheme.typography.bodySmall,
+                        modifier = Modifier.padding(top = 8.dp),
+                    )
+                    error?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall) }
+                }
+            },
+            confirmButton = {
+                TextButton(enabled = !busy && number.length == 16, onClick = {
+                    run {
+                        withContext(Dispatchers.IO) { Mullvad.login(number) }
+                        account = Mullvad.account
+                        loginOpen = false
+                        relays = withContext(Dispatchers.IO) { Mullvad.relays() }
+                    }
+                }) { Text(if (busy) "Logging in…" else "Log in") }
+            },
+            dismissButton = { TextButton(enabled = !busy, onClick = { loginOpen = false }) { Text("Cancel") } },
+        )
+    }
+
+    relays?.let { r ->
+        var picked by remember(r) { mutableStateOf(Mullvad.locationCodes) }
+        AlertDialog(
+            onDismissRequest = { relays = null },
+            title = { Text("Mullvad locations") },
+            text = {
+                LazyColumn(Modifier.heightIn(max = 420.dp)) {
+                    items(r.locations, key = { it.code }) { loc ->
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier.fillMaxWidth().clickable {
+                                picked = if (loc.code in picked) picked - loc.code else picked + loc.code
+                            },
+                        ) {
+                            Checkbox(checked = loc.code in picked, onCheckedChange = null, modifier = Modifier.padding(8.dp))
+                            Text("${loc.country} · ${loc.city}")
+                        }
+                    }
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    relays = null
+                    run {
+                        val n = withContext(Dispatchers.IO) { Mullvad.saveLocations(r, picked) }
+                        onServersChanged()
+                        info = "$n Mullvad server${if (n == 1) "" else "s"} saved. Tap Apply to use them."
+                    }
+                }) { Text("Save (${picked.size})") }
+            },
+            dismissButton = { TextButton(onClick = { relays = null }) { Text("Cancel") } },
+        )
+    }
+
+    if (confirmLogout) {
+        AlertDialog(
+            onDismissRequest = { confirmLogout = false },
+            title = { Text("Log out of Mullvad?") },
+            text = { Text("Removes this device from your Mullvad account and deletes the Mullvad servers here. Tap Apply afterwards.") },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmLogout = false
+                    run {
+                        withContext(Dispatchers.IO) { Mullvad.logout() }
+                        account = null
+                        onServersChanged()
+                    }
+                }) { Text("Log out") }
+            },
+            dismissButton = { TextButton(onClick = { confirmLogout = false }) { Text("Cancel") } },
+        )
+    }
+
+    info?.let {
+        AlertDialog(
+            onDismissRequest = { info = null },
+            title = { Text("Mullvad") },
+            text = { Text(it) },
+            confirmButton = { TextButton(onClick = { info = null }) { Text("OK") } },
+        )
+    }
+}
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/wireguard/Curve25519.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/wireguard/Curve25519.kt
new file mode 100644
index 0000000..9f72f64
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/wireguard/Curve25519.kt
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.wireguard
+
+import java.security.SecureRandom
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/**
+ * WireGuard key pairs (X25519). Android has no X25519 key generator before API 33 and libbox
+ * doesn't export one, so this is the scalar multiplication from TweetNaCl (public domain).
+ */
+@OptIn(ExperimentalEncodingApi::class)
+object Curve25519 {
+    data class KeyPair(val privateKey: String, val publicKey: String)
+
+    fun generate(): KeyPair {
+        val secret = ByteArray(32).also { SecureRandom().nextBytes(it) }
+        secret[0] = (secret[0].toInt() and 248).toByte()
+        secret[31] = ((secret[31].toInt() and 127) or 64).toByte()
+        return KeyPair(Base64.encode(secret), publicKey(secret))
+    }
+
+    /** Base64 public key for a base64 private key. */
+    fun publicKey(privateKey: String): String = publicKey(Base64.decode(privateKey))
+
+    private fun publicKey(secret: ByteArray): String {
+        val base = ByteArray(32).also { it[0] = 9 }
+        return Base64.encode(ByteArray(32).also { scalarMult(it, secret, base) })
+    }
+
+    private fun gf(vararg init: Long) = LongArray(16).also { init.copyInto(it) }
+    private val C121665 = gf(0xDB41, 1)
+
+    private fun car(o: LongArray) {
+        for (i in 0 until 16) {
+            o[i] += 1L shl 16
+            val c = o[i] shr 16
+            if (i < 15) o[i + 1] += c - 1 else o[0] += 38 * (c - 1)
+            o[i] -= c shl 16
+        }
+    }
+
+    private fun sel(p: LongArray, q: LongArray, b: Int) {
+        val c = (b - 1).inv().toLong()
+        for (i in 0 until 16) {
+            val t = c and (p[i] xor q[i])
+            p[i] = p[i] xor t
+            q[i] = q[i] xor t
+        }
+    }
+
+    private fun pack(o: ByteArray, n: LongArray) {
+        val m = LongArray(16)
+        val t = n.copyOf()
+        car(t)
+        car(t)
+        car(t)
+        repeat(2) {
+            m[0] = t[0] - 0xffed
+            for (i in 1 until 15) {
+                m[i] = t[i] - 0xffff - ((m[i - 1] shr 16) and 1)
+                m[i - 1] = m[i - 1] and 0xffff
+            }
+            m[15] = t[15] - 0x7fff - ((m[14] shr 16) and 1)
+            val b = ((m[15] shr 16) and 1).toInt()
+            m[14] = m[14] and 0xffff
+            sel(t, m, 1 - b)
+        }
+        for (i in 0 until 16) {
+            o[2 * i] = (t[i] and 0xff).toByte()
+            o[2 * i + 1] = (t[i] shr 8).toByte()
+        }
+    }
+
+    private fun add(o: LongArray, a: LongArray, b: LongArray) {
+        for (i in 0 until 16) o[i] = a[i] + b[i]
+    }
+
+    private fun sub(o: LongArray, a: LongArray, b: LongArray) {
+        for (i in 0 until 16) o[i] = a[i] - b[i]
+    }
+
+    private fun mul(o: LongArray, a: LongArray, b: LongArray) {
+        val t = LongArray(31)
+        for (i in 0 until 16) for (j in 0 until 16) t[i + j] += a[i] * b[j]
+        for (i in 0 until 15) t[i] += 38 * t[i + 16]
+        t.copyInto(o, 0, 0, 16)
+        car(o)
+        car(o)
+    }
+
+    private fun inv(o: LongArray, i: LongArray) {
+        val c = i.copyOf()
+        for (a in 253 downTo 0) {
+            mul(c, c, c)
+            if (a != 2 && a != 4) mul(c, c, i)
+        }
+        c.copyInto(o)
+    }
+
+    private fun scalarMult(q: ByteArray, n: ByteArray, p: ByteArray) {
+        val z = n.copyOf()
+        z[31] = ((z[31].toInt() and 127) or 64).toByte()
+        z[0] = (z[0].toInt() and 248).toByte()
+        val x = LongArray(16) { (p[2 * it].toLong() and 0xff) + ((p[2 * it + 1].toLong() and 0xff) shl 8) }
+        x[15] = x[15] and 0x7fff
+        val a = gf(1)
+        val b = x.copyOf()
+        val c = gf()
+        val d = gf(1)
+        val e = gf()
+        val f = gf()
+        for (i in 254 downTo 0) {
+            val r = ((z[i ushr 3].toInt() and 0xff) ushr (i and 7)) and 1
+            sel(a, b, r)
+            sel(c, d, r)
+            add(e, a, c)
+            sub(a, a, c)
+            add(c, b, d)
+            sub(b, b, d)
+            mul(d, e, e)
+            mul(f, a, a)
+            mul(a, c, a)
+            mul(c, b, e)
+            add(e, a, c)
+            sub(a, a, c)
+            mul(b, a, a)
+            sub(c, d, f)
+            mul(a, c, C121665)
+            add(a, a, d)
+            mul(c, c, a)
+            mul(a, d, f)
+            mul(d, b, x)
+            mul(b, e, e)
+            sel(a, b, r)
+            sel(c, d, r)
+        }
+        inv(c, c)
+        mul(a, a, c)
+        pack(q, a)
+    }
+}
