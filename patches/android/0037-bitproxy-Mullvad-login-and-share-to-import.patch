@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.core.content.IntentCompat
+import androidx.lifecycle.lifecycleScope
+import io.nekohasekai.sfa.database.ProfileManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * "Share → BitProxy" and "Open with → BitProxy" for WireGuard .conf files (or pasted conf text).
+ * Imports them and, once BitProxy has applied a config before, applies again so the new servers
+ * show up right away. The selected server stays the same.
+ */
+class ShareImportActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val uris = when (intent.action) {
+            Intent.ACTION_SEND -> listOfNotNull(IntentCompat.getParcelableExtra(intent, Intent.EXTRA_STREAM, Uri::class.java))
+            Intent.ACTION_SEND_MULTIPLE -> IntentCompat.getParcelableArrayListExtra(intent, Intent.EXTRA_STREAM, Uri::class.java).orEmpty()
+            else -> listOfNotNull(intent.data)
+        }
+        val text = intent.getStringExtra(Intent.EXTRA_TEXT)?.takeIf { uris.isEmpty() && "[Interface]" in it }
+        lifecycleScope.launch {
+            val message = withContext(Dispatchers.IO) { import(uris, text) }
+            EventLog.log("share import: $message")
+            Toast.makeText(applicationContext, message, Toast.LENGTH_LONG).show()
+            finish()
+        }
+    }
+
+    private suspend fun import(uris: List<Uri>, text: String?): String {
+        val results = uris.map(BitProxyStore::import) +
+            listOfNotNull(text?.let { BitProxyStore.save("${sharedName(it)}.conf", it.toByteArray()) })
+        val imported = results.count { it.ok }
+        return when {
+            results.isEmpty() -> "Nothing to import: share a WireGuard .conf file"
+            imported == 0 -> results.joinToString("\n") { it.message }
+            ProfileManager.get(BitProxyPrefs.profileId) == null -> "Imported $imported. Open BitProxy and tap Apply."
+            else -> when (val o = BitProxyApplier.apply(BitProxyServiceHooks.running)) {
+                is BitProxyApplier.Outcome.Applied -> "Imported $imported and applied"
+                is BitProxyApplier.Outcome.Failed -> "Imported $imported, but Apply failed: ${o.message}"
+            }
+        }
+    }
+
+    /** Pasted text has no file name: use the subject, else the server address. */
+    private fun sharedName(text: String) = intent.getStringExtra(Intent.EXTRA_SUBJECT)?.takeIf { it.isNotBlank() }
+        ?: Regex("""(?im)^\s*Endpoint\s*=\s*\[?([^\]\s]+?)\]?:\d+""").find(text)?.let { "Shared ${it.groupValues[1]}" }
+        ?: "Shared server"
+}
