+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.wireguard
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Test
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+@OptIn(ExperimentalEncodingApi::class)
+class Curve25519Test {
+    private fun hex(s: String) = ByteArray(s.length / 2) { s.substring(2 * it, 2 * it + 2).toInt(16).toByte() }
+
+    // RFC 7748, section 6.1 (public test vectors)
+    @Test fun rfc7748Vectors() {
+        val alice = Base64.encode(hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"))
+        assertEquals(Base64.encode(hex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a")), Curve25519.publicKey(alice))
+        val bob = Base64.encode(hex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"))
+        assertEquals(Base64.encode(hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")), Curve25519.publicKey(bob))
+    }
+
+    @Test fun generatedPairMatches() {
+        val pair = Curve25519.generate()
+        assertEquals(pair.publicKey, Curve25519.publicKey(pair.privateKey))
+        assertNotEquals(pair.privateKey, Curve25519.generate().privateKey)
+    }
+}
