+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import io.nekohasekai.sfa.bitproxy.wireguard.ParseResult
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConfParser
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class MullvadTest {
+    // Shape of https://api.mullvad.net/app/v1/relays, trimmed; dummy keys.
+    private val json = """
+        {"locations": {"se-got": {"country": "Sweden", "city": "Gothenburg"}, "al-tia": {"country": "Albania", "city": "Tirana"}},
+         "openvpn": {}, "bridge": {},
+         "wireguard": {"ipv4_gateway": "10.64.0.1", "relays": [
+           {"hostname": "se-got-wg-001", "location": "se-got", "active": true, "owned": false, "weight": 100,
+            "ipv4_addr_in": "192.0.2.1", "public_key": "+ZwootR5fY6py1jCqJ6S6drE2CQQttwt3S3IIPVukIM="},
+           {"hostname": "se-got-wg-002", "location": "se-got", "active": true, "owned": true, "weight": 100,
+            "ipv4_addr_in": "192.0.2.2", "public_key": "ha4StsG0IysrJajzBTO1FDtTQSsP128CdQegmOFqp94="},
+           {"hostname": "al-tia-wg-001", "location": "al-tia", "active": false, "owned": true, "weight": 100,
+            "ipv4_addr_in": "192.0.2.3", "public_key": "ha4StsG0IysrJajzBTO1FDtTQSsP128CdQegmOFqp94="}
+         ]}}
+    """.trimIndent()
+
+    @Test fun activeRelaysByCityOwnedFirst() {
+        val relays = Mullvad.parseRelays(json)
+        assertEquals("10.64.0.1", relays.dns)
+        val got = relays.locations.single()
+        assertEquals("Mullvad Gothenburg SE", got.serverName)
+        assertEquals(listOf("se-got-wg-002", "se-got-wg-001"), got.relays.map { it.hostname })
+    }
+
+    @Test fun confParses() {
+        val loc = Mullvad.parseRelays(json).locations.single()
+        val device = Mullvad.Device("+ZwootR5fY6py1jCqJ6S6drE2CQQttwt3S3IIPVukIM=", "10.68.1.2/32", "fc00:bbbb:bbbb:bb01::1:2/128")
+        val r = WireGuardConfParser.parse(Mullvad.conf(loc.relays.first(), "10.64.0.1", device), "${loc.serverName}.conf") as ParseResult.Ok
+        assertEquals("Mullvad Gothenburg SE", r.conf.name)
+        assertEquals("192.0.2.2", r.conf.peers.single().host)
+        assertEquals(51820, r.conf.peers.single().port)
+        assertEquals("10.68.1.2", r.conf.ipv4Address.address.toString())
+        assertEquals("10.64.0.1", r.conf.ipv4Dns.toString())
+    }
+}
