+/** Hook: BitProxy items at the top of the dashboard (one call in upstream DashboardScreen). */
+fun LazyListScope.bitProxyDashboardItems(serviceStatus: Status) {
+    item { BitProxyStatusBadge(serviceStatus) }
+    item { DashboardAppsCard(serviceStatus) }
+}
+
+private data class AppRow(val key: AppKey, val label: String)
+
+/**
+ * VPN / Direct switch for every configured app, right on the dashboard. A flip is saved and
+ * re-applied (batched), so the app's DNS rule follows too, unlike switching in the Groups tab.
+ */
+@Composable
+private fun DashboardAppsCard(serviceStatus: Status) {
+    val scope = rememberCoroutineScope()
+    var choices by remember { mutableStateOf(BitProxyPrefs.apps) }
+    var rows by remember { mutableStateOf<List<AppRow>?>(null) }
+    var status by remember { mutableStateOf<String?>(null) }
+    var applyJob by remember { mutableStateOf<Job?>(null) }
+
+    LaunchedEffect(Unit) {
+        rows = withContext(Dispatchers.IO) {
+            val scan = AppResolver.scan()
+            BitProxyPrefs.apps.keys.map { AppRow(it, scan.label(it.packageName) + Uid.userLabel(it.userId)) }
+                .sortedWith(compareBy({ it.label.lowercase() }, { it.key.userId }))
+        }
+    }
+
+    fun flip(key: AppKey, vpn: Boolean) {
+        choices = choices + (key to if (vpn) Mode.VPN else Mode.DIRECT)
+        BitProxyPrefs.apps = choices
+        applyJob?.cancel()
+        status = "Applying…"
+        applyJob = scope.launch {
+            delay(1500) // batch quick successive flips into one reload
+            status = when (val o = BitProxyApplier.apply(serviceStatus == Status.Started)) {
+                is BitProxyApplier.Outcome.Applied -> if (o.reloaded) null else "Saved. Takes effect when the VPN starts."
+                is BitProxyApplier.Outcome.Failed -> "Not applied: ${o.message}"
+            }
+        }
+    }
+
+    Card(
+        modifier = Modifier.fillMaxWidth(),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        Column(Modifier.padding(vertical = 8.dp)) {
+            Row(Modifier.padding(horizontal = 16.dp), verticalAlignment = Alignment.CenterVertically) {
+                Icon(Icons.Outlined.Apps, contentDescription = null, tint = MaterialTheme.colorScheme.primary)
+                Text("  Apps", style = MaterialTheme.typography.titleMedium, modifier = Modifier.weight(1f))
+                TextButton(onClick = { GlobalEventBus.tryEmit(UiEvent.Navigate("settings/bitproxy/apps")) }) { Text("Manage") }
+            }
+            status?.let {
+                Text(it, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant, modifier = Modifier.padding(horizontal = 16.dp))
+            }
+            val list = rows
+            when {
+                list == null -> {}
+                list.isEmpty() -> Text(
+                    "No apps set up yet. Tap Manage to pick apps for the VPN.",
+                    style = MaterialTheme.typography.bodyMedium,
+                    modifier = Modifier.padding(16.dp),
+                )
+                else -> list.forEach { row ->
+                    val vpn = choices[row.key] == Mode.VPN
+                    ListItem(
+                        headlineContent = { Text(row.label, maxLines = 1, overflow = TextOverflow.Ellipsis) },
+                        supportingContent = { Text(if (vpn) "VPN" else "Direct", style = MaterialTheme.typography.bodySmall) },
+                        leadingContent = { AppIcon(row.key.packageName) },
+                        trailingContent = { Switch(checked = vpn, onCheckedChange = { flip(row.key, it) }) },
+                        modifier = Modifier.clickable { flip(row.key, !vpn) },
+                        colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+                    )
+                }
+            }
+        }
+    }
+}
