+    @Test fun trustedWifiGoesDirectButBlockedStaysBlocked() {
+        val apps = twoServerApps.mapIndexed { i, a -> if (i == 2) a.copy(mode = Mode.BLOCK) else a }
+        val r = ok(GeneratorInput(servers("two-servers"), null, apps, trustedWifi = listOf(" Home ", "Home", "")))
+        val rules = r.config["route"]!!.jsonObject["rules"]!!.jsonArray.map { it.jsonObject }
+        val block = rules.indexOfFirst { it["action"]?.jsonPrimitive?.content == "reject" }
+        val wifi = rules.indexOfFirst { "wifi_ssid" in it }
+        val firstApp = rules.indexOfFirst { it["outbound"] != null && "user_id" in it }
+        assertTrue(block < wifi && wifi < firstApp)
+        assertEquals("Direct", rules[wifi]["outbound"]!!.jsonPrimitive.content)
+        assertEquals(listOf("Home"), rules[wifi]["wifi_ssid"]!!.jsonArray.map { it.jsonPrimitive.content })
+        val dns = r.config["dns"]!!.jsonObject["rules"]!!.jsonArray.map { it.jsonObject }
+        assertEquals("reject", dns[0]["action"]!!.jsonPrimitive.content)
+        assertEquals("local", dns[1]["server"]!!.jsonPrimitive.content)
+    }
+
     @Test fun noServersIsAnError() {
         assertTrue(ConfigGenerator.generate(GeneratorInput(emptyList(), null, twoServerApps)) is GenerateResult.Error)
     }
