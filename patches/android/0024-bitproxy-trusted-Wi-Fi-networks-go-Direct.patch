+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.net.wifi.WifiManager
+import android.os.Build
+import androidx.core.content.ContextCompat
+import io.nekohasekai.sfa.Application
+
+/** Android only reveals Wi-Fi names (SSIDs) with location permission, "all the time" for a service. */
+object WifiPermission {
+    fun foreground() = has(Manifest.permission.ACCESS_FINE_LOCATION)
+
+    fun background() = Build.VERSION.SDK_INT < Build.VERSION_CODES.Q || has(Manifest.permission.ACCESS_BACKGROUND_LOCATION)
+
+    fun granted() = foreground() && background()
+
+    private fun has(p: String) = ContextCompat.checkSelfPermission(Application.application, p) == PackageManager.PERMISSION_GRANTED
+
+    /** Current Wi-Fi name, or null (not on Wi-Fi, no permission, or location switched off). */
+    fun currentSsid(): String? = runCatching {
+        val wm = Application.application.applicationContext.getSystemService(Context.WIFI_SERVICE) as WifiManager
+        @Suppress("DEPRECATION")
+        wm.connectionInfo?.ssid?.removeSurrounding("\"")?.takeIf { it.isNotBlank() && it != WifiManager.UNKNOWN_SSID && it != "<unknown ssid>" }
+    }.getOrNull()
+}
