diff --git a/app/src/test/resources/bitproxy/golden/regenerate.sh b/app/src/test/resources/bitproxy/golden/regenerate.sh
new file mode 100755
index 0000000..cf7d467
--- /dev/null
+++ b/app/src/test/resources/bitproxy/golden/regenerate.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Regenerate expected.json for each golden case by running the reference Termux
+# script (conf-merger.py) with a fake `pm`. Usage: regenerate.sh /path/to/conf-merger.py
+set -euo pipefail
+script=$(readlink -f "$1"); here=$(dirname "$(readlink -f "$0")")
+for case in "$here"/*/; do
+  tmp=$(mktemp -d)
+  for f in "$case"*.wgtest; do cp "$f" "$tmp/$(basename "${f%.wgtest}")"; done
+  mkdir "$tmp/bin" && printf '#!/bin/sh\ncat "%s"\n' "$case/pm.txt" > "$tmp/bin/pm" && chmod +x "$tmp/bin/pm"
+  (cd "$tmp" && PATH="$tmp/bin:$PATH" python3 "$script" >/dev/null) && cp "$tmp/singbox_profile.json" "$case/expected.json"
+  rm -rf "$tmp"
+done
