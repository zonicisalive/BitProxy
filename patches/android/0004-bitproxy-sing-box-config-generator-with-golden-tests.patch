+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/config/ConfigGenerator.kt
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.config
+
+import io.nekohasekai.sfa.bitproxy.net.IpAddress
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConf
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.addJsonObject
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonArray
+import kotlinx.serialization.json.putJsonObject
+
+/** One switch row: an app in one Android user (main, clone, profile), with its live UIDs. */
+data class AppRoute(
+    val label: String,
+    val packageName: String,
+    val uids: List<Int>,
+    val viaVpn: Boolean,
+)
+
+data class GeneratorInput(
+    /** Parsed configs in display order; endpoint tags are derived from their names. */
+    val servers: List<WireGuardConf>,
+    /** Endpoint tag of the selected server; null or unknown = first server. */
+    val selectedTag: String?,
+    val apps: List<AppRoute>,
+    /** True when the underlying network has global IPv6 (automatic IPv6 mode). */
+    val ipv6: Boolean = false,
+)
+
+sealed interface GenerateResult {
+    data class Ok(
+        val config: JsonObject,
+        val selectedTag: String,
+        val tunAddresses: List<String>,
+        val dnsServer: String,
+        val ipv6: Boolean,
+        /** Servers left out of the VPN group because their tunnel address differs from the selected one. */
+        val otherAddressServers: List<String>,
+        val appRuleCount: Int,
+        val warnings: List<String>,
+    ) : GenerateResult {
+        val json: String get() = PRETTY.encodeToString(JsonObject.serializer(), config)
+    }
+
+    data class Error(val message: String) : GenerateResult
+}
+
+private val PRETTY = Json { prettyPrint = true }
+
+/**
+ * Builds the sing-box config that reference/conf-merger.py produced, with the
+ * hard-won rules from the phone baked in (see comments). Pure function: no Android APIs.
+ */
+object ConfigGenerator {
+    const val VPN = "VPN"
+    const val DIRECT = "Direct"
+    private const val TUN_MTU = 1400 // default 9000 made forwarded pages load slowly
+
+    /** Same as the script: lowercase, spaces to dashes, "-2", "-3"... for duplicates. */
+    fun endpointTags(servers: List<WireGuardConf>): List<String> {
+        val used = mutableSetOf<String>()
+        return servers.map { conf ->
+            val tag = conf.name.lowercase().replace(" ", "-")
+            var unique = tag
+            var n = 2
+            while (unique in used) unique = "$tag-${n++}"
+            used += unique
+            unique
+        }
+    }
+
+    fun generate(input: GeneratorInput): GenerateResult {
+        if (input.servers.isEmpty()) return GenerateResult.Error("No WireGuard servers imported")
+        val tags = endpointTags(input.servers)
+        val selectedIndex = tags.indexOf(input.selectedTag).takeIf { it >= 0 } ?: 0
+        val selected = input.servers[selectedIndex]
+        val warnings = mutableListOf<String>()
+
+        // sing-box forwards TUN packets into WireGuard without rewriting the source IP,
+        // so the TUN address MUST equal the selected server's tunnel address. Servers with
+        // a different address would silently drop traffic, so they stay out of this config.
+        val tunIp = selected.ipv4Address.address
+        val group = input.servers.indices.filter { input.servers[it].ipv4Address.address == tunIp }
+        val others = input.servers.indices.filter { it !in group }.map { tags[it] }
+        if (others.isNotEmpty()) {
+            warnings += "Servers with a different tunnel address are not in the VPN group (select one to switch): ${others.joinToString()}"
+        }
+
+        // /24, not /30: sing-box gives the phone the next IP as DNS server, which must be
+        // neither the network nor the broadcast address.
+        val host = tunIp.bytes[3].toInt() and 0xff
+        if (host == 0 || host >= 254) {
+            return GenerateResult.Error("Tunnel address $tunIp can't be used: its DNS address would be the network or broadcast address of the /24")
+        }
+        val tunAddresses = mutableListOf("$tunIp/24")
+        val v6 = selected.ipv6Address
+        val useIpv6 = input.ipv6 && v6 != null
+        if (input.ipv6 && v6 == null) warnings += "Network has IPv6 but ${tags[selectedIndex]} has no IPv6 address; staying IPv4-only"
+        if (useIpv6) tunAddresses += "${v6!!.address}/126"
+
+        val dnsServer: IpAddress = selected.ipv4Dns!! // the parser rejects configs without DNS
+
+        // Tags must be unique across all outbounds/endpoints.
+        val usedTags = (tags + VPN + DIRECT).toMutableSet()
+        val routes = input.apps.filter { it.uids.isNotEmpty() }.map { app ->
+            var tag = app.label
+            if (tag in usedTags) tag = "${app.label} (${app.packageName})"
+            var n = 2
+            while (tag in usedTags) tag = "${app.label} (${app.packageName}) ${n++}"
+            usedTags += tag
+            tag to app
+        }
+        val vpnUids = routes.filter { it.second.viaVpn }.flatMap { it.second.uids }.distinct().sorted()
+
+        val config = buildJsonObject {
+            putJsonObject("log") { put("level", "warn") }
+            putJsonObject("dns") {
+                put("strategy", if (useIpv6) "prefer_ipv4" else "ipv4_only")
+                putJsonArray("servers") {
+                    addJsonObject {
+                        put("type", "local")
+                        put("tag", "local")
+                    }
+                    addJsonObject {
+                        put("type", "udp")
+                        put("tag", "remote")
+                        put("server", dnsServer.text)
+                        put("detour", VPN)
+                    }
+                }
+                // Only VPN apps resolve through the tunnel, so Direct apps keep DNS when the server is down.
+                putJsonArray("rules") {
+                    if (vpnUids.isNotEmpty()) {
+                        addJsonObject {
+                            put("user_id", intArray(vpnUids))
+                            put("server", "remote")
+                        }
+                    }
+                }
+                put("final", "local")
+            }
+            putJsonArray("inbounds") {
+                addJsonObject {
+                    put("type", "tun")
+                    put("tag", "tun-in")
+                    put("address", buildJsonArray { tunAddresses.forEach { add(it) } })
+                    put("mtu", TUN_MTU)
+                    put("auto_route", true)
+                    put("strict_route", true)
+                }
+            }
+            putJsonArray("endpoints") { group.forEach { add(endpoint(input.servers[it], tags[it])) } }
+            putJsonArray("outbounds") {
+                addJsonObject {
+                    put("type", "selector")
+                    put("tag", VPN)
+                    put("outbounds", buildJsonArray { group.forEach { add(tags[it]) } })
+                    put("default", tags[selectedIndex])
+                    put("interrupt_exist_connections", true)
+                }
+                // A direct outbound must not have "detour" ("detour is not supported in direct context").
+                addJsonObject {
+                    put("type", "direct")
+                    put("tag", DIRECT)
+                }
+                for ((tag, app) in routes) {
+                    addJsonObject {
+                        put("type", "selector")
+                        put("tag", tag)
+                        put(
+                            "outbounds",
+                            buildJsonArray {
+                                add(VPN)
+                                add(DIRECT)
+                            },
+                        )
+                        put("default", if (app.viaVpn) VPN else DIRECT)
+                        put("interrupt_exist_connections", true)
+                    }
+                }
+            }
+            putJsonObject("route") {
+                put("auto_detect_interface", true)
+                put("default_domain_resolver", "local")
+                putJsonArray("rules") {
+                    addJsonObject {
+                        put("port", 53)
+                        put("action", "hijack-dns")
+                    }
+                    // user_id, not package_name: package rules did not match on OxygenOS.
+                    // No "sniff" before these rules: it stopped pre-match and stalled TCP.
+                    for ((tag, app) in routes) {
+                        addJsonObject {
+                            put("user_id", intArray(app.uids.sorted()))
+                            put("outbound", tag)
+                        }
+                    }
+                }
+                put("final", DIRECT)
+            }
+            // Deliberately no experimental.cache_file: it broke Direct traffic on the phone.
+        }
+
+        return GenerateResult.Ok(
+            config = config,
+            selectedTag = tags[selectedIndex],
+            tunAddresses = tunAddresses,
+            dnsServer = dnsServer.text,
+            ipv6 = useIpv6,
+            otherAddressServers = others,
+            appRuleCount = routes.size,
+            warnings = warnings,
+        )
+    }
+
+    private fun endpoint(conf: WireGuardConf, tag: String) = buildJsonObject {
+        put("type", "wireguard")
+        put("tag", tag)
+        put("address", buildJsonArray { conf.addresses.forEach { add(it.toString()) } })
+        put("private_key", conf.privateKey)
+        putJsonArray("peers") {
+            for (p in conf.peers) {
+                addJsonObject {
+                    put("address", p.host)
+                    put("port", p.port)
+                    put("public_key", p.publicKey)
+                    put("allowed_ips", buildJsonArray { p.allowedIps.forEach { add(it) } })
+                    p.presharedKey?.let { put("pre_shared_key", it) }
+                    p.persistentKeepalive?.let { put("persistent_keepalive_interval", it) }
+                }
+            }
+        }
+        conf.mtu?.let { put("mtu", it) }
+    }
+
+    private fun intArray(values: List<Int>) = JsonArray(values.map(::JsonPrimitive))
+}
diff --git a/app/src/test/java/io/nekohasekai/sfa/bitproxy/config/ConfigGeneratorTest.kt b/app/src/test/java/io/nekohasekai/sfa/bitproxy/config/ConfigGeneratorTest.kt
new file mode 100644
index 0000000..fb9ef24
--- /dev/null
+++ b/app/src/test/java/io/nekohasekai/sfa/bitproxy/config/ConfigGeneratorTest.kt
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.config
+
+import io.nekohasekai.sfa.bitproxy.wireguard.ParseResult
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConf
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConfParser
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import java.io.File
+
+/**
+ * Golden tests: expected.json files are the real output of reference/conf-merger.py
+ * (see golden/regenerate.sh), so the in-app generator stays equivalent to the script.
+ */
+class ConfigGeneratorTest {
+    private val golden = File(javaClass.classLoader!!.getResource("bitproxy/golden")!!.toURI())
+
+    private fun servers(case: String): List<WireGuardConf> = File(golden, case).listFiles()!!
+        .filter { it.name.endsWith(".wgtest") }
+        .sortedBy { it.name } // the script sorts file names too
+        .map {
+            when (val r = WireGuardConfParser.parse(it.readText(), it.name.removeSuffix(".wgtest"))) {
+                is ParseResult.Ok -> r.conf
+                is ParseResult.Error -> fail(r.message) as Nothing
+            }
+        }
+
+    private fun expected(case: String) = Json.parseToJsonElement(File(golden, "$case/expected.json").readText())
+
+    private fun ok(input: GeneratorInput): GenerateResult.Ok = when (val r = ConfigGenerator.generate(input)) {
+        is GenerateResult.Ok -> r
+        is GenerateResult.Error -> fail(r.message) as Nothing
+    }
+
+    // Same apps and UIDs as golden/two-servers/pm.txt, in the script's APPS order.
+    private val twoServerApps = listOf(
+        AppRoute("WhatsApp Business", "com.whatsapp.w4b", listOf(10150), true),
+        AppRoute("WhatsApp Business (Clone)", "com.whatsapp.w4b", listOf(99910150), true),
+        AppRoute("Firefox", "org.mozilla.firefox", listOf(10123), true),
+        AppRoute("Discord", "com.discord", listOf(10160), true),
+        AppRoute("Discord (Profile 10)", "com.discord", listOf(1010160), true),
+        AppRoute("Discord (Clone)", "com.discord", listOf(99910160), true),
+    )
+
+    @Test fun matchesScriptTwoServers() {
+        val r = ok(GeneratorInput(servers("two-servers"), null, twoServerApps))
+        assertEquals(expected("two-servers"), r.config)
+        assertEquals("nl-free#1", r.selectedTag)
+    }
+
+    @Test fun matchesScriptEdgeCases() {
+        // CRLF, PSK, keepalive, MTU, [IPv6]:port and hostname endpoints, duplicate tags wg / wg-2.
+        val r = ok(GeneratorInput(servers("edge-cases"), null, listOf(AppRoute("Proton Mail", "ch.protonmail.android", listOf(10200), true))))
+        assertEquals(expected("edge-cases"), r.config)
+    }
+
+    @Test fun selectedServerSetsDefaultAndTunAddress() {
+        val r = ok(GeneratorInput(servers("two-servers"), "us-free-2", twoServerApps))
+        assertEquals("us-free-2", r.selectedTag)
+        val vpn = r.config["outbounds"]!!.jsonArray[0].jsonObject
+        assertEquals("us-free-2", vpn["default"]!!.jsonPrimitive.content)
+        assertEquals(listOf("10.2.0.2/24"), r.tunAddresses)
+    }
+
+    @Test fun serversWithDifferentTunnelAddressAreLeftOut() {
+        val base = servers("two-servers")
+        val other = base[1].copy(addresses = listOf(io.nekohasekai.sfa.bitproxy.net.IpPrefix.parse("10.9.0.7/32")!!))
+        val r = ok(GeneratorInput(listOf(base[0], other), null, twoServerApps))
+        assertEquals(listOf("us-free-2"), r.otherAddressServers)
+        assertEquals(1, r.config["endpoints"]!!.jsonArray.size)
+        assertEquals(listOf("nl-free#1"), r.config["outbounds"]!!.jsonArray[0].jsonObject["outbounds"]!!.jsonArray.map { it.jsonPrimitive.content })
+        assertTrue(r.warnings.single().contains("us-free-2"))
+
+        // Selecting the other server switches the TUN address with it.
+        val r2 = ok(GeneratorInput(listOf(base[0], other), "us-free-2", twoServerApps))
+        assertEquals(listOf("10.9.0.7/24"), r2.tunAddresses)
+    }
+
+    @Test fun tunnelAddressWhoseDnsWouldBeBroadcastIsRejected() {
+        for (bad in listOf("10.2.0.254/32", "10.2.0.255/32", "10.2.0.0/32")) {
+            val conf = servers("two-servers")[0].copy(addresses = listOf(io.nekohasekai.sfa.bitproxy.net.IpPrefix.parse(bad)!!))
+            val r = ConfigGenerator.generate(GeneratorInput(listOf(conf), null, twoServerApps))
+            assertTrue(bad, r is GenerateResult.Error && r.message.contains("broadcast"))
+        }
+    }
+
+    @Test fun directAppsResolveLocally() {
+        val apps = twoServerApps.mapIndexed { i, a -> a.copy(viaVpn = i != 2) } // Firefox Direct
+        val r = ok(GeneratorInput(servers("two-servers"), null, apps))
+        val dnsUids = r.config["dns"]!!.jsonObject["rules"]!!.jsonArray[0].jsonObject["user_id"]!!.jsonArray.map { it.jsonPrimitive.content.toInt() }
+        assertFalse(10123 in dnsUids)
+        val firefox = r.config["outbounds"]!!.jsonArray.first { it.jsonObject["tag"]!!.jsonPrimitive.content == "Firefox" }.jsonObject
+        assertEquals("Direct", firefox["default"]!!.jsonPrimitive.content)
+
+        // All Direct: no DNS rule at all (an empty user_id list would be invalid).
+        val allDirect = ok(GeneratorInput(servers("two-servers"), null, apps.map { it.copy(viaVpn = false) }))
+        assertEquals(JsonArray(emptyList()), allDirect.config["dns"]!!.jsonObject["rules"])
+    }
+
+    @Test fun uninstalledAppsAreSkippedAndDuplicateLabelsGetUniqueTags() {
+        val apps = listOf(
+            AppRoute("Chat", "a.chat", listOf(10001), true),
+            AppRoute("Chat", "b.chat", listOf(10002), true),
+            AppRoute("Direct", "c.weird", listOf(10003), true), // must not clash with the Direct outbound
+            AppRoute("Gone", "d.gone", emptyList(), true),
+        )
+        val r = ok(GeneratorInput(servers("two-servers"), null, apps))
+        val tags = r.config["outbounds"]!!.jsonArray.map { it.jsonObject["tag"]!!.jsonPrimitive.content }
+        assertEquals(listOf("VPN", "Direct", "Chat", "Chat (b.chat)", "Direct (c.weird)"), tags)
+        assertEquals(3, r.appRuleCount)
+    }
+
+    @Test fun ipv6Mode() {
+        val r = ok(GeneratorInput(servers("two-servers"), null, twoServerApps, ipv6 = true))
+        assertEquals(listOf("10.2.0.2/24", "2a07:b944::2:2/126"), r.tunAddresses)
+        assertEquals("prefer_ipv4", r.config["dns"]!!.jsonObject["strategy"]!!.jsonPrimitive.content)
+
+        // Server without an IPv6 address: stay IPv4-only.
+        val v4only = ok(GeneratorInput(servers("edge-cases"), null, twoServerApps, ipv6 = true))
+        assertEquals(listOf("10.2.0.2/24"), v4only.tunAddresses)
+        assertEquals("ipv4_only", v4only.config["dns"]!!.jsonObject["strategy"]!!.jsonPrimitive.content)
+        assertFalse(v4only.ipv6)
+    }
+
+    @Test fun neverUsesCacheFileOrDetourOnDirect() {
+        val json = ok(GeneratorInput(servers("two-servers"), null, twoServerApps)).json
+        assertFalse("cache_file" in json)
+        assertFalse("experimental" in json)
+        val direct = (Json.parseToJsonElement(json) as JsonObject)["outbounds"]!!.jsonArray[1].jsonObject
+        assertFalse("detour" in direct)
+    }
+
+    @Test fun noServersIsAnError() {
+        assertTrue(ConfigGenerator.generate(GeneratorInput(emptyList(), null, twoServerApps)) is GenerateResult.Error)
+    }
+}
