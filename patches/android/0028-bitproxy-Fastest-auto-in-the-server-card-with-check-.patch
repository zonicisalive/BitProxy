 .../nekohasekai/sfa/bitproxy/BitProxyPrefs.kt |  4 +
 .../sfa/bitproxy/config/ConfigGenerator.kt    |  5 +-
 .../sfa/bitproxy/ui/DashboardServersCard.kt   | 91 ++++++++++++++++---
 .../bitproxy/config/ConfigGeneratorTest.kt    |  4 +-
 5 files changed, 89 insertions(+), 17 deletions(-)

