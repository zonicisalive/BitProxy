+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import io.nekohasekai.sfa.bitproxy.wireguard.Curve25519
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+/**
+ * AzireVPN API v3 (azirevpn.com/docs/api): username + password give a token; one registered key
+ * gets one tunnel IP that works at every location.
+ */
+object AzireVpn : Provider {
+    private const val API = "https://api.azirevpn.com/v3"
+    override val id = "azirevpn"
+    override val name = "AzireVPN"
+    override val fields = listOf(Field("username", "Username"), Field("password", "Password", secret = true))
+    override val help = "Adds one WireGuard key to your AzireVPN account. Log out here to remove it again."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val body = buildJsonObject {
+            put("username", values["username"].orEmpty())
+            put("password", values["password"].orEmpty())
+            put("device_name", "BitProxy")
+        }
+        val token = data(api("POST", "/tokens", null, body.toString())).str("key") ?: throw ApiException("AzireVPN login failed.")
+        val pair = Curve25519.generate()
+        val ip = data(api("POST", "/ips", token, buildJsonObject { put("key", pair.publicKey) }.toString()))
+        state["token"] = token
+        state["username"] = values["username"]
+        state["ip_id"] = ip["id"]?.jsonPrimitive?.content
+        state["private_key"] = pair.privateKey
+        state["ipv4"] = ip.str("ipv4_address")?.let { "$it/32" } ?: throw ApiException("AzireVPN gave no tunnel address.")
+        state["ipv6"] = ip.str("ipv6_address")?.let { "$it/128" }
+        state["dns"] = ip["dns"]?.jsonArray?.joinToString(",") { it.jsonPrimitive.content }
+    }
+
+    override fun status(state: Provider.State) = state["username"]?.let { "User $it" }
+
+    override fun locations(state: Provider.State) = parseLocations(Http.request("$API/locations", error = ::errorMessage))
+
+    fun parseLocations(json: String) = Http.json(json).jsonObject["locations"]!!.jsonArray.map { it.jsonObject }.mapNotNull { l ->
+        val code = l.str("name") ?: return@mapNotNull null
+        Location(
+            code,
+            "${l.str("country")} · ${l.str("city")}",
+            mapOf("name" to "AzireVPN ${l.str("city")} ${code.substringBefore('-').uppercase()}", "host" to (l.str("pool") ?: return@mapNotNull null), "key" to (l.str("pubkey") ?: return@mapNotNull null)),
+        )
+    }.sortedBy { it.label }
+
+    override fun confs(state: Provider.State, picked: List<Location>) = picked.map { loc ->
+        val dns = state["dns"]?.split(',').orEmpty().ifEmpty { listOf("10.0.0.1") }
+        ServerConf(loc.extra.getValue("name"), wgConf(state.require("private_key"), listOfNotNull(state.require("ipv4"), state["ipv6"]), dns, loc.extra.getValue("key"), "${loc.extra.getValue("host")}:51820"))
+    }
+
+    override fun logout(state: Provider.State) {
+        val token = state["token"] ?: return
+        state["ip_id"]?.let { api("DELETE", "/ips/$it", token) }
+        api("DELETE", "/tokens", token)
+    }
+
+    /** The docs show bare objects, the official CLI reads .data: accept both. */
+    private fun data(o: JsonObject) = o["data"] as? JsonObject ?: o
+
+    private fun api(method: String, path: String, token: String?, body: String? = null) =
+        Http.request(API + path, method, token?.let { mapOf("Authorization" to "Bearer $it") }.orEmpty(), body, error = ::errorMessage)
+            .ifBlank { "{}" }.let { Http.json(it).jsonObject }
+
+    private fun errorMessage(code: Int, text: String) = when (code) {
+        401 -> "Wrong username or password."
+        429 -> "Too many attempts. Wait a minute and try again."
+        else -> runCatching { Http.json(text).jsonObject.str("message") }.getOrNull()?.let { "AzireVPN: $it" } ?: "AzireVPN API error $code."
+    }
+}
