+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/providers/Provider.kt
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import android.content.Context
+import android.content.SharedPreferences
+import androidx.core.content.edit
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bitproxy.BitProxyStore
+import io.nekohasekai.sfa.bitproxy.EventLog
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import java.net.HttpURLConnection
+import java.net.URL
+import javax.net.ssl.HostnameVerifier
+import javax.net.ssl.HttpsURLConnection
+import javax.net.ssl.SSLSocketFactory
+
+/** A login field; [secret] fields are masked. */
+data class Field(val key: String, val label: String, val secret: Boolean = false, val optional: Boolean = false)
+
+/** A place the user can pick. [extra] holds what the provider needs to build the conf later. */
+data class Location(val code: String, val label: String, val extra: Map<String, String> = emptyMap())
+
+/** A server to store: file name without .conf, and the wg-quick text. */
+data class ServerConf(val name: String, val text: String)
+
+class ApiException(message: String) : Exception(message)
+
+/**
+ * A VPN provider BitProxy can log in to. Each login stores what it needs in its own private
+ * [State]; the servers it produces are plain .conf files in BitProxyStore, so the rest of
+ * BitProxy treats them like imported files. All functions do network I/O: call them off the main thread.
+ */
+interface Provider {
+    val id: String
+    val name: String
+    val fields: List<Field>
+
+    /** Shown under the login fields: where to find the credentials, what the login does. */
+    val help: String
+
+    fun login(values: Map<String, String>, state: State)
+
+    /** Short account line, e.g. "Account ••••1234 · paid until 2026-10-01". */
+    fun status(state: State): String? = null
+
+    fun locations(state: State): List<Location>
+
+    fun confs(state: State, picked: List<Location>): List<ServerConf>
+
+    /** Undo the login on the provider's side (remove the key/device), if it has such a thing. */
+    fun logout(state: State) {}
+
+    class State(id: String) {
+        val prefs: SharedPreferences = Application.application.getSharedPreferences("bitproxy_provider_$id", Context.MODE_PRIVATE)
+        operator fun get(key: String): String? = prefs.getString(key, null)
+        operator fun set(key: String, value: String?) = prefs.edit { if (value == null) remove(key) else putString(key, value) }
+        fun require(key: String) = get(key) ?: throw ApiException("Log in first.")
+        val loggedIn get() = prefs.getBoolean("logged_in", false)
+    }
+}
+
+object Providers {
+    val all: List<Provider> = listOf(Mullvad, Ivpn, Pia, AirVpn, AzireVpn, NordVpn, Warp)
+
+    fun state(p: Provider) = Provider.State(p.id)
+
+    fun login(p: Provider, values: Map<String, String>) {
+        val s = state(p)
+        p.login(values.mapValues { it.value.trim() }, s)
+        s.prefs.edit { putBoolean("logged_in", true) }
+        EventLog.log("${p.name}: logged in")
+    }
+
+    fun pickedCodes(p: Provider): Set<String> = state(p).prefs.getStringSet("locations", emptySet())!!
+
+    /** Replaces this provider's servers with the picked locations. Returns the number saved. */
+    fun save(p: Provider, picked: List<Location>): Int {
+        val s = state(p)
+        val confs = p.confs(s, picked)
+        removeServers(s)
+        val files = confs.mapNotNull { BitProxyStore.save("${it.name}.conf", it.text.toByteArray()).file?.name }
+        s.prefs.edit {
+            putStringSet("locations", picked.map { it.code }.toSet())
+            putStringSet("files", files.toSet())
+        }
+        return files.size
+    }
+
+    fun logout(p: Provider) {
+        val s = state(p)
+        runCatching { p.logout(s) }.onFailure { EventLog.log("${p.name}: logout on the provider failed: ${it.message}") }
+        removeServers(s)
+        s.prefs.edit { clear() }
+        EventLog.log("${p.name}: logged out")
+    }
+
+    private fun removeServers(s: Provider.State) {
+        val files = s.prefs.getStringSet("files", emptySet())!!
+        BitProxyStore.servers().filter { it.file.name in files }.forEach(BitProxyStore::delete)
+    }
+}
+
+/** Small HTTP helper for provider APIs. Throws [ApiException] with [error] applied to 4xx/5xx bodies. */
+object Http {
+    fun request(
+        url: String,
+        method: String = "GET",
+        headers: Map<String, String> = emptyMap(),
+        body: String? = null,
+        contentType: String = "application/json",
+        socketFactory: SSLSocketFactory? = null,
+        hostnameVerifier: HostnameVerifier? = null,
+        error: (code: Int, body: String) -> String = { code, _ -> "HTTP error $code" },
+    ): String = String(bytes(url, method, headers, body, contentType, socketFactory, hostnameVerifier, error))
+
+    fun bytes(
+        url: String,
+        method: String = "GET",
+        headers: Map<String, String> = emptyMap(),
+        body: String? = null,
+        contentType: String = "application/json",
+        socketFactory: SSLSocketFactory? = null,
+        hostnameVerifier: HostnameVerifier? = null,
+        error: (code: Int, body: String) -> String = { code, _ -> "HTTP error $code" },
+    ): ByteArray {
+        val c = URL(url).openConnection() as HttpURLConnection
+        try {
+            if (c is HttpsURLConnection) {
+                socketFactory?.let { c.sslSocketFactory = it }
+                hostnameVerifier?.let { c.hostnameVerifier = it }
+            }
+            c.requestMethod = method
+            c.connectTimeout = 15_000
+            c.readTimeout = 30_000
+            c.setRequestProperty("Accept", "application/json")
+            headers.forEach { (k, v) -> c.setRequestProperty(k, v) }
+            if (body != null) {
+                c.doOutput = true
+                c.setRequestProperty("Content-Type", contentType)
+                c.outputStream.use { it.write(body.toByteArray()) }
+            }
+            val code = c.responseCode
+            val data = (if (code < 400) c.inputStream else c.errorStream)?.use { it.readBytes() } ?: ByteArray(0)
+            if (code >= 400) throw ApiException(error(code, String(data)))
+            return data
+        } catch (e: java.io.IOException) {
+            throw ApiException("Network error: ${e.message ?: e.javaClass.simpleName}")
+        } finally {
+            c.disconnect()
+        }
+    }
+
+    fun json(text: String): JsonElement = Json.parseToJsonElement(text)
+
+    fun form(vararg pairs: Pair<String, String>) = pairs.joinToString("&") { (k, v) -> "$k=${java.net.URLEncoder.encode(v, "UTF-8")}" }
+}
+
+fun JsonObject.str(key: String) = this[key]?.jsonPrimitive?.takeIf { it.isString }?.content
+
+/** Builds a wg-quick config. */
+fun wgConf(privateKey: String, addresses: List<String>, dns: List<String>, peerKey: String, endpoint: String, comment: String? = null, presharedKey: String? = null, mtu: Int? = null, keepalive: Int? = null) = buildString {
+    appendLine("[Interface]")
+    appendLine("PrivateKey = $privateKey")
+    appendLine("Address = " + addresses.joinToString(", "))
+    if (dns.isNotEmpty()) appendLine("DNS = " + dns.joinToString(", "))
+    mtu?.let { appendLine("MTU = $it") }
+    appendLine()
+    comment?.let { appendLine("# $it") }
+    appendLine("[Peer]")
+    appendLine("PublicKey = $peerKey")
+    presharedKey?.let { appendLine("PresharedKey = $it") }
+    appendLine("AllowedIPs = 0.0.0.0/0, ::/0")
+    appendLine("Endpoint = $endpoint")
+    keepalive?.let { appendLine("PersistentKeepalive = $it") }
+}
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/providers/Warp.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/providers/Warp.kt
