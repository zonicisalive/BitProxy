+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.ui
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.Card
+import androidx.compose.material3.CardDefaults
+import androidx.compose.material3.Checkbox
+import androidx.compose.material3.ListItem
+import androidx.compose.material3.ListItemDefaults
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.input.PasswordVisualTransformation
+import androidx.compose.ui.unit.dp
+import io.nekohasekai.sfa.bitproxy.providers.Location
+import io.nekohasekai.sfa.bitproxy.providers.Provider
+import io.nekohasekai.sfa.bitproxy.providers.Providers
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** Provider logins on the BitProxy screen. [onServersChanged] reloads the server list. */
+@Composable
+fun ProvidersCard(onServersChanged: () -> Unit) {
+    val scope = rememberCoroutineScope()
+    var refresh by remember { mutableIntStateOf(0) }
+    var busy by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var info by remember { mutableStateOf<String?>(null) }
+    var loginFor by remember { mutableStateOf<Provider?>(null) }
+    var manage by remember { mutableStateOf<Provider?>(null) }
+    var picking by remember { mutableStateOf<Pair<Provider, List<Location>>?>(null) }
+    var confirmLogout by remember { mutableStateOf<Provider?>(null) }
+
+    fun run(block: suspend () -> Unit) {
+        busy = true
+        error = null
+        scope.launch {
+            try {
+                block()
+            } catch (e: Exception) {
+                error = e.message ?: e.javaClass.simpleName
+            } finally {
+                busy = false
+                refresh++
+            }
+        }
+    }
+
+    fun openLocations(p: Provider) = run {
+        val list = withContext(Dispatchers.IO) { p.locations(Providers.state(p)) }
+        picking = p to list
+    }
+
+    Card(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        Text("VPN providers", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(16.dp, 16.dp, 16.dp, 0.dp))
+        Text(
+            "Log in to get servers without downloading files.",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+            modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp),
+        )
+        if (loginFor == null && manage == null) error?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(horizontal = 16.dp)) }
+        for (p in Providers.all) {
+            val state = remember(p, refresh) { Providers.state(p) }
+            val loggedIn = state.loggedIn
+            ListItem(
+                headlineContent = { Text(p.name) },
+                supportingContent = {
+                    Text(
+                        if (!loggedIn) "Not logged in" else listOfNotNull(runCatching { p.status(state) }.getOrNull(), "${Providers.pickedCodes(p).size} locations").joinToString(" · "),
+                    )
+                },
+                modifier = Modifier.clickable(enabled = !busy) {
+                    error = null
+                    if (loggedIn) manage = p else loginFor = p
+                },
+                colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+            )
+        }
+    }
+
+    loginFor?.let { p ->
+        val values = remember(p) { p.fields.associate { it.key to mutableStateOf("") } }
+        AlertDialog(
+            onDismissRequest = { if (!busy) loginFor = null },
+            title = { Text("${p.name} login") },
+            text = {
+                Column {
+                    for (f in p.fields) {
+                        OutlinedTextField(
+                            value = values.getValue(f.key).value,
+                            onValueChange = { values.getValue(f.key).value = it },
+                            label = { Text(f.label + if (f.optional) " (optional)" else "") },
+                            singleLine = true,
+                            visualTransformation = if (f.secret) PasswordVisualTransformation() else androidx.compose.ui.text.input.VisualTransformation.None,
+                            modifier = Modifier.padding(bottom = 8.dp),
+                        )
+                    }
+                    Text(p.help, style = MaterialTheme.typography.bodySmall)
+                    error?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(top = 8.dp)) }
+                }
+            },
+            confirmButton = {
+                val ready = p.fields.all { it.optional || values.getValue(it.key).value.isNotBlank() }
+                TextButton(enabled = !busy && ready, onClick = {
+                    run {
+                        withContext(Dispatchers.IO) { Providers.login(p, values.mapValues { it.value.value }) }
+                        loginFor = null
+                        openLocations(p)
+                    }
+                }) { Text(if (busy) "Logging in…" else if (p.fields.isEmpty()) "Register" else "Log in") }
+            },
+            dismissButton = { TextButton(enabled = !busy, onClick = { loginFor = null }) { Text("Cancel") } },
+        )
+    }
+
+    manage?.let { p ->
+        AlertDialog(
+            onDismissRequest = { if (!busy) manage = null },
+            title = { Text(p.name) },
+            text = {
+                Column {
+                    Text(runCatching { p.status(Providers.state(p)) }.getOrNull() ?: "Logged in")
+                    error?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(top = 8.dp)) }
+                }
+            },
+            confirmButton = {
+                TextButton(enabled = !busy, onClick = { openLocations(p) }) { Text(if (busy) "Loading…" else "Choose locations") }
+            },
+            dismissButton = {
+                TextButton(enabled = !busy, onClick = {
+                    manage = null
+                    confirmLogout = p
+                }) { Text("Log out") }
+            },
+        )
+    }
+
+    picking?.let { (p, list) ->
+        var picked by remember(p, list) { mutableStateOf(Providers.pickedCodes(p)) }
+        AlertDialog(
+            onDismissRequest = { picking = null },
+            title = { Text("${p.name} locations") },
+            text = {
+                LazyColumn(Modifier.heightIn(max = 420.dp)) {
+                    items(list, key = { it.code }) { loc ->
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier.fillMaxWidth().clickable {
+                                picked = if (loc.code in picked) picked - loc.code else picked + loc.code
+                            },
+                        ) {
+                            Checkbox(checked = loc.code in picked, onCheckedChange = null, modifier = Modifier.padding(8.dp))
+                            Text(loc.label)
+                        }
+                    }
+                }
+            },
+            confirmButton = {
+                TextButton(onClick = {
+                    picking = null
+                    manage = null
+                    run {
+                        val n = withContext(Dispatchers.IO) { Providers.save(p, list.filter { it.code in picked }) }
+                        onServersChanged()
+                        info = "$n ${p.name} server${if (n == 1) "" else "s"} saved. Tap Apply to use them."
+                    }
+                }) { Text("Save (${picked.size})") }
+            },
+            dismissButton = { TextButton(onClick = { picking = null }) { Text("Cancel") } },
+        )
+    }
+
+    confirmLogout?.let { p ->
+        AlertDialog(
+            onDismissRequest = { confirmLogout = null },
+            title = { Text("Log out of ${p.name}?") },
+            text = { Text("Removes this device from your ${p.name} account where possible and deletes its servers here. Tap Apply afterwards.") },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmLogout = null
+                    run {
+                        withContext(Dispatchers.IO) { Providers.logout(p) }
+                        onServersChanged()
+                    }
+                }) { Text("Log out") }
+            },
+            dismissButton = { TextButton(onClick = { confirmLogout = null }) { Text("Cancel") } },
+        )
+    }
+
+    info?.let {
+        AlertDialog(
+            onDismissRequest = { info = null },
+            title = { Text("BitProxy") },
+            text = { Text(it) },
+            confirmButton = { TextButton(onClick = { info = null }) { Text("OK") } },
+        )
+    }
+}
