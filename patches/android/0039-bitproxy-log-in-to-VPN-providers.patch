@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import java.net.URLEncoder
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+/**
+ * NordVPN (NordLynx): the access token from the Nord Account website returns the account's WireGuard
+ * private key; the tunnel address is the same (10.5.0.2) on every server. One recommended server per city.
+ */
+@OptIn(ExperimentalEncodingApi::class)
+object NordVpn : Provider {
+    private const val API = "https://api.nordvpn.com/v1"
+    override val id = "nordvpn"
+    override val name = "NordVPN"
+    override val fields = listOf(Field("token", "Access token", secret = true))
+    override val help = "Nord Account → NordVPN → Set up NordVPN manually → Access token → Generate new token. " +
+        "The servers keep working after the token expires; log in again to pick new ones."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val token = values["token"].orEmpty()
+        val auth = "Basic " + Base64.encode("token:$token".toByteArray())
+        val creds = Http.json(Http.request("$API/users/services/credentials", headers = mapOf("Authorization" to auth), error = ::errorMessage)).jsonObject
+        state["private_key"] = creds.str("nordlynx_private_key") ?: throw ApiException("This NordVPN account has no NordLynx key.")
+        state["token_tail"] = token.takeLast(4)
+    }
+
+    override fun status(state: Provider.State) = state["token_tail"]?.let { "Token ••••$it" }
+
+    override fun locations(state: Provider.State) = parseCountries(Http.request("$API/servers/countries", error = ::errorMessage))
+
+    fun parseCountries(json: String) = Http.json(json).jsonArray.flatMap { c ->
+        val country = c.jsonObject
+        country["cities"]?.jsonArray.orEmpty().map { it.jsonObject }.map { city ->
+            Location(
+                city["id"]!!.jsonPrimitive.content,
+                "${country.str("name")} · ${city.str("name")}",
+                mapOf("name" to "NordVPN ${city.str("name")} ${country.str("code")}"),
+            )
+        }
+    }.sortedBy { it.label }
+
+    override fun confs(state: Provider.State, picked: List<Location>) = picked.mapNotNull { loc ->
+        val q = listOf(
+            "filters[servers_technologies][identifier]" to "wireguard_udp",
+            "filters[servers_technologies][pivot][status]" to "online",
+            "filters[country_city_id]" to loc.code,
+            "limit" to "1",
+        ).joinToString("&") { (k, v) -> URLEncoder.encode(k, "UTF-8") + "=" + v }
+        val server = Http.json(Http.request("$API/servers/recommendations?$q", error = ::errorMessage)).jsonArray.firstOrNull()?.jsonObject ?: return@mapNotNull null
+        ServerConf(loc.extra.getValue("name"), conf(state.require("private_key"), server) ?: return@mapNotNull null)
+    }
+
+    fun conf(privateKey: String, server: JsonObject): String? {
+        val key = server["technologies"]?.jsonArray?.map { it.jsonObject }?.firstOrNull { it.str("identifier") == "wireguard_udp" }
+            ?.get("metadata")?.jsonArray?.map { it.jsonObject }?.firstOrNull { it.str("name") == "public_key" }?.str("value") ?: return null
+        val ip = server.str("station") ?: return null
+        return wgConf(privateKey, listOf("10.5.0.2/32"), listOf("103.86.96.100", "103.86.99.100"), key, "$ip:51820", server.str("hostname"))
+    }
+
+    private fun errorMessage(code: Int, text: String) = when {
+        code == 400 || code == 401 -> "Wrong or expired access token."
+        code == 429 -> "Too many attempts. Wait a minute and try again."
+        else -> "NordVPN API error $code" + (runCatching { Http.json(text).jsonObject["errors"]?.jsonObject?.get("code")?.jsonPrimitive?.intOrNull }.getOrNull()?.let { " ($it)" } ?: "") + "."
+    }
+}
