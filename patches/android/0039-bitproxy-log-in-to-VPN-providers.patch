+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import io.nekohasekai.sfa.bitproxy.wireguard.Curve25519
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import java.net.URLEncoder
+import java.security.KeyStore
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import javax.net.ssl.HostnameVerifier
+import javax.net.ssl.SSLContext
+import javax.net.ssl.TrustManagerFactory
+
+/**
+ * Private Internet Access, as in PIA's own manual-connections scripts (github.com/pia-foss/manual-connections):
+ * username + password give a 24 h token; each server's addKey (port 1337, PIA's own CA) registers
+ * a key and returns that server's tunnel address. PIA forgets keys that stay unused for a while,
+ * so the password is kept to register fresh keys when you choose locations again.
+ */
+object Pia : Provider {
+    override val id = "pia"
+    override val name = "Private Internet Access"
+    override val fields = listOf(Field("username", "Username (p1234567)"), Field("password", "Password", secret = true))
+    override val help = "PIA forgets keys that stay unused for some time. If a PIA server stops working, " +
+        "open PIA here → Choose locations → Save to register new keys."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        state["token"] = token(values["username"].orEmpty(), values["password"].orEmpty())
+        state["token_time"] = System.currentTimeMillis().toString()
+        state["username"] = values["username"]
+        state["password"] = values["password"]
+    }
+
+    override fun status(state: Provider.State) = state["username"]?.let { "User $it" }
+
+    override fun locations(state: Provider.State) =
+        parseRegions(Http.request("https://serverlist.piaservers.net/vpninfo/servers/v6", error = { code, _ -> "PIA server list error $code." }))
+
+    /** The JSON is followed by a base64 signature (which never contains '}'). */
+    fun parseRegions(text: String) = Http.json(text.substring(0, text.lastIndexOf('}') + 1)).jsonObject["regions"]!!.jsonArray.map { it.jsonObject }
+        .filter { it["offline"]?.jsonPrimitive?.booleanOrNull != true }
+        .mapNotNull { r ->
+            val wg = r["servers"]?.jsonObject?.get("wg")?.jsonArray?.firstOrNull()?.jsonObject ?: return@mapNotNull null
+            val name = r.str("name") ?: return@mapNotNull null
+            Location(r.str("id") ?: return@mapNotNull null, name, mapOf("name" to "PIA $name", "ip" to (wg.str("ip") ?: return@mapNotNull null), "cn" to (wg.str("cn") ?: return@mapNotNull null)))
+        }.sortedBy { it.label }
+
+    override fun confs(state: Provider.State, picked: List<Location>): List<ServerConf> {
+        val token = freshToken(state)
+        return picked.map { loc ->
+            val pair = Curve25519.generate()
+            val ip = loc.extra.getValue("ip")
+            val cn = loc.extra.getValue("cn")
+            val url = "https://$ip:1337/addKey?pt=${URLEncoder.encode(token, "UTF-8")}&pubkey=${URLEncoder.encode(pair.publicKey, "UTF-8")}"
+            val r = Http.json(Http.request(url, socketFactory = tls.socketFactory, hostnameVerifier = verifier(cn), error = { code, _ -> "PIA ${loc.label}: addKey error $code." })).jsonObject
+            if (r.str("status") != "OK") throw ApiException("PIA ${loc.label}: ${r.str("message") ?: "addKey failed"}")
+            val peerIp = r.str("peer_ip") ?: throw ApiException("PIA ${loc.label}: no tunnel address.")
+            val dns = r["dns_servers"]?.jsonArray?.map { it.jsonPrimitive.content }.orEmpty().ifEmpty { listOf("10.0.0.243") }
+            val port = r["server_port"]?.jsonPrimitive?.intOrNull ?: 1337
+            ServerConf(
+                loc.extra.getValue("name"),
+                wgConf(pair.privateKey, listOf(if ('/' in peerIp) peerIp else "$peerIp/32"), dns.take(1), r.str("server_key") ?: throw ApiException("PIA: no server key."), "$ip:$port", cn, keepalive = 25),
+            )
+        }
+    }
+
+    private fun freshToken(state: Provider.State): String {
+        val age = System.currentTimeMillis() - (state["token_time"]?.toLongOrNull() ?: 0)
+        state["token"]?.takeIf { age < 20 * 3600_000L }?.let { return it }
+        return token(state.require("username"), state.require("password")).also {
+            state["token"] = it
+            state["token_time"] = System.currentTimeMillis().toString()
+        }
+    }
+
+    private fun token(username: String, password: String): String {
+        val boundary = "BitProxy" + System.nanoTime()
+        val body = buildString {
+            for ((k, v) in listOf("username" to username, "password" to password)) {
+                append("--$boundary\r\nContent-Disposition: form-data; name=\"$k\"\r\n\r\n$v\r\n")
+            }
+            append("--$boundary--\r\n")
+        }
+        val r = Http.request(
+            "https://www.privateinternetaccess.com/api/client/v2/token",
+            "POST",
+            body = body,
+            contentType = "multipart/form-data; boundary=$boundary",
+            error = { code, _ -> if (code == 401 || code == 403) "Wrong username or password." else "PIA login error $code." },
+        )
+        return Http.json(r).jsonObject.str("token") ?: throw ApiException("PIA login failed.")
+    }
+
+    /** Server names like "losangeles403" are not DNS names: compare the certificate's CN directly. */
+    private fun verifier(cn: String) = HostnameVerifier { _, session ->
+        val cert = session.peerCertificates.firstOrNull() as? X509Certificate
+        cert?.subjectX500Principal?.name?.split(',')?.map { it.trim() }?.any { it == "CN=$cn" } == true
+    }
+
+    private val tls by lazy {
