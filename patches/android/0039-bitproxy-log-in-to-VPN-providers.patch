@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import io.nekohasekai.sfa.bitproxy.wireguard.Curve25519
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import java.net.InetAddress
+import java.net.Socket
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.SSLSocketFactory
+
+/**
+ * Cloudflare WARP (free, no account): an anonymous registration, as done by wgcf. Not an official
+ * API: Cloudflare may change it. The version path and headers mimic the 1.1.1.1 Android app.
+ */
+object Warp : Provider {
+    // ponytail: pinned app version, update when Cloudflare starts refusing it (see github.com/ViRb3/wgcf)
+    private const val API = "https://api.cloudflareclient.com/v0a5641"
+    private val headers = mapOf(
+        "User-Agent" to "1.1.1.1/6.38.9-5641 (Android 16.0.0)",
+        "CF-Client-Version" to "a-6.38.9-5641",
+    )
+    override val id = "warp"
+    override val name = "Cloudflare WARP"
+    override val fields = emptyList<Field>()
+    override val help = "Free, no account. Registers this device with Cloudflare anonymously. " +
+        "WARP hides your traffic from the local network but uses the nearest Cloudflare location only."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val pair = Curve25519.generate()
+        val body = buildJsonObject {
+            put("key", pair.publicKey)
+            put("install_id", "")
+            put("fcm_token", "")
+            put("tos", java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", java.util.Locale.US).apply { timeZone = java.util.TimeZone.getTimeZone("UTC") }.format(java.util.Date()))
+            put("model", "PC")
+            put("serial_number", "")
+            put("locale", "en_US")
+            put("os_version", "16.0.0")
+            put("key_type", "curve25519")
+            put("tunnel_type", "wireguard")
+        }
+        val reg = Http.json(Http.request("$API/reg", "POST", headers, body.toString(), "application/json; charset=UTF-8", AppLikeTls, error = ::errorMessage)).jsonObject
+        val config = reg["config"]!!.jsonObject
+        val addresses = config["interface"]!!.jsonObject["addresses"]!!.jsonObject
+        val peer = config["peers"]!!.jsonArray.first().jsonObject
+        state["id"] = reg.str("id")
+        state["token"] = reg.str("token")
+        state["private_key"] = pair.privateKey
+        state["ipv4"] = addresses.str("v4")?.let { "$it/32" } ?: throw ApiException("WARP gave no tunnel address.")
+        state["ipv6"] = addresses.str("v6")?.let { "$it/128" }
+        state["peer_key"] = peer.str("public_key")
+        state["endpoint_v4"] = peer["endpoint"]?.jsonObject?.str("v4")?.substringBeforeLast(':')
+    }
+
+    override fun status(state: Provider.State) = "Registered"
+
+    override fun locations(state: Provider.State) = listOf(Location("nearest", "Nearest Cloudflare location"))
+
+    override fun confs(state: Provider.State, picked: List<Location>) = picked.map {
+        val host = state["endpoint_v4"]?.takeIf { it.isNotBlank() } ?: "162.159.192.1"
+        ServerConf(
+            "Cloudflare WARP",
+            wgConf(
+                state.require("private_key"),
+                listOfNotNull(state.require("ipv4"), state["ipv6"]),
+                listOf("1.1.1.1", "1.0.0.1"),
+                state.require("peer_key"),
+                "$host:2408",
+                mtu = 1280,
+            ),
+        )
+    }
+
+    override fun logout(state: Provider.State) {
+        val id = state["id"] ?: return
+        Http.request("$API/reg/$id", "DELETE", headers + ("Authorization" to "Bearer ${state["token"]}"), socketFactory = AppLikeTls, error = ::errorMessage)
+    }
+
+    private fun errorMessage(code: Int, text: String) = when (code) {
+        429 -> "Cloudflare refused the registration (429). Try again later."
+        else -> runCatching { Http.json(text).jsonObject["errors"]!!.jsonArray.first().jsonObject.str("message") }.getOrNull()?.let { "WARP: $it" } ?: "WARP API error $code."
+    }
+
+    /** Cloudflare refuses registrations whose TLS handshake doesn't look like its app: TLS 1.2, two AES-256-GCM suites. */
+    private object AppLikeTls : SSLSocketFactory() {
+        private val base = SSLSocketFactory.getDefault() as SSLSocketFactory
+        private val suites = arrayOf("TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384", "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384")
+
+        private fun Socket.tune() = apply {
+            (this as? SSLSocket)?.let { s ->
+                s.enabledProtocols = arrayOf("TLSv1.2")
+                s.enabledCipherSuites = suites.filter { it in s.supportedCipherSuites }.toTypedArray()
+            }
+        }
+
+        override fun getDefaultCipherSuites() = suites
+        override fun getSupportedCipherSuites() = suites
+        override fun createSocket(s: Socket, host: String, port: Int, autoClose: Boolean) = base.createSocket(s, host, port, autoClose).tune()
+        override fun createSocket(host: String, port: Int) = base.createSocket(host, port).tune()
+        override fun createSocket(host: String, port: Int, localHost: InetAddress, localPort: Int) = base.createSocket(host, port, localHost, localPort).tune()
+        override fun createSocket(host: InetAddress, port: Int) = base.createSocket(host, port).tune()
+        override fun createSocket(address: InetAddress, port: Int, localAddress: InetAddress, localPort: Int) = base.createSocket(address, port, localAddress, localPort).tune()
+    }
+}
