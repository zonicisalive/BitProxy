+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import io.nekohasekai.sfa.bitproxy.wireguard.ParseResult
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConfParser
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Parsers against trimmed copies of each provider's public API responses (dummy keys). */
+class ProvidersTest {
+    private val key1 = "+ZwootR5fY6py1jCqJ6S6drE2CQQttwt3S3IIPVukIM="
+    private val key2 = "ha4StsG0IysrJajzBTO1FDtTQSsP128CdQegmOFqp94="
+
+    private fun parses(text: String, name: String) = (WireGuardConfParser.parse(text, "$name.conf") as ParseResult.Ok).conf
+
+    @Test fun ivpnLeastLoadedHost() {
+        val json = """{"wireguard": [{"gateway": "ar.wg.ivpn.net", "country_code": "AR", "country": "Argentina", "city": "Buenos Aires", "hosts": [
+            {"hostname": "ar1.wg.ivpn.net", "host": "192.0.2.1", "public_key": "$key1", "local_ip": "172.16.0.1/12", "load": 58.9},
+            {"hostname": "ar2.wg.ivpn.net", "host": "192.0.2.2", "public_key": "$key2", "local_ip": "172.16.0.1/12", "load": 10.0}]}], "openvpn": [], "config": {}}"""
+        val loc = Ivpn.parseServers(json).single()
+        assertEquals("ar.wg.ivpn.net", loc.code)
+        assertEquals("192.0.2.2", loc.extra["ip"])
+        assertEquals("172.16.0.1", loc.extra["dns"])
+    }
+
+    @Test fun piaRegionsSkipOfflineAndSignature() {
+        val text = """{"groups": {}, "regions": [
+            {"id": "us_california", "name": "US California", "country": "US", "offline": false, "servers": {"wg": [{"ip": "192.0.2.5", "cn": "losangeles403"}]}},
+            {"id": "gone", "name": "Gone", "country": "XX", "offline": true, "servers": {"wg": [{"ip": "192.0.2.6", "cn": "gone1"}]}}]}
+            |
+            |c2lnbmF0dXJl""".trimMargin()
+        val loc = Pia.parseRegions(text).single()
+        assertEquals("us_california", loc.code)
+        assertEquals("losangeles403", loc.extra["cn"])
+    }
+
+    @Test fun airvpnSkipsBrokenServers() {
+        val json = """{"result": "ok", "servers": [
+            {"public_name": "Achernar", "country_name": "Switzerland", "location": "Zurich", "health": "warning"},
+            {"public_name": "Broken", "country_name": "Nowhere", "location": "X", "health": "error"}]}"""
+        val loc = AirVpn.parseStatus(json).single()
+        assertEquals("Achernar", loc.code)
+        assertEquals("AirVPN Zurich Achernar", loc.extra["name"])
+    }
+
+    @Test fun azireLocationsAndConf() {
+        val json = """{"status": "success", "locations": [{"name": "se-sto", "city": "Stockholm", "country": "Sweden", "iso": "se", "pool": "se-sto.azirevpn.net", "pubkey": "$key2"}]}"""
+        val loc = AzireVpn.parseLocations(json).single()
+        val conf = parses(wgConf(key1, listOf("10.0.5.6/32"), listOf("10.0.0.1"), loc.extra.getValue("key"), "${loc.extra["host"]}:51820"), loc.extra.getValue("name"))
+        assertEquals("se-sto.azirevpn.net", conf.peers.single().host)
+        assertEquals("AzireVPN Stockholm SE", conf.name)
+    }
+
+    @Test fun nordCitiesAndServerConf() {
+        val countries = """[{"id": 81, "name": "Germany", "code": "DE", "cities": [{"id": 2181458, "name": "Berlin"}, {"id": 2215709, "name": "Frankfurt"}]}]"""
+        val locs = NordVpn.parseCountries(countries)
+        assertEquals(listOf("2181458", "2215709"), locs.map { it.code })
+        val server = io.nekohasekai.sfa.bitproxy.providers.Http.json(
+            """{"hostname": "de1465.nordvpn.com", "station": "192.0.2.9", "technologies": [{"identifier": "openvpn_udp"},
+            {"identifier": "wireguard_udp", "metadata": [{"name": "public_key", "value": "$key2"}]}]}""",
+        ) as kotlinx.serialization.json.JsonObject
+        val conf = parses(NordVpn.conf(key1, server)!!, "NordVPN Berlin DE")
+        assertEquals("192.0.2.9", conf.peers.single().host)
+        assertEquals("10.5.0.2", conf.ipv4Address.address.toString())
+    }
+
+    @Test fun keepaliveAndMtu() {
+        val conf = parses(wgConf(key1, listOf("10.1.2.3/32"), listOf("10.0.0.243"), key2, "192.0.2.5:1337", mtu = 1280, keepalive = 25), "PIA test")
+        assertEquals(1280, conf.mtu)
+        assertEquals(25, conf.peers.single().persistentKeepalive)
+        assertTrue(conf.peers.single().port == 1337)
+    }
+}
