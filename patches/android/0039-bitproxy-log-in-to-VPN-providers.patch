@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import io.nekohasekai.sfa.bitproxy.wireguard.Curve25519
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+/**
+ * Mullvad: account number only. Registers one WireGuard key as a "device" on the account
+ * (max 5 per account), one server per chosen city. Public API used by Mullvad's own apps.
+ */
+object Mullvad : Provider {
+    private const val API = "https://api.mullvad.net"
+    override val id = "mullvad"
+    override val name = "Mullvad"
+    override val fields = listOf(Field("account", "Account number", secret = true))
+    override val help = "Adds one device to your Mullvad account. Log out here to remove it again."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val number = values["account"].orEmpty().filter(Char::isDigit)
+        if (number.length != 16) throw ApiException("A Mullvad account number has 16 digits.")
+        val token = token(number)
+        // Same account again: reuse the key if its device still exists, so no extra device slot is used.
+        val oldKey = state["private_key"]?.takeIf { state["account"] == number }
+        val existing = oldKey?.let { key ->
+            val pub = Curve25519.publicKey(key)
+            api("GET", "/accounts/v1/devices", token).jsonArray.map { it.jsonObject }.firstOrNull { it.str("pubkey") == pub }?.let { key to it }
+        }
+        val (key, device) = existing ?: Curve25519.generate().let { pair ->
+            val body = buildJsonObject {
+                put("pubkey", pair.publicKey)
+                put("hijack_dns", false)
+            }
+            pair.privateKey to api("POST", "/accounts/v1/devices", token, body.toString()).jsonObject
+        }
+        state["account"] = number
+        state["private_key"] = key
+        state["device_id"] = device.str("id")
+        state["ipv4"] = device.str("ipv4_address")
+        state["ipv6"] = device.str("ipv6_address")
+        state["expiry"] = runCatching { api("GET", "/accounts/v1/accounts/me", token).jsonObject.str("expiry")?.substringBefore('T') }.getOrNull()
+    }
+
+    override fun status(state: Provider.State) =
+        "Account ••••${state["account"].orEmpty().takeLast(4)}" + (state["expiry"]?.let { " · paid until $it" } ?: "")
+
+    override fun locations(state: Provider.State) = parseRelays(Http.request("$API/app/v1/relays", error = ::errorMessage))
+
+    override fun confs(state: Provider.State, picked: List<Location>) = picked.map { loc ->
+        val addresses = listOfNotNull(state.require("ipv4"), state["ipv6"])
+        ServerConf(loc.extra.getValue("name"), wgConf(state.require("private_key"), addresses, listOf(loc.extra.getValue("dns")), loc.extra.getValue("key"), "${loc.extra.getValue("ip")}:51820", loc.extra["host"]))
+    }
+
+    override fun logout(state: Provider.State) {
+        val number = state["account"] ?: return
+        val id = state["device_id"] ?: return
+        api("DELETE", "/accounts/v1/devices/$id", token(number))
+    }
+
+    /** Active relays grouped by city; the best one per city (Mullvad-owned, then highest weight). */
+    fun parseRelays(json: String): List<Location> {
+        val root = Http.json(json).jsonObject
+        val names = root["locations"]!!.jsonObject
+        val wg = root["wireguard"]!!.jsonObject
+        val dns = wg.str("ipv4_gateway") ?: "10.64.0.1"
+        return wg["relays"]!!.jsonArray.map { it.jsonObject }
+            .filter { it["active"]?.jsonPrimitive?.booleanOrNull == true && it.str("ipv4_addr_in") != null && it.str("public_key") != null }
+            .groupBy { it.str("location") ?: "" }
+            .mapNotNull { (code, relays) ->
+                val place = names[code]?.jsonObject ?: return@mapNotNull null
+                val best = relays.sortedWith(
+                    compareByDescending<kotlinx.serialization.json.JsonObject> { it["owned"]?.jsonPrimitive?.booleanOrNull == true }
+                        .thenByDescending { it["weight"]?.jsonPrimitive?.intOrNull ?: 0 },
+                ).first()
+                val city = place.str("city") ?: code
+                Location(
+                    code,
+                    "${place.str("country") ?: code} · $city",
+                    mapOf(
+                        "name" to "Mullvad $city ${code.substringBefore('-').uppercase()}",
+                        "host" to best.str("hostname").orEmpty(),
+                        "ip" to best.str("ipv4_addr_in")!!,
+                        "key" to best.str("public_key")!!,
+                        "dns" to dns,
+                    ),
+                )
+            }
+            .sortedBy { it.label }
+    }
+
+    private fun token(number: String): String {
+        val body = buildJsonObject { put("account_number", number) }
+        return api("POST", "/auth/v1/token", null, body.toString()).jsonObject.str("access_token") ?: throw ApiException("Mullvad login failed.")
+    }
+
+    private fun api(method: String, path: String, token: String?, body: String? = null) =
+        Http.request(API + path, method, token?.let { mapOf("Authorization" to "Bearer $it") }.orEmpty(), body, error = ::errorMessage)
+            .ifBlank { "null" }.let(Http::json)
+
+    private fun errorMessage(code: Int, text: String): String = when (runCatching { Http.json(text).jsonObject.str("code") }.getOrNull()) {
+        "INVALID_ACCOUNT" -> "Wrong account number."
+        "MAX_DEVICES_REACHED" -> "This account already has the maximum number of devices. Remove one at mullvad.net/account, then try again."
+        "PUBKEY_IN_USE" -> "This key is already registered. Log out and log in again."
+        else -> if (code == 429) "Too many attempts. Wait a minute and try again." else "Mullvad API error $code."
+    }
+}
