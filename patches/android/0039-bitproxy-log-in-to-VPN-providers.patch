+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.providers
+
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import java.net.URLEncoder
+import java.util.zip.ZipInputStream
+
+/**
+ * AirVPN: the API key from the Client Area. AirVPN creates the WireGuard keys itself (per device
+ * on its website), so its config generator returns finished .conf files.
+ */
+object AirVpn : Provider {
+    private const val API = "https://airvpn.org/api"
+    override val id = "airvpn"
+    override val name = "AirVPN"
+    override val fields = listOf(Field("key", "API key", secret = true), Field("device", "Device name (default: Default)", optional = true))
+    override val help = "AirVPN Client Area → API → enable and copy the key. The keys come from that AirVPN device; " +
+        "manage devices on airvpn.org."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val key = values["key"].orEmpty()
+        checkError(Http.request("$API/userinfo/", headers = mapOf("API-KEY" to key), error = ::errorMessage))
+        state["key"] = key
+        state["device"] = values["device"]?.takeIf { it.isNotBlank() } ?: "Default"
+    }
+
+    override fun status(state: Provider.State) = "Device ${state["device"]}"
+
+    override fun locations(state: Provider.State) = parseStatus(Http.request("$API/status/", error = ::errorMessage))
+
+    /** Every server that isn't down; AirVPN names each server (e.g. "Achernar"). */
+    fun parseStatus(json: String) = Http.json(json).jsonObject["servers"]!!.jsonArray.map { it.jsonObject }
+        .filter { it.str("health") != "error" }
+        .mapNotNull { s ->
+            val name = s.str("public_name") ?: return@mapNotNull null
+            Location(name, "${s.str("country_name")} · ${s.str("location")} · $name", mapOf("name" to "AirVPN ${s.str("location")} $name"))
+        }.sortedBy { it.label }
+
+    override fun confs(state: Provider.State, picked: List<Location>): List<ServerConf> {
+        if (picked.isEmpty()) return emptyList()
+        val query = listOf(
+            "protocols" to "wireguard_1_udp_1637",
+            "servers" to picked.joinToString(",") { it.code },
+            "device" to (state["device"] ?: "Default"),
+            "system" to "linux",
+            "iplayer_entry" to "ipv4",
+            "iplayer_exit" to "ipv4",
+            "download" to "zip",
+        ).joinToString("&") { (k, v) -> "$k=${URLEncoder.encode(v, "UTF-8")}" }
+        val data = Http.bytes("$API/generator/?$query", headers = mapOf("API-KEY" to state.require("key")), error = ::errorMessage)
+        if (data.size < 2 || data[0] != 'P'.code.toByte() || data[1] != 'K'.code.toByte()) {
+            checkError(String(data))
+            throw ApiException("AirVPN returned no configs.")
+        }
+        val files = mutableListOf<Pair<String, String>>()
+        ZipInputStream(data.inputStream()).use { zip ->
+            generateSequence { zip.nextEntry }.filter { it.name.endsWith(".conf") }.forEach { files += it.name to zip.readBytes().decodeToString() }
+        }
+        // Match files to servers by name (files look like AirVPN_<Country>_<Server>_UDP-1637.conf).
+        return files.map { (file, text) ->
+            val loc = picked.firstOrNull { file.contains(it.code, ignoreCase = true) }
+            ServerConf(loc?.extra?.get("name") ?: file.substringAfterLast('/').removeSuffix(".conf"), text)
+        }
+    }
+
+    private fun checkError(text: String) {
+        runCatching { Http.json(text).jsonObject.str("error") }.getOrNull()?.let {
+            throw ApiException(if (it == "Not authorized") "Wrong API key, or the API is not enabled in the Client Area." else "AirVPN: $it")
+        }
+    }
+
+    private fun errorMessage(code: Int, text: String) = runCatching { Http.json(text).jsonObject.str("error") }.getOrNull()?.let { "AirVPN: $it" } ?: "AirVPN API error $code."
+}
