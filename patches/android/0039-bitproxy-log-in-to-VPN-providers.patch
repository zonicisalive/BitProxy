+/**
+ * IVPN (github.com/ivpn/desktop-app, daemon/api): the account ID opens a session that carries
+ * this app's WireGuard key; one tunnel IP for every server. Port 2049 is IVPN's default.
+ */
+object Ivpn : Provider {
+    private const val API = "https://api.ivpn.net"
+    override val id = "ivpn"
+    override val name = "IVPN"
+    override val fields = listOf(Field("account", "Account ID (i-XXXX-XXXX-XXXX)", secret = true), Field("code", "2FA code", optional = true))
+    override val help = "Opens one IVPN session (device). Log out here to close it again."
+
+    override fun login(values: Map<String, String>, state: Provider.State) {
+        val account = values["account"].orEmpty()
+        if (!Regex("""^(i-....-....-....|ivpn[a-zA-Z0-9]{7,8})$""").matches(account)) throw ApiException("An IVPN account ID looks like i-XXXX-XXXX-XXXX.")
+        val pair = Curve25519.generate()
+        val body = buildJsonObject {
+            put("username", account)
+            put("force", false)
+            put("wg_public_key", pair.publicKey)
+            values["code"]?.takeIf { it.isNotBlank() }?.let { put("confirmation", it) }
+        }
+        val r = api("/v4/session/new", body.toString())
+        state["token"] = r.str("token") ?: throw ApiException("IVPN login failed.")
+        state["account"] = account
+        state["private_key"] = pair.privateKey
+        state["ipv4"] = r["wireguard"]?.jsonObject?.str("ip_address")?.let { if ('/' in it) it else "$it/32" } ?: throw ApiException("IVPN gave no tunnel address.")
+        state["active_until"] = r["service_status"]?.jsonObject?.get("active_until")?.jsonPrimitive?.content?.toLongOrNull()
+            ?.let { java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.US).format(java.util.Date(it * 1000)) }
+    }
+
+    override fun status(state: Provider.State) =
+        "Account ••••${state["account"].orEmpty().takeLast(4)}" + (state["active_until"]?.let { " · active until $it" } ?: "")
+
+    override fun locations(state: Provider.State) = parseServers(Http.request("$API/v5/servers.json", error = { code, _ -> "IVPN API error $code." }))
+
+    /** One location per gateway (city); the least loaded host. */
+    fun parseServers(json: String) = Http.json(json).jsonObject["wireguard"]!!.jsonArray.map { it.jsonObject }.mapNotNull { g ->
+        val host = g["hosts"]?.jsonArray?.map { it.jsonObject }?.filter { it.str("host") != null && it.str("public_key") != null }
+            ?.minByOrNull { it["load"]?.jsonPrimitive?.doubleOrNull ?: 100.0 } ?: return@mapNotNull null
+        val city = g.str("city") ?: return@mapNotNull null
+        Location(
+            g.str("gateway") ?: return@mapNotNull null,
+            "${g.str("country")} · $city",
+            mapOf(
+                "name" to "IVPN $city ${g.str("country_code")}",
+                "host" to host.str("hostname").orEmpty(),
+                "ip" to host.str("host")!!,
+                "key" to host.str("public_key")!!,
+                "dns" to (host.str("local_ip")?.substringBefore('/') ?: "172.16.0.1"),
+            ),
+        )
+    }.sortedBy { it.label }
+
+    override fun confs(state: Provider.State, picked: List<Location>) = picked.map { loc ->
+        ServerConf(loc.extra.getValue("name"), wgConf(state.require("private_key"), listOf(state.require("ipv4")), listOf(loc.extra.getValue("dns")), loc.extra.getValue("key"), "${loc.extra.getValue("ip")}:2049", loc.extra["host"]))
+    }
+
+    override fun logout(state: Provider.State) {
+        val token = state["token"] ?: return
+        api("/v4/session/delete", buildJsonObject { put("session_token", token) }.toString())
+    }
+
+    /** IVPN answers errors with HTTP 400 and the real code in the body's "status". */
+    private fun api(path: String, body: String): JsonObject {
+        val r = Http.json(Http.request(API + path, "POST", body = body, error = { code, text -> errorMessage(runCatching { Http.json(text).jsonObject }.getOrNull(), code) })).jsonObject
+        if ((r["status"]?.jsonPrimitive?.intOrNull ?: 200) != 200) throw ApiException(errorMessage(r, 200))
+        return r
+    }
+
+    private fun errorMessage(r: JsonObject?, http: Int) = when (r?.get("status")?.jsonPrimitive?.intOrNull) {
+        401 -> "Wrong account ID."
+        602 -> "Too many devices on this IVPN account. Log out one in the IVPN app or at ivpn.net/account, then try again."
+        702 -> "This IVPN account is not active."
+        70001, 70002 -> "IVPN asks for a captcha. Log in once on ivpn.net, then try again here."
+        70011 -> "Enter your 2FA code."
+        70012 -> "Wrong 2FA code."
+        else -> r?.str("message")?.let { "IVPN: $it" } ?: "IVPN API error $http."
+    }
+}
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/providers/Mullvad.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/providers/Mullvad.kt
