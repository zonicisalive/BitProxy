@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.net.InetAddress
+
+class Ipv6DetectTest {
+    private fun a(vararg s: String) = s.map { InetAddress.getByName(it) } // literals only, no DNS
+
+    @Test fun wifiWithoutIpv6() = assertFalse(Ipv6Detect.hasGlobalIpv6(a("192.168.1.20", "fe80::1"), false))
+
+    @Test fun dualStack() = assertTrue(Ipv6Detect.hasGlobalIpv6(a("192.168.1.20", "2001:db8:1::20", "fe80::1"), true))
+
+    @Test fun ipv6OnlyMobile464xlat() = assertTrue(Ipv6Detect.hasGlobalIpv6(a("2a02:8108::5", "192.0.0.4"), true))
+
+    @Test fun linkLocalAndUlaDoNotCount() = assertFalse(Ipv6Detect.hasGlobalIpv6(a("fe80::1", "fd00::5"), true))
+
+    @Test fun globalAddressWithoutDefaultRoute() = assertFalse(Ipv6Detect.hasGlobalIpv6(a("2001:db8::5"), false))
+}
