@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.net.ConnectivityManager
+import android.net.LinkProperties
+import android.net.Network
+import android.util.Log
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bg.DefaultNetworkListener
+import io.nekohasekai.sfa.database.Settings
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import java.net.Inet6Address
+import java.net.InetAddress
+
+/** Pure IPv6 check, unit tested. */
+object Ipv6Detect {
+    /** A global unicast IPv6 address (2000::/3) plus an IPv6 default route. */
+    fun hasGlobalIpv6(addresses: List<InetAddress>, hasIpv6DefaultRoute: Boolean): Boolean = hasIpv6DefaultRoute &&
+        addresses.any { it is Inet6Address && (it.address[0].toInt() and 0xe0) == 0x20 }
+
+    fun hasGlobalIpv6(lp: LinkProperties?): Boolean {
+        lp ?: return false
+        return hasGlobalIpv6(
+            lp.linkAddresses.map { it.address },
+            lp.routes.any { it.isDefaultRoute && it.destination.address is Inet6Address },
+        )
+    }
+}
+
+/**
+ * Automatic IPv6 mode: while the VPN runs, watch the underlying network (not the VPN) and
+ * re-apply the config when global IPv6 appears or disappears. Debounced so Wi-Fi/mobile
+ * flapping can't cause a restart loop.
+ */
+object Ipv6Watcher {
+    private const val TAG = "BitProxy"
+    private const val DEBOUNCE_MS = 5_000L
+    private const val MIN_INTERVAL_MS = 30_000L
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var pending: Job? = null
+    private var lastApply = 0L
+
+    /** Last seen state of the underlying network; null when unknown. */
+    @Volatile var hasIpv6: Boolean? = null
+        private set
+
+    /** For Apply from the UI: the watcher's value while running, else the current default network. */
+    fun current(): Boolean = hasIpv6 ?: runCatching {
+        val cm = Application.application.getSystemService(ConnectivityManager::class.java)
+        Ipv6Detect.hasGlobalIpv6(cm.getLinkProperties(cm.activeNetwork))
+    }.getOrDefault(false)
+
+    fun start() = scope.launch {
+        DefaultNetworkListener.start(this@Ipv6Watcher) { network -> onNetwork(network) }
+    }
+
+    fun stop() = scope.launch {
+        pending?.cancel()
+        hasIpv6 = null
+        DefaultNetworkListener.stop(this@Ipv6Watcher)
+    }
+
+    private fun onNetwork(network: Network?) {
+        pending?.cancel()
+        pending = scope.launch {
+            delay(DEBOUNCE_MS) // settle: IPv6 addresses often arrive a few seconds after the network
+            val cm = Application.application.getSystemService(ConnectivityManager::class.java)
+            val now = network != null && Ipv6Detect.hasGlobalIpv6(cm.getLinkProperties(network))
+            hasIpv6 = now
+            if (now == BitProxyPrefs.appliedIpv6) return@launch
+            if (Settings.selectedProfile != BitProxyPrefs.profileId) return@launch // not our profile running
+            val wait = lastApply + MIN_INTERVAL_MS - System.currentTimeMillis()
+            if (wait > 0) delay(wait)
+            lastApply = System.currentTimeMillis()
+            Log.i(TAG, "underlying network IPv6 changed to $now; re-applying")
+            BitProxyApplier.apply(serviceRunning = true, ipv6 = now)
+        }
+    }
+}
