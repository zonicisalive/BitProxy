+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Process
+import android.util.Log
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.AppKey
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.Mode
+import io.nekohasekai.sfa.bitproxy.config.AppRoute
+import java.util.concurrent.TimeUnit
+
+/** Android uid = userId * 100000 + appId. */
+object Uid {
+    const val PER_USER = 100_000
+    const val CLONE_USER = 999
+
+    fun userId(uid: Int) = uid / PER_USER
+
+    fun appId(uid: Int) = uid % PER_USER
+
+    fun of(userId: Int, appId: Int) = userId * PER_USER + appId
+
+    fun userLabel(userId: Int) = when (userId) {
+        0 -> ""
+        CLONE_USER -> " (Clone)"
+        else -> " (Profile $userId)"
+    }
+}
+
+/** Snapshot of installed apps: live uids per (package, user). Built fresh on every generation. */
+class AppScan(
+    val currentUser: Int,
+    /** Apps of the current user: package -> ApplicationInfo. */
+    val apps: Map<String, ApplicationInfo>,
+    /** Every (package, user) we can see, with its uid. Includes clones when `pm` reports them. */
+    val uids: Map<AppKey, Int>,
+    /** False when `pm list packages -U` could not be run; only manual clones work then. */
+    val pmAvailable: Boolean,
+) {
+    private val labels = HashMap<String, String>()
+
+    fun label(packageName: String): String = labels.getOrPut(packageName) {
+        apps[packageName]?.let { runCatching { it.loadLabel(Application.packageManager).toString() }.getOrNull() } ?: packageName
+    }
+
+    /**
+     * Resolves saved choices to routes. Keys of other users that `pm` can't see (manual clones)
+     * get their uid computed from the app id. Uninstalled apps are dropped here but their saved
+     * choice stays, so a reinstall picks it up again with the new uid. Apps sharing a uid
+     * (android:sharedUserId) become one route.
+     */
+    fun routes(choices: Map<AppKey, Mode>): List<AppRoute> {
+        val byUid = linkedMapOf<Int, MutableList<Pair<AppKey, Mode>>>()
+        for ((key, mode) in choices.entries.sortedBy { label(it.key.packageName).lowercase() + it.key.userId }) {
+            val uid = uids[key] ?: run {
+                if (key.userId == currentUser) return@run null
+                val appId = uids[AppKey(key.packageName, currentUser)]?.let(Uid::appId) ?: return@run null
+                Uid.of(key.userId, appId)
+            } ?: continue
+            byUid.getOrPut(uid) { mutableListOf() } += key to mode
+        }
+        return byUid.map { (uid, members) ->
+            val userId = Uid.userId(uid)
+            val names = members.map { label(it.first.packageName) }.distinct().joinToString(" + ")
+            AppRoute(
+                label = names + Uid.userLabel(userId),
+                packageName = members.first().first.packageName,
+                uids = listOf(uid),
+                viaVpn = members.any { it.second == Mode.VPN }, // shared uid: VPN wins, never leak
+            )
+        }
+    }
+}
+
+object AppResolver {
+    private const val TAG = "BitProxy"
+    private val PM_LINE = Regex("""^package:(\S+)\s+uid:([\d,]+)""")
+
+    /** Slow (PackageManager + a `pm` process): call off the main thread. */
+    fun scan(): AppScan {
+        val pm = Application.packageManager
+        val currentUser = Uid.userId(Process.myUid())
+        val apps = try {
+            if (Build.VERSION.SDK_INT >= 33) {
+                pm.getInstalledApplications(PackageManager.ApplicationInfoFlags.of(0))
+            } else {
+                @Suppress("DEPRECATION")
+                pm.getInstalledApplications(0)
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "getInstalledApplications failed", e)
+            emptyList()
+        }.associateBy { it.packageName }
+
+        val uids = HashMap<AppKey, Int>()
+        apps.values.forEach { uids[AppKey(it.packageName, currentUser)] = it.uid }
+        val fromPm = pmListUids()
+        fromPm?.forEach { (pkg, list) -> list.forEach { uids[AppKey(pkg, Uid.userId(it))] = it } }
+        return AppScan(currentUser, apps, uids, fromPm != null)
+    }
+
+    /**
+     * `pm list packages -U`, exactly what conf-merger.py used. On OxygenOS it lists clone
+     * uids (user 999) too; stock Android only shows the calling user. Null if it fails.
+     */
+    private fun pmListUids(): Map<String, List<Int>>? {
+        // Output goes to a file, not a pipe: a full pipe would block pm and the timeout.
+        var out: java.io.File? = null
+        return try {
+            out = java.io.File.createTempFile("pmlist", ".txt", Application.application.cacheDir)
+            val process = ProcessBuilder("pm", "list", "packages", "-U").redirectErrorStream(true).redirectOutput(out).start()
+            process.outputStream.close()
+            if (!process.waitFor(20, TimeUnit.SECONDS)) {
+                process.destroy()
+                Log.w(TAG, "pm list packages -U timed out")
+                return null
+            }
+            out!!.readLines().mapNotNull { PM_LINE.find(it.trim()) }
+                .associate { m -> m.groupValues[1] to m.groupValues[2].split(',').mapNotNull(String::toIntOrNull) }
+                .takeIf { it.isNotEmpty() }
+        } catch (e: Throwable) {
+            Log.w(TAG, "pm list packages -U failed: ${e.message}")
+            null
+        } finally {
+            out?.delete()
+        }
+    }
+}
