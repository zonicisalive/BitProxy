+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.AppKey
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.Mode
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AppScanTest {
+    // Labels fall back to package names when the app has no ApplicationInfo (as here).
+    private fun scan(vararg uids: Pair<AppKey, Int>) = AppScan(0, emptyMap(), uids.toMap(), pmAvailable = true)
+
+    @Test fun uidMath() {
+        assertEquals(99910150, Uid.of(999, 10150))
+        assertEquals(999, Uid.userId(99910150))
+        assertEquals(10150, Uid.appId(99910150))
+        assertEquals(" (Clone)", Uid.userLabel(999))
+        assertEquals(" (Profile 10)", Uid.userLabel(10))
+        assertEquals("", Uid.userLabel(0))
+    }
+
+    @Test fun reinstalledAppUsesItsNewUid() {
+        val choices = mapOf(AppKey("a.app", 0) to Mode.VPN)
+        assertEquals(listOf(10100), scan(AppKey("a.app", 0) to 10100).routes(choices).single().uids)
+        assertEquals(listOf(10555), scan(AppKey("a.app", 0) to 10555).routes(choices).single().uids)
+    }
+
+    @Test fun uninstalledAppIsDroppedButChoiceKept() {
+        val choices = mapOf(AppKey("gone.app", 0) to Mode.VPN, AppKey("a.app", 0) to Mode.DIRECT)
+        val routes = scan(AppKey("a.app", 0) to 10100).routes(choices)
+        assertEquals(listOf("a.app"), routes.map { it.packageName })
+        assertEquals(2, choices.size) // routes() never edits the saved choices
+    }
+
+    @Test fun detectedCloneAndManualClone() {
+        val choices = mapOf(
+            AppKey("wa.b", 0) to Mode.VPN,
+            AppKey("wa.b", 999) to Mode.DIRECT, // detected by pm
+            AppKey("tg.x", 999) to Mode.VPN, // added by hand: uid computed from the main app
+            AppKey("orphan", 999) to Mode.VPN, // no main app to compute from: skipped
+        )
+        val routes = scan(
+            AppKey("wa.b", 0) to 10150,
+            AppKey("wa.b", 999) to 99910150,
+            AppKey("tg.x", 0) to 10170,
+        ).routes(choices).associateBy { it.label }
+        assertEquals(listOf(99910150), routes["wa.b (Clone)"]!!.uids)
+        assertEquals(false, routes["wa.b (Clone)"]!!.viaVpn)
+        assertEquals(listOf(99910170), routes["tg.x (Clone)"]!!.uids)
+        assertEquals(3, routes.size)
+    }
+
+    @Test fun sharedUidIsOneRouteAndVpnWins() {
+        val choices = mapOf(AppKey("s.one", 0) to Mode.DIRECT, AppKey("s.two", 0) to Mode.VPN)
+        val route = scan(AppKey("s.one", 0) to 10300, AppKey("s.two", 0) to 10300).routes(choices).single()
+        assertEquals(listOf(10300), route.uids)
+        assertTrue(route.viaVpn)
+        assertEquals("s.one + s.two", route.label)
+    }
+}
