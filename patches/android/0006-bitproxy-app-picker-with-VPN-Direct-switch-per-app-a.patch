+/** One row: an app (or group of apps sharing a uid) in one Android user. */
+private data class Row(
+    val keys: List<AppKey>, // all packages sharing this uid in this user
+    val label: String,
+    val subtitle: String,
+    val userId: Int,
+    val isSystem: Boolean,
+    val manualClone: Boolean, // added by hand; uid computed, not detected
+)
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun AppPickerScreen(navController: NavController) {
+    OverrideTopBar {
+        TopAppBar(
+            title = { Text("Apps: VPN or Direct") },
+            navigationIcon = {
+                IconButton(onClick = { navController.navigateUp() }) {
+                    Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+                }
+            },
+        )
+    }
+
+    var scan by remember { mutableStateOf<AppScan?>(null) }
+    var choices by remember { mutableStateOf(BitProxyPrefs.apps) }
+    var query by remember { mutableStateOf("") }
+    var showSystem by remember { mutableStateOf(false) }
+
+    LaunchedEffect(Unit) { scan = withContext(Dispatchers.IO) { AppResolver.scan().also { s -> s.apps.keys.forEach(s::label) } } }
+
+    fun set(keys: List<AppKey>, mode: Mode?) {
+        choices = choices.toMutableMap().apply { keys.forEach { if (mode == null) remove(it) else put(it, mode) } }
+        BitProxyPrefs.apps = choices
+    }
+
+    val scaffoldPadding = LocalScaffoldPadding.current
+    val current = scan
+    if (current == null) {
+        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
+        return
+    }
+    val allRows = remember(current, choices.keys) { buildRows(current, choices.keys) }
+    val rows = allRows.filter { row ->
+        (showSystem || !row.isSystem || row.keys.any { it in choices }) &&
+            (query.isBlank() || row.label.contains(query, true) || row.keys.any { it.packageName.contains(query, true) })
+    }.sortedWith(compareBy({ row -> row.keys.none { it in choices } }, { it.label.lowercase() }, { it.userId }))
+
+    LazyColumn(
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = androidx.compose.foundation.layout.PaddingValues(
+            top = scaffoldPadding.calculateTopPadding(),
+            bottom = scaffoldPadding.calculateBottomPadding() + 16.dp,
+        ),
+    ) {
+        item {
+            Column(Modifier.padding(horizontal = 16.dp)) {
+                OutlinedTextField(
+                    value = query,
+                    onValueChange = { query = it },
+                    label = { Text("Search apps") },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth(),
+                )
+                Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.clickable { showSystem = !showSystem }) {
+                    Checkbox(checked = showSystem, onCheckedChange = { showSystem = it })
+                    Text("Show system apps")
+                }
+                Text(
+                    "Switch on = through VPN. Off = Direct. Every app stays inside the VPN tunnel; " +
+                        "sing-box decides per app. Apps you touched are listed first." +
+                        if (!current.pmAvailable) "\nClones could not be detected here; add them with ⋮ > Add clone." else "",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(vertical = 4.dp),
+                )
+            }
+        }
+        items(rows, key = { it.keys.first().toString() }) { row ->
+            val vpn = row.keys.any { choices[it] == Mode.VPN }
+            var menu by remember { mutableStateOf(false) }
+            ListItem(
+                headlineContent = { Text(row.label, maxLines = 1, overflow = TextOverflow.Ellipsis) },
+                supportingContent = { Text(row.subtitle, maxLines = 2, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodySmall) },
+                leadingContent = { AppIcon(row.keys.first().packageName) },
+                trailingContent = {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Switch(checked = vpn, onCheckedChange = { set(row.keys, if (it) Mode.VPN else Mode.DIRECT) })
+                        Box {
+                            IconButton(onClick = { menu = true }) { Icon(Icons.Outlined.MoreVert, contentDescription = "More") }
+                            DropdownMenu(expanded = menu, onDismissRequest = { menu = false }) {
+                                if (row.userId == current.currentUser) {
+                                    val clone = row.keys.map { AppKey(it.packageName, Uid.CLONE_USER) }
+                                    val hasClone = allRows.any { r -> r.keys.any { it in clone } }
+                                    if (!hasClone) {
+                                        DropdownMenuItem(text = { Text("Add clone (user ${Uid.CLONE_USER})") }, onClick = {
+                                            menu = false
+                                            set(clone, if (vpn) Mode.VPN else Mode.DIRECT)
+                                        })
+                                    }
+                                }
+                                if (row.keys.any { it in choices }) {
+                                    DropdownMenuItem(text = { Text(if (row.manualClone) "Remove clone" else "Forget choice") }, onClick = {
+                                        menu = false
+                                        set(row.keys, null)
+                                    })
+                                }
+                            }
+                        }
+                    }
+                },
+            )
+        }
+    }
+}
+
+private fun buildRows(scan: AppScan, chosen: Set<AppKey>): List<Row> {
+    val rows = mutableListOf<Row>()
+    // Group every visible (package, user) by uid so shared-uid apps are one row.
+    val byUid = scan.uids.entries.groupBy({ it.value }, { it.key })
+    for ((uid, keys) in byUid) {
+        val sorted = keys.sortedBy { it.packageName }
+        // Only apps that exist for the current user have labels/icons; skip pure system uids without apps.
+        if (sorted.none { scan.apps.containsKey(it.packageName) }) continue
+        if (sorted.any { it.packageName == Application.application.packageName }) continue // never route ourselves
+        rows += row(scan, sorted, Uid.userId(uid), "uid $uid", manual = false)
+    }
+    // Manual clones (and other users) that `pm` can't see.
+    val visible = scan.uids.keys
+    for (key in chosen) {
+        if (key in visible || key.userId == scan.currentUser) continue
+        if (!scan.apps.containsKey(key.packageName)) continue
+        rows += row(scan, listOf(key), key.userId, "added by hand", manual = true)
+    }
+    return rows
+}
+
+private fun row(scan: AppScan, keys: List<AppKey>, userId: Int, detail: String, manual: Boolean): Row {
+    val names = keys.map { scan.label(it.packageName) }.distinct()
+    return Row(
+        keys = keys,
+        label = names.joinToString(" + ") + Uid.userLabel(userId),
+        subtitle = keys.joinToString(", ") { it.packageName } + " · " + detail,
+        userId = userId,
+        isSystem = keys.all { (scan.apps[it.packageName]?.flags ?: 0) and android.content.pm.ApplicationInfo.FLAG_SYSTEM != 0 },
+        manualClone = manual,
+    )
+}
+
+private val iconCache = HashMap<String, ImageBitmap?>()
+
+@Composable
+private fun AppIcon(packageName: String) {
+    var icon by remember(packageName) { mutableStateOf(iconCache[packageName]) }
+    LaunchedEffect(packageName) {
+        if (icon == null && !iconCache.containsKey(packageName)) {
+            icon = withContext(Dispatchers.IO) {
+                runCatching {
+                    val d = Application.packageManager.getApplicationIcon(packageName)
+                    val bmp = Bitmap.createBitmap(96, 96, Bitmap.Config.ARGB_8888)
+                    d.setBounds(0, 0, 96, 96)
+                    d.draw(Canvas(bmp))
+                    bmp.asImageBitmap()
+                }.getOrNull()
+            }.also { iconCache[packageName] = it }
+        }
+    }
+    val bmp = icon
+    if (bmp != null) Image(bmp, contentDescription = null, modifier = Modifier.size(40.dp)) else Box(Modifier.size(40.dp))
+}
