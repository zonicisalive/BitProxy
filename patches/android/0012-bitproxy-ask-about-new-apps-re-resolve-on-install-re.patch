diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/AppWatcher.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/AppWatcher.kt
new file mode 100644
index 0000000..76a27e5
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/AppWatcher.kt
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.Manifest
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Process
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import androidx.core.content.ContextCompat
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.R
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.AppKey
+import io.nekohasekai.sfa.bitproxy.BitProxyPrefs.Mode
+import io.nekohasekai.sfa.database.Settings
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+/**
+ * While the VPN runs: re-resolve uids when apps are installed/removed, and ask about new apps
+ * with a notification ("Route <app> through VPN or Direct?").
+ */
+object AppWatcher {
+    private const val TAG = "BitProxy"
+    private const val CHANNEL = "bitproxy_new_apps"
+    private const val ACTION_CHOOSE = "io.nekohasekai.sfa.bitproxy.CHOOSE"
+    private const val EXTRA_PACKAGE = "package"
+    private const val EXTRA_MODE = "mode"
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var registered = false
+    private var pendingApply: Job? = null
+
+    private val packageReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            val pkg = intent.data?.schemeSpecificPart ?: return
+            val replacing = intent.getBooleanExtra(Intent.EXTRA_REPLACING, false)
+            if (replacing) return // app update: uid unchanged
+            val key = AppKey(pkg, Uid.userId(Process.myUid()))
+            val chosen = BitProxyPrefs.apps.keys.any { it.packageName == pkg }
+            when (intent.action) {
+                Intent.ACTION_PACKAGE_ADDED -> if (chosen) reapply("reinstalled $pkg") else scope.launch { ask(key) }
+                Intent.ACTION_PACKAGE_REMOVED -> {
+                    notificationManager().cancel(pkg, 0)
+                    if (chosen) reapply("removed $pkg") // rule dropped, saved choice kept
+                }
+            }
+        }
+    }
+
+    private val actionReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context, intent: Intent) {
+            val pkg = intent.getStringExtra(EXTRA_PACKAGE) ?: return
+            val mode = runCatching { Mode.valueOf(intent.getStringExtra(EXTRA_MODE)!!) }.getOrNull() ?: return
+            notificationManager().cancel(pkg, 0)
+            BitProxyPrefs.apps = BitProxyPrefs.apps + (AppKey(pkg, Uid.userId(Process.myUid())) to mode)
+            reapply("$pkg set to $mode")
+        }
+    }
+
+    fun start() {
+        if (registered) return
+        val ctx = Application.application
+        ContextCompat.registerReceiver(
+            ctx,
+            packageReceiver,
+            IntentFilter().apply {
+                addAction(Intent.ACTION_PACKAGE_ADDED)
+                addAction(Intent.ACTION_PACKAGE_REMOVED)
+                addDataScheme("package")
+            },
+            ContextCompat.RECEIVER_EXPORTED, // system broadcasts
+        )
+        ContextCompat.registerReceiver(ctx, actionReceiver, IntentFilter(ACTION_CHOOSE), ContextCompat.RECEIVER_NOT_EXPORTED)
+        registered = true
+    }
+
+    fun stop() {
+        if (!registered) return
+        val ctx = Application.application
+        runCatching { ctx.unregisterReceiver(packageReceiver) }
+        runCatching { ctx.unregisterReceiver(actionReceiver) }
+        registered = false
+        pendingApply?.cancel()
+    }
+
+    /** Several installs in a row cause one apply. Only touches the BitProxy profile. */
+    private fun reapply(reason: String) {
+        pendingApply?.cancel()
+        pendingApply = scope.launch {
+            delay(3000)
+            if (Settings.selectedProfile != BitProxyPrefs.profileId) return@launch
+            Log.i(TAG, "re-applying: $reason")
+            BitProxyApplier.apply(serviceRunning = true)
+        }
+    }
+
+    private fun ask(key: AppKey) {
+        val pm = Application.packageManager
+        val info = runCatching { pm.getApplicationInfo(key.packageName, 0) }.getOrNull() ?: return
+        if (info.flags and ApplicationInfo.FLAG_SYSTEM != 0) return
+        val usesInternet = runCatching {
+            pm.checkPermission(Manifest.permission.INTERNET, key.packageName) == PackageManager.PERMISSION_GRANTED
+        }.getOrDefault(true)
+        if (!usesInternet) return
+        val label = runCatching { info.loadLabel(pm).toString() }.getOrDefault(key.packageName)
+
+        val nm = notificationManager()
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            nm.createNotificationChannel(NotificationChannel(CHANNEL, "New apps", NotificationManager.IMPORTANCE_DEFAULT))
+        }
+        fun action(mode: Mode, requestCode: Int) = PendingIntent.getBroadcast(
+            Application.application,
+            key.packageName.hashCode() * 2 + requestCode,
+            Intent(ACTION_CHOOSE).setPackage(Application.application.packageName)
+                .putExtra(EXTRA_PACKAGE, key.packageName).putExtra(EXTRA_MODE, mode.name),
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        nm.notify(
+            key.packageName,
+            0,
+            NotificationCompat.Builder(Application.application, CHANNEL)
+                .setSmallIcon(R.drawable.ic_menu)
+                .setContentTitle("New app: $label")
+                .setContentText("Route $label through VPN or Direct?")
+                .addAction(0, "VPN", action(Mode.VPN, 0))
+                .addAction(0, "Direct", action(Mode.DIRECT, 1))
+                .setAutoCancel(true)
+                .build(),
+        )
+    }
+
+    private fun notificationManager() = Application.notification
+}
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
index 1267be4..20bda41 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
@@ -78,10 +78,12 @@ object BitProxyServiceHooks {
     /** The VPN is up: start watching the underlying network for IPv6 changes. */
     fun onStarted() {
         Ipv6Watcher.start()
+        AppWatcher.start()
     }
 
     fun onStopped() {
         Ipv6Watcher.stop()
+        AppWatcher.stop()
     }
 
     /** The service stopped with an error: tell the user even if the UI is closed. */
