@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+/** Removes WireGuard private and preshared keys from anything that leaves the app. */
+object Redactor {
+    private const val MASK = "[REDACTED]"
+    private val JSON_KEY = Regex(""""(private_key|pre_shared_key)"\s*:\s*"[^"]*"""")
+    private val CONF_KEY = Regex("""(?im)^(\s*(?:PrivateKey|PresharedKey)\s*=\s*).*$""")
+
+    /** [secrets]: known key values (from the imported configs), masked wherever they appear. */
+    fun redact(text: String, secrets: Collection<String> = emptyList()): String {
+        var out = JSON_KEY.replace(text) { """"${it.groupValues[1]}": "$MASK"""" }
+        out = CONF_KEY.replace(out) { it.groupValues[1] + MASK }
+        for (s in secrets) if (s.length >= 16) out = out.replace(s, MASK)
+        return out
+    }
+}
