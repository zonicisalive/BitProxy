+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RedactorTest {
+    private val priv = "9Jg/mew3whp1WZOPQ8we6FK3XYfseOiCbCkxhdwejB4=" // dummy
+    private val psk = "zeEvfqDziNiGxua0xnO/9M8HcuFjVVikxPegqgHmgEY=" // dummy
+    private val pub = "x0g1ZPy9jFo8AWzgEeL45vKt+Wp2NA4vSZkoId4U9fo=" // dummy, public: may stay
+
+    @Test fun jsonConfig() {
+        val json = """{"private_key": "$priv", "peers":[{"public_key":"$pub","pre_shared_key" : "$psk"}]}"""
+        val out = Redactor.redact(json)
+        assertFalse(priv in out)
+        assertFalse(psk in out)
+        assertTrue(pub in out)
+        assertTrue(""""private_key": "[REDACTED]"""" in out)
+    }
+
+    @Test fun confFile() {
+        val out = Redactor.redact("[Interface]\nPrivateKey = $priv\n[Peer]\npresharedkey=$psk\nPublicKey = $pub\n")
+        assertFalse(priv in out)
+        assertFalse(psk in out)
+        assertTrue("PrivateKey = [REDACTED]" in out)
+        assertTrue(pub in out)
+    }
+
+    @Test fun knownSecretsAnywhere() {
+        assertEquals("log: key=[REDACTED] end", Redactor.redact("log: key=$priv end", listOf(priv)))
+    }
+}
