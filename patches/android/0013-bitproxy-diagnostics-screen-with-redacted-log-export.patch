+/** Everything worth knowing when something doesn't work. Never contains key material. */
+private suspend fun collectReport(serviceStatus: Status): String = withContext(Dispatchers.IO) {
+    val lines = mutableListOf<Pair<String, String>>()
+    fun add(k: String, v: Any?) = lines.add(k to (v?.toString() ?: "-"))
+
+    add("VPN", serviceStatus.name)
+    val ao = BitProxyServiceHooks.alwaysOn(serviceStatus == Status.Started)
+    add("Always-on / Block", ao?.let { "${if (it.alwaysOn) "on" else "off"} / ${if (it.lockdown) "on" else "off"}" } ?: "unknown (Android 10+, VPN must have run)")
+
+    val profile = ProfileManager.get(BitProxyPrefs.profileId)
+    add("BitProxy profile", profile?.let { "${it.name} (id ${it.id})" } ?: "not created yet (tap Apply)")
+    add("Selected profile is BitProxy", Settings.selectedProfile == BitProxyPrefs.profileId)
+    val config = profile?.let { runCatching { Json.parseToJsonElement(File(it.typed.path).readText()) as JsonObject }.getOrNull() }
+    if (config != null) {
+        val tun = config["inbounds"]?.jsonArray?.firstOrNull()?.jsonObject
+        val tunAddrs = tun?.get("address")?.jsonArray?.map { it.jsonPrimitive.content }.orEmpty()
+        add("Tunnel address", tunAddrs.joinToString())
+        add(
+            "Phone DNS address",
+            tunAddrs.firstOrNull()?.substringBefore('/')?.let { ip ->
+                ip.split('.').takeIf { it.size == 4 }?.let { p -> "${p[0]}.${p[1]}.${p[2]}.${p[3].toInt() + 1}" }
+            },
+        )
+        val vpn = config["outbounds"]?.jsonArray?.firstOrNull()?.jsonObject
+        add("Server group", "${vpn?.get("type")?.jsonPrimitive?.content}: ${vpn?.get("outbounds")?.jsonArray?.joinToString { it.jsonPrimitive.content }}")
+        add("Default server", vpn?.get("default")?.jsonPrimitive?.content ?: "(auto-pick)")
+        val dns = config["dns"]?.jsonObject
+        add("Remote DNS", dns?.get("servers")?.jsonArray?.firstOrNull { it.jsonObject["tag"]?.jsonPrimitive?.content == "remote" }?.jsonObject?.get("server")?.jsonPrimitive?.content)
+        add("DNS strategy", dns?.get("strategy")?.jsonPrimitive?.content)
+        add("Per-app rules", config["route"]?.jsonObject?.get("rules")?.jsonArray?.count { "user_id" in it.jsonObject })
+    }
+    add("IPv6 mode (applied)", BitProxyPrefs.appliedIpv6)
+    add("Underlying network has IPv6", Ipv6Watcher.hasIpv6 ?: "not watching (VPN off)")
+    add("Saved app choices", BitProxyPrefs.apps.size)
+    val scan = AppResolver.scan()
+    add("Clone detection (pm -U)", if (scan.pmAvailable) "works" else "unavailable, use manual clones")
+    add("Clones / other users seen", scan.uids.keys.filter { it.userId != scan.currentUser }.map { it.userId }.distinct().sorted().ifEmpty { listOf("none") }.joinToString())
+    add("Servers imported", BitProxyStore.servers().joinToString { it.tag }.ifEmpty { "none" })
+    add("Upstream per-app proxy", if (Settings.perAppProxyEnabled) "ON (should be off)" else "off")
+    add("Last Apply", BitProxyPrefs.lastApply)
+    add("App", "${BuildConfig.APPLICATION_ID} ${BuildConfig.VERSION_NAME}")
+    add("sing-box", runCatching { Libbox.version() }.getOrNull())
+    add("Android", "${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT}), ${Build.MANUFACTURER} ${Build.MODEL}")
+    lines.joinToString("\n") { (k, v) -> "$k: $v" }
+}
+
+/** Report + applied config + this app's recent logcat, with every private/preshared key masked. */
+private suspend fun exportLog(context: Context, report: String): File = withContext(Dispatchers.IO) {
+    val secrets = BitProxyStore.servers().flatMap { s -> listOf(s.conf.privateKey) + s.conf.peers.mapNotNull { it.presharedKey } }
+    val config = ProfileManager.get(BitProxyPrefs.profileId)?.let { runCatching { File(it.typed.path).readText() }.getOrNull() } ?: "(none)"
+    val logcat = runCatching {
+        val p = ProcessBuilder("logcat", "-d", "-v", "time", "--pid=${Process.myPid()}", "-t", "2000").redirectErrorStream(true).start()
+        val text = p.inputStream.bufferedReader().readText()
+        p.waitFor(10, TimeUnit.SECONDS)
+        text
+    }.getOrElse { "logcat failed: ${it.message}" }
+    val text = "== BitProxy diagnostics ==\n$report\n\n== Applied config ==\n$config\n\n== Log ==\n$logcat"
+    File(context.cacheDir, "bitproxy-diagnostics.txt").apply { writeText(Redactor.redact(text, secrets)) }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun DiagnosticsScreen(navController: NavController, serviceStatus: Status) {
+    OverrideTopBar {
+        TopAppBar(
+            title = { Text("Diagnostics") },
+            navigationIcon = {
+                IconButton(onClick = { navController.navigateUp() }) {
+                    Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+                }
+            },
+        )
+    }
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var report by remember { mutableStateOf("Collecting…") }
+    LaunchedEffect(serviceStatus) { report = collectReport(serviceStatus) }
+
+    val scaffoldPadding = LocalScaffoldPadding.current
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surface)
+            .verticalScroll(rememberScrollState())
+            .padding(top = scaffoldPadding.calculateTopPadding() + 8.dp, bottom = scaffoldPadding.calculateBottomPadding() + 8.dp)
+            .padding(horizontal = 16.dp),
+    ) {
+        Card(
+            modifier = Modifier.fillMaxWidth(),
+            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+        ) {
+            SelectionContainer {
+                Text(report, fontFamily = FontFamily.Monospace, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(16.dp))
+            }
+        }
+        Button(
+            modifier = Modifier.padding(vertical = 16.dp),
+            onClick = {
+                scope.launch {
+                    val file = exportLog(context, report)
+                    val uri = FileProvider.getUriForFile(context, "${context.packageName}.cache", file)
+                    val send = Intent(Intent.ACTION_SEND).setType("text/plain").putExtra(Intent.EXTRA_STREAM, uri)
+                        .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                    context.startActivity(Intent.createChooser(send, "Export diagnostics"))
+                }
+            },
+        ) {
+            Icon(Icons.Outlined.Share, contentDescription = null)
+            Text("  Export log (keys removed)")
+        }
+    }
+}
