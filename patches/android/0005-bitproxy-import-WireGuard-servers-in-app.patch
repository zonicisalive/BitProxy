@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bitproxy.config.ConfigGenerator
+import io.nekohasekai.sfa.bitproxy.wireguard.ParseResult
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConf
+import io.nekohasekai.sfa.bitproxy.wireguard.WireGuardConfParser
+import java.io.File
+
+/** An imported server: the stored file plus its parse result. */
+data class StoredServer(val file: File, val tag: String, val conf: WireGuardConf)
+
+/**
+ * Imported WireGuard configs live in private app storage (filesDir/bitproxy/servers),
+ * never on shared storage. All functions do file I/O: call them off the main thread.
+ */
+object BitProxyStore {
+    private const val MAX_CONF_BYTES = 64 * 1024
+
+    private val context: Context get() = Application.application
+    val dir: File get() = File(context.filesDir, "bitproxy").apply { mkdirs() }
+    private val serversDir: File get() = File(dir, "servers").apply { mkdirs() }
+
+    /** Servers sorted by file name (like conf-merger.py), with their endpoint tags. */
+    fun servers(): List<StoredServer> {
+        val parsed = serversDir.listFiles().orEmpty().filter { it.isFile }.sortedBy { it.name }.mapNotNull { f ->
+            (WireGuardConfParser.parse(f.readText(), f.name) as? ParseResult.Ok)?.let { f to it.conf }
+        }
+        val tags = ConfigGenerator.endpointTags(parsed.map { it.second })
+        return parsed.mapIndexed { i, (f, conf) -> StoredServer(f, tags[i], conf) }
+    }
+
+    /**
+     * Imports one .conf from a document URI. A file with the same name is replaced,
+     * so re-importing an updated export just works. Returns a message for the user.
+     */
+    fun import(uri: Uri): ImportResult {
+        val name = displayName(uri) ?: uri.lastPathSegment?.substringAfterLast('/') ?: "server.conf"
+        val bytes = try {
+            context.contentResolver.openInputStream(uri)?.use { it.readNBytesCompat(MAX_CONF_BYTES + 1) }
+        } catch (e: Exception) {
+            return ImportResult(false, "$name: could not be opened (${e.javaClass.simpleName})")
+        } ?: return ImportResult(false, "$name: could not be opened")
+        if (bytes.size > MAX_CONF_BYTES) return ImportResult(false, "$name: too large for a WireGuard config")
+
+        return when (val r = WireGuardConfParser.parse(bytes.toString(Charsets.UTF_8), name)) {
+            is ParseResult.Error -> ImportResult(false, r.message)
+            is ParseResult.Ok -> {
+                val target = File(serversDir, safeFileName(r.conf.name) + ".conf")
+                val tmp = File(serversDir, target.name + ".tmp")
+                tmp.writeBytes(bytes)
+                if (!tmp.renameTo(target)) {
+                    tmp.delete()
+                    return ImportResult(false, "$name: could not be saved")
+                }
+                ImportResult(true, (listOf("Imported ${r.conf.name}") + r.warnings).joinToString("\n"))
+            }
+        }
+    }
+
+    fun delete(server: StoredServer) {
+        server.file.delete()
+        if (BitProxyPrefs.selectedServer == server.tag) BitProxyPrefs.selectedServer = null
+    }
+
+    private fun displayName(uri: Uri): String? = try {
+        context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { c ->
+            if (c.moveToFirst()) c.getString(0) else null
+        }
+    } catch (_: Exception) {
+        null
+    }
+
+    /** Keeps the name readable (it becomes the endpoint tag) but safe as a file name. */
+    private fun safeFileName(name: String) = name.replace(Regex("""[/\\:*?"<>|\u0000-\u001f]"""), "_").trim().trimStart('.').ifEmpty { "server" }.take(100)
+
+    private fun java.io.InputStream.readNBytesCompat(limit: Int): ByteArray {
+        val out = java.io.ByteArrayOutputStream()
+        val buf = ByteArray(8192)
+        while (out.size() < limit) {
+            val n = read(buf, 0, minOf(buf.size, limit - out.size()))
+            if (n < 0) break
+            out.write(buf, 0, n)
+        }
+        return out.toByteArray()
+    }
+}
+
+data class ImportResult(val ok: Boolean, val message: String)
