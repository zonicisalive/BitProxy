+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.content.Context
+import androidx.core.content.edit
+import io.nekohasekai.sfa.Application
+
+/**
+ * BitProxy choices. Apps are keyed by package name + Android user id, never by raw uid,
+ * so a reinstalled app (new uid) keeps its switch.
+ */
+object BitProxyPrefs {
+    private val prefs by lazy { Application.application.getSharedPreferences("bitproxy", Context.MODE_PRIVATE) }
+
+    data class AppKey(val packageName: String, val userId: Int) {
+        override fun toString() = "$packageName:$userId"
+
+        companion object {
+            fun parse(s: String): AppKey? {
+                val i = s.lastIndexOf(':')
+                return s.substring(i + 1).toIntOrNull()?.takeIf { i > 0 }?.let { AppKey(s.substring(0, i), it) }
+            }
+        }
+    }
+
+    enum class Mode { VPN, DIRECT }
+
+    var selectedServer: String?
+        get() = prefs.getString("selected_server", null)
+        set(value) = prefs.edit { putString("selected_server", value) }
+
+    /** Apps that have a switch, with their mode. Apps not in here are not routed specially (final = Direct). */
+    var apps: Map<AppKey, Mode>
+        get() = prefs.getStringSet("apps", emptySet())!!.mapNotNull { entry ->
+            val key = AppKey.parse(entry.substringBeforeLast('='))
+            val mode = runCatching { Mode.valueOf(entry.substringAfterLast('=')) }.getOrNull()
+            if (key != null && mode != null) key to mode else null
+        }.toMap()
+        set(value) = prefs.edit { putStringSet("apps", value.map { (k, m) -> "$k=${m.name}" }.toSet()) }
+
+    fun setApp(key: AppKey, mode: Mode?) {
+        apps = apps.toMutableMap().apply { if (mode == null) remove(key) else put(key, mode) }
+    }
+
+    /** Id of the upstream profile that BitProxy writes its generated config into. */
+    var profileId: Long
+        get() = prefs.getLong("profile_id", -1)
+        set(value) = prefs.edit { putLong("profile_id", value) }
+}
