+
+/** Hook: called once from the upstream NavHost to register all BitProxy screens. */
+// Routes must start with "settings/": MainActivity sends unknown root routes back to the dashboard.
+fun NavGraphBuilder.bitProxyRoutes(navController: NavController, serviceStatus: Status) {
+    val enter: AnimatedContentTransitionScope<*>.() -> androidx.compose.animation.EnterTransition =
+        { slideIntoContainer(AnimatedContentTransitionScope.SlideDirection.Left, tween(300)) }
+    val exit: AnimatedContentTransitionScope<*>.() -> androidx.compose.animation.ExitTransition =
+        { slideOutOfContainer(AnimatedContentTransitionScope.SlideDirection.Right, tween(300)) }
+    composable("settings/bitproxy", enterTransition = enter, popExitTransition = exit) {
+        BitProxyScreen(navController, serviceStatus)
+    }
+}
+
+/** Hook: entry card at the top of the upstream Settings screen. */
+@Composable
+fun BitProxySettingsEntry(navController: NavController) {
+    Card(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        ListItem(
+            headlineContent = { Text("BitProxy", style = MaterialTheme.typography.bodyLarge) },
+            supportingContent = { Text("WireGuard servers and per-app VPN / Direct") },
+            leadingContent = { Icon(Icons.Outlined.Shield, contentDescription = null, tint = MaterialTheme.colorScheme.primary) },
+            modifier = Modifier.clickable { navController.navigate("settings/bitproxy") },
+            colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+        )
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun BitProxyScreen(navController: NavController, serviceStatus: Status) {
+    OverrideTopBar {
+        TopAppBar(
+            title = { Text("BitProxy") },
+            navigationIcon = {
+                IconButton(onClick = { navController.navigateUp() }) {
+                    Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+                }
+            },
+        )
+    }
+
+    val scope = rememberCoroutineScope()
+    var servers by remember { mutableStateOf<List<StoredServer>>(emptyList()) }
+    var selected by remember { mutableStateOf(BitProxyPrefs.selectedServer) }
+    var reload by remember { mutableIntStateOf(0) }
+    var message by remember { mutableStateOf<String?>(null) }
+    var confirmDelete by remember { mutableStateOf<StoredServer?>(null) }
+
+    LaunchedEffect(reload) {
+        servers = withContext(Dispatchers.IO) { BitProxyStore.servers() }
+        if (servers.none { it.tag == selected }) selected = servers.firstOrNull()?.tag
+    }
+
+    val importLauncher = rememberLauncherForActivityResult(ActivityResultContracts.OpenMultipleDocuments()) { uris ->
+        if (uris.isEmpty()) return@rememberLauncherForActivityResult
+        scope.launch {
+            val results = withContext(Dispatchers.IO) { uris.map(BitProxyStore::import) }
+            message = results.joinToString("\n\n") { (if (it.ok) "✓ " else "✗ ") + it.message }
+            reload++
+        }
+    }
+
+    val scaffoldPadding = LocalScaffoldPadding.current
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(MaterialTheme.colorScheme.surface)
+            .verticalScroll(rememberScrollState())
+            .padding(top = scaffoldPadding.calculateTopPadding() + 8.dp, bottom = scaffoldPadding.calculateBottomPadding() + 8.dp),
+    ) {
+        Card(
+            modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+            colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+        ) {
+            Text("Servers", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(16.dp, 16.dp, 16.dp, 4.dp))
+            if (servers.isEmpty()) {
+                Text(
+                    "No servers yet. Import WireGuard .conf files (for example from Proton VPN).",
+                    style = MaterialTheme.typography.bodyMedium,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+            val selectedAddress = servers.firstOrNull { it.tag == selected }?.conf?.ipv4Address?.address
+            for (server in servers) {
+                val sameAddress = server.conf.ipv4Address.address == selectedAddress
+                ListItem(
+                    headlineContent = { Text(server.tag) },
+                    supportingContent = {
+                        val peer = server.conf.peers.first()
+                        Text(
+                            "${peer.host}:${peer.port} · tunnel ${server.conf.ipv4Address.address}" +
+                                if (!sameAddress) "\nDifferent tunnel address: selecting it switches the whole config" else "",
+                        )
+                    },
+                    leadingContent = {
+                        RadioButton(selected = server.tag == selected, onClick = {
+                            selected = server.tag
+                            BitProxyPrefs.selectedServer = server.tag
+                        })
+                    },
+                    trailingContent = {
+                        IconButton(onClick = { confirmDelete = server }) { Icon(Icons.Outlined.Delete, contentDescription = "Delete") }
+                    },
+                    modifier = Modifier.clickable {
+                        selected = server.tag
+                        BitProxyPrefs.selectedServer = server.tag
+                    },
+                    colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+                )
+            }
+            FilledTonalButton(
+                onClick = { importLauncher.launch(arrayOf("*/*")) },
+                modifier = Modifier.padding(16.dp),
+            ) {
+                Icon(Icons.Outlined.FileOpen, contentDescription = null)
+                Text("  Import .conf files")
+            }
+        }
+    }
+
+    message?.let {
+        AlertDialog(
+            onDismissRequest = { message = null },
+            title = { Text("Import") },
+            text = { Text(it) },
+            confirmButton = { TextButton(onClick = { message = null }) { Text("OK") } },
+        )
+    }
+    confirmDelete?.let { server ->
+        AlertDialog(
+            onDismissRequest = { confirmDelete = null },
+            title = { Text("Delete ${server.tag}?") },
+            text = { Text("The imported config file is removed from the app.") },
+            confirmButton = {
+                TextButton(onClick = {
+                    confirmDelete = null
+                    scope.launch {
+                        withContext(Dispatchers.IO) { BitProxyStore.delete(server) }
+                        reload++
+                    }
+                }) { Text("Delete") }
+            },
+            dismissButton = { TextButton(onClick = { confirmDelete = null }) { Text("Cancel") } },
+        )
+    }
+}
