+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/ui/TrustedWifiCard.kt
@@ -73,7 +73,7 @@ fun TrustedWifiCard() {
         Column(Modifier.padding(16.dp)) {
             Text("Trusted Wi-Fi", style = MaterialTheme.typography.titleMedium)
             Text(
-                "On these networks every app goes Direct (blocked apps stay blocked). sing-box checks the " +
+                "On these networks every app goes Direct (blocked apps stay blocked). BitProxy checks the " +
                     "network live, no reload when you join or leave. Needs location \"Allow all the time\" " +
                     "because Android hides Wi-Fi names otherwise.",
                 style = MaterialTheme.typography.bodySmall,
