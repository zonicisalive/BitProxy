+
+/** Hook: top of the dashboard. "Always-on ✓ · Block ✓" or a warning with a shortcut to VPN settings. */
+@Composable
+fun BitProxyStatusBadge(serviceStatus: Status) {
+    val context = LocalContext.current
+    var state by remember { mutableStateOf(BitProxyServiceHooks.alwaysOn(serviceStatus == Status.Started)) }
+    LaunchedEffect(serviceStatus) {
+        while (true) { // the user may change Always-on in system settings while we are open
+            state = BitProxyServiceHooks.alwaysOn(serviceStatus == Status.Started)
+            delay(5000)
+        }
+    }
+    val s = state ?: return // API < 29 or never started: nothing reliable to show
+    val ok = s.alwaysOn && s.lockdown
+    val running = serviceStatus == Status.Started
+    val title = "Always-on ${if (s.alwaysOn) "✓" else "✗"} · Block ${if (s.lockdown) "✓" else "✗"}"
+    val detail = when {
+        !running -> "Last seen while the VPN was running."
+        ok -> "Apps can't reach the internet outside the VPN."
+        !s.alwaysOn -> "The VPN won't restart by itself. Tap to open VPN settings."
+        else -> "Apps get internet directly while the VPN is down. Tap to turn on \"Block connections without VPN\"."
+    }
+    Card(
+        modifier = Modifier.fillMaxWidth().clickable { runCatching { context.startActivity(Intent(Settings.ACTION_VPN_SETTINGS)) } },
+        colors = CardDefaults.cardColors(
+            containerColor = if (ok) MaterialTheme.colorScheme.secondaryContainer else MaterialTheme.colorScheme.errorContainer,
+        ),
+    ) {
+        ListItem(
+            headlineContent = { Text(title) },
+            supportingContent = { Text(detail) },
+            leadingContent = { Icon(if (ok) Icons.Outlined.GppGood else Icons.Outlined.GppMaybe, contentDescription = null) },
+            colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+        )
+    }
+}
+
+/** Hook: dashboard level. Confirms stopping while lockdown is on. */
+@Composable
+fun BitProxyStopDialog() {
+    val stop = BitProxyServiceHooks.pendingStop.value ?: return
+    AlertDialog(
+        onDismissRequest = { BitProxyServiceHooks.pendingStop.value = null },
+        title = { Text("Stop the VPN?") },
+        text = { Text("\"Block connections without VPN\" is on. This cuts internet for all apps until the VPN runs again.") },
+        confirmButton = {
+            TextButton(onClick = {
+                BitProxyServiceHooks.pendingStop.value = null
+                stop()
+            }) { Text("Stop") }
+        },
+        dismissButton = { TextButton(onClick = { BitProxyServiceHooks.pendingStop.value = null }) { Text("Cancel") } },
+    )
+}
