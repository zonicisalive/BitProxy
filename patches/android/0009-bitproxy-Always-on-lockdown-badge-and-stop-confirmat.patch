@@ -54,4 +54,16 @@ object BitProxyPrefs {
         }
         prefs.edit { putString("last_apply", text) }
     }
+
+    var lastAlwaysOn: BitProxyServiceHooks.AlwaysOn?
+        get() = if (!prefs.contains("always_on")) null else BitProxyServiceHooks.AlwaysOn(prefs.getBoolean("always_on", false), prefs.getBoolean("lockdown", false))
+        set(value) = prefs.edit {
+            if (value == null) {
+                remove("always_on")
+                remove("lockdown")
+            } else {
+                putBoolean("always_on", value.alwaysOn)
+                putBoolean("lockdown", value.lockdown)
+            }
+        }
 }
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
index 382f1a2..65dbd5d 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
@@ -20,12 +20,35 @@ object BitProxyServiceHooks {
     private const val TAG = "BitProxy"
     const val CHANNEL = "bitproxy_alerts"
     private const val FAILED_ID = 0xB17
+    private var vpnService: java.lang.ref.WeakReference<android.net.VpnService>? = null
+
+    data class AlwaysOn(val alwaysOn: Boolean, val lockdown: Boolean)
+
+    /**
+     * Always-on / "Block connections without VPN" state. Android only tells the VPN service
+     * itself (API 29+), so this is live while the service exists and the last known value otherwise.
+     */
+    fun alwaysOn(serviceRunning: Boolean): AlwaysOn? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) return null
+        // A stopped service reports false for both, so only trust it while it runs.
+        val live = vpnService?.get()?.takeIf { serviceRunning }?.let { runCatching { AlwaysOn(it.isAlwaysOn, it.isLockdownEnabled) }.getOrNull() }
+        if (live != null && live != BitProxyPrefs.lastAlwaysOn) BitProxyPrefs.lastAlwaysOn = live
+        return live ?: BitProxyPrefs.lastAlwaysOn
+    }
+
+    /** Stop requests from the UI while lockdown is on need a confirmation; [BitProxyStopDialog] shows it. */
+    val pendingStop = androidx.compose.runtime.mutableStateOf<(() -> Unit)?>(null)
+
+    fun confirmStop(stop: () -> Unit) {
+        if (alwaysOn(serviceRunning = true)?.lockdown == true) pendingStop.value = stop else stop()
+    }
 
     /**
      * Before the service reads the selected profile. When the system starts us (Always-on,
      * boot, restart) and no usable profile is selected, fall back to the BitProxy profile.
      */
-    suspend fun beforeStart() {
+    suspend fun beforeStart(service: android.app.Service) {
+        (service as? android.net.VpnService)?.let { vpnService = java.lang.ref.WeakReference(it) }
         try {
             val selected = Settings.selectedProfile
             if (selected != -1L && ProfileManager.get(selected) != null) return
