+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+import androidx.core.app.NotificationCompat
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.R
+import io.nekohasekai.sfa.compose.MainActivity
+import io.nekohasekai.sfa.constant.Alert
+import io.nekohasekai.sfa.database.ProfileManager
+import io.nekohasekai.sfa.database.Settings
+
+/** Small entry points called from upstream BoxService (one line each). */
+object BitProxyServiceHooks {
+    private const val TAG = "BitProxy"
+    const val CHANNEL = "bitproxy_alerts"
+    private const val FAILED_ID = 0xB17
+
+    /**
+     * Before the service reads the selected profile. When the system starts us (Always-on,
+     * boot, restart) and no usable profile is selected, fall back to the BitProxy profile.
+     */
+    suspend fun beforeStart() {
+        try {
+            val selected = Settings.selectedProfile
+            if (selected != -1L && ProfileManager.get(selected) != null) return
+            val own = ProfileManager.get(BitProxyPrefs.profileId) ?: return
+            Log.i(TAG, "no usable profile selected ($selected); starting ${own.name}")
+            Settings.selectedProfile = own.id
+        } catch (e: Exception) {
+            Log.w(TAG, "beforeStart", e)
+        }
+    }
+
+    /** The service stopped with an error: tell the user even if the UI is closed. */
+    fun onStartFailed(type: Alert, message: String?) {
+        try {
+            val nm = Application.notification
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                nm.createNotificationChannel(NotificationChannel(CHANNEL, "BitProxy alerts", NotificationManager.IMPORTANCE_HIGH))
+            }
+            val text = when (type) {
+                Alert.EmptyConfiguration -> "No profile to start. Open BitProxy and tap Apply."
+                Alert.RequestVPNPermission -> "VPN permission missing. Open the app and start the VPN once."
+                else -> message?.takeIf { it.isNotBlank() } ?: type.name
+            }
+            val open = PendingIntent.getActivity(
+                Application.application,
+                0,
+                Intent(Application.application, MainActivity::class.java),
+                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+            )
+            nm.notify(
+                FAILED_ID,
+                NotificationCompat.Builder(Application.application, CHANNEL)
+                    .setSmallIcon(R.drawable.ic_menu)
+                    .setContentTitle("VPN failed to start")
+                    .setContentText(text)
+                    .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+                    .setContentIntent(open)
+                    .setAutoCancel(true)
+                    .build(),
+            )
+            Log.w(TAG, "start failed: $type $message")
+        } catch (e: Exception) {
+            Log.w(TAG, "onStartFailed", e)
+        }
+    }
+}
