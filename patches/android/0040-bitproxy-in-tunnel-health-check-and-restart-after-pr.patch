+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import android.os.Build
+import android.os.PowerManager
+import io.nekohasekai.libbox.Libbox
+import io.nekohasekai.libbox.STUNTestHandler
+import io.nekohasekai.libbox.STUNTestProgress
+import io.nekohasekai.libbox.STUNTestResult
+import io.nekohasekai.sfa.Application
+import io.nekohasekai.sfa.bitproxy.config.ConfigGenerator
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+
+/**
+ * "Connected" isn't proof that traffic flows (overnight: VPN on, no internet). While a network is
+ * up, send a small UDP request (STUN) through the VPN outbound every few minutes; after two
+ * failures in a row, rebuild sing-box. Recoveries back off (3 → 30 min) so a dead server can't
+ * cause a reload loop. Same idea as Proton VPN's in-tunnel "local agent" check.
+ */
+object TunnelHealth {
+    private const val BASE_MS = 3 * 60_000L
+    private const val MAX_MS = 30 * 60_000L
+    private const val RETRY_MS = 30_000L
+    private const val PROBE_TIMEOUT_MS = 10_000L
+    private val STUN_SERVERS = listOf("stun.cloudflare.com:3478", "stun.l.google.com:19302")
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var job: Job? = null
+
+    /** Wait before the next check after [restarts] recoveries that didn't help: 3, 6, 12, 24, 30 min. */
+    fun delayAfter(restarts: Int): Long = (BASE_MS shl restarts.coerceIn(0, 4)).coerceAtMost(MAX_MS)
+
+    fun start() {
+        job?.cancel()
+        job = scope.launch {
+            var failures = 0
+            var restarts = 0
+            while (isActive) {
+                delay(if (failures > 0) RETRY_MS else delayAfter(restarts))
+                // No network: nothing to test (Ipv6Watcher handles the outage). Doze: sing-box is paused.
+                if (!Ipv6Watcher.networkUp || deviceIdle()) {
+                    failures = 0
+                    continue
+                }
+                if (probe()) {
+                    if (failures > 0 || restarts > 0) EventLog.log("tunnel check OK")
+                    failures = 0
+                    restarts = 0
+                    continue
+                }
+                failures++
+                EventLog.log("tunnel check failed ($failures/2)")
+                if (failures >= 2) {
+                    failures = 0
+                    restarts++
+                    BitProxyServiceHooks.restartVpn("no traffic through the tunnel").join()
+                }
+            }
+        }
+    }
+
+    fun stop() {
+        job?.cancel()
+        job = null
+    }
+
+    private fun deviceIdle() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.M &&
+        Application.application.getSystemService(PowerManager::class.java).isDeviceIdleMode
+
+    /** True if any STUN server answers through the VPN outbound. */
+    private suspend fun probe(): Boolean = STUN_SERVERS.any { server -> stun(server) }
+
+    private suspend fun stun(server: String): Boolean {
+        val done = CompletableDeferred<Boolean>()
+        val session = runCatching {
+            Libbox.newStandaloneCommandClient().startSTUNTest(
+                server,
+                ConfigGenerator.VPN,
+                object : STUNTestHandler {
+                    override fun onProgress(progress: STUNTestProgress) {
+                        if (progress.externalAddr.isNotEmpty()) done.complete(true)
+                    }
+
+                    override fun onResult(result: STUNTestResult) {
+                        done.complete(true)
+                    }
+
+                    override fun onError(message: String) {
+                        done.complete(false)
+                    }
+                },
+            )
+        }.getOrElse { return false }
+        return try {
+            withTimeoutOrNull(PROBE_TIMEOUT_MS) { done.await() } ?: false
+        } finally {
+            runCatching { session.close() }
+        }
+    }
+}
