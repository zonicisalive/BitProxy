+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class TunnelHealthTest {
+    @Test fun backoffDoublesUpTo30Minutes() {
+        assertEquals(listOf(3L, 6L, 12L, 24L, 30L, 30L), (0..5).map { TunnelHealth.delayAfter(it) / 60_000 })
+    }
+}
