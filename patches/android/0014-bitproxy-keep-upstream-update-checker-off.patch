From 8176dd11b9ebf228f4cc68f9a5277f27f6124a1c Mon Sep 17 00:00:00 2001
From: ZonicExists <71136987+zonicisalive@users.noreply.github.com>
Date: Fri, 25 Sep 2026 00:39:03 +0530
Subject: [PATCH 14/39] bitproxy: keep upstream update checker off

The GitHub update checker offers the official SFA APK, which has a
different app id and signing key and cannot update BitProxy. Turn it
off and mark the prompt as answered once the app has initialized.
---
 app/src/main/java/io/nekohasekai/sfa/Application.kt      | 2 +-
 .../io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt  | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/io/nekohasekai/sfa/Application.kt b/app/src/main/java/io/nekohasekai/sfa/Application.kt
index 99c843d..38b93bd 100644
--- a/app/src/main/java/io/nekohasekai/sfa/Application.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/Application.kt
@@ -69,7 +69,7 @@ class Application : Application() {
             HookStatusClient.register(this@Application)
             PrivilegeSettingsClient.register(this@Application)
             initialize(baseDir, workingDir, tempDir)
-            BitProxyServiceHooks.libboxReady.complete(Unit)
+            BitProxyServiceHooks.onAppInitialized()
             UpdateProfileWork.reconfigureUpdater()
             HookModuleUpdateNotifier.sync(this@Application)
             TaildropFiles.cleanCache()
diff --git a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
index 20bda41..eac30a3 100644
--- a/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
+++ b/app/src/main/java/io/nekohasekai/sfa/bitproxy/BitProxyServiceHooks.kt
@@ -46,6 +46,15 @@ object BitProxyServiceHooks {
     /** Completed by Application once Libbox.setup() ran (it runs async in upstream). */
     val libboxReady = kotlinx.coroutines.CompletableDeferred<Unit>()
 
+    /** Hook in Application, after upstream's async init (Libbox.setup) finished. */
+    fun onAppInitialized() {
+        // Upstream's GitHub update checker would offer the official SFA build (other app id and
+        // signing key), which can't update BitProxy. Keep it off and never ask.
+        Settings.checkUpdateEnabled = false
+        Settings.updateCheckPrompted = true
+        libboxReady.complete(Unit)
+    }
+
     /**
      * Called before the command server is created. On a cold start by the system (Always-on,
      * boot) the service can get here before Libbox.setup() set the base path; the command
-- 
