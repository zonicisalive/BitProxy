+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.net
+
+/**
+ * Literal IP address. Parsing never does DNS lookups (unlike InetAddress.getByName),
+ * so it is safe on any thread and for untrusted input.
+ * [text] keeps the original spelling so generated configs match the .conf file.
+ */
+class IpAddress private constructor(val bytes: ByteArray, val text: String) {
+    val isV4: Boolean get() = bytes.size == 4
+
+    override fun toString() = text
+
+    override fun equals(other: Any?) = other is IpAddress && bytes.contentEquals(other.bytes)
+
+    override fun hashCode() = bytes.contentHashCode()
+
+    companion object {
+        fun parse(input: String): IpAddress? {
+            val s = input.trim()
+            val bytes = if (':' in s) parseV6(s) else parseV4(s)
+            return bytes?.let { IpAddress(it, s) }
+        }
+
+        fun fromBytes(bytes: ByteArray): IpAddress {
+            require(bytes.size == 4) { "only IPv4 is formatted" }
+            return IpAddress(bytes, bytes.joinToString(".") { (it.toInt() and 0xff).toString() })
+        }
+
+        private fun parseV4(s: String): ByteArray? {
+            val parts = s.split('.')
+            if (parts.size != 4) return null
+            return ByteArray(4) { i ->
+                val p = parts[i]
+                if (p.isEmpty() || p.length > 3 || !p.all(Char::isDigit)) return null
+                if (p.length > 1 && p[0] == '0') return null // leading zeros are ambiguous (octal)
+                val v = p.toInt()
+                if (v > 255) return null
+                v.toByte()
+            }
+        }
+
+        private fun parseV6(input: String): ByteArray? {
+            if ('%' in input) return null // zone ids are not valid in configs
+            // Rewrite an embedded IPv4 tail (::ffff:1.2.3.4) as two hex groups.
+            var s = input
+            val lastColon = s.lastIndexOf(':')
+            if ('.' in s.substring(lastColon + 1)) {
+                val v4 = parseV4(s.substring(lastColon + 1)) ?: return null
+                fun word(i: Int) = ((v4[i].toInt() and 0xff) shl 8 or (v4[i + 1].toInt() and 0xff)).toString(16)
+                s = s.substring(0, lastColon + 1) + word(0) + ":" + word(2)
+            }
+            val halves = s.split("::")
+            if (halves.size > 2) return null
+            fun groups(part: String): List<Int>? {
+                if (part.isEmpty()) return emptyList()
+                return part.split(':').map { g ->
+                    if (g.isEmpty() || g.length > 4 || !g.all { it.isDigit() || it.lowercaseChar() in 'a'..'f' }) return null
+                    g.toInt(16)
+                }
+            }
+            val head = groups(halves[0]) ?: return null
+            val tail = if (halves.size == 2) groups(halves[1]) ?: return null else emptyList()
+            val words = if (halves.size == 1) {
+                head.takeIf { it.size == 8 } ?: return null
+            } else {
+                if (head.size + tail.size > 7) return null
+                head + List(8 - head.size - tail.size) { 0 } + tail
+            }
+            return ByteArray(16) { i -> (words[i / 2] shr (if (i % 2 == 0) 8 else 0)).toByte() }
+        }
+    }
+}
+
+/** Address with prefix length, e.g. "10.2.0.2/32". A bare address means a single host. */
+data class IpPrefix(val address: IpAddress, val prefixLength: Int) {
+    override fun toString() = "$address/$prefixLength"
+
+    companion object {
+        fun parse(input: String): IpPrefix? {
+            val s = input.trim()
+            val slash = s.indexOf('/')
+            val address = IpAddress.parse(if (slash < 0) s else s.substring(0, slash)) ?: return null
+            val max = if (address.isV4) 32 else 128
+            if (slash < 0) return IpPrefix(address, max)
+            val len = s.substring(slash + 1).takeIf { it.isNotEmpty() && it.all(Char::isDigit) && it.length <= 3 }?.toInt()
+            if (len == null || len > max) return null
+            return IpPrefix(address, len)
+        }
+    }
+}
