+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.wireguard
+
+import io.nekohasekai.sfa.bitproxy.net.IpAddress
+import io.nekohasekai.sfa.bitproxy.net.IpPrefix
+import kotlin.io.encoding.Base64
+import kotlin.io.encoding.ExperimentalEncodingApi
+
+data class WireGuardPeer(
+    val host: String,
+    val port: Int,
+    val publicKey: String,
+    val allowedIps: List<String>,
+    val presharedKey: String? = null,
+    val persistentKeepalive: Int? = null,
+)
+
+data class WireGuardConf(
+    /** File name without .conf / .conf.txt; the endpoint tag is derived from it. */
+    val name: String,
+    val addresses: List<IpPrefix>,
+    val privateKey: String,
+    val dns: List<IpAddress>,
+    val mtu: Int?,
+    val peers: List<WireGuardPeer>,
+) {
+    /** Always present: parse() rejects configs without an IPv4 tunnel address. */
+    val ipv4Address: IpPrefix get() = addresses.first { it.address.isV4 }
+    val ipv6Address: IpPrefix? get() = addresses.firstOrNull { !it.address.isV4 }
+    val ipv4Dns: IpAddress? get() = dns.firstOrNull { it.isV4 } ?: dns.firstOrNull()
+
+    /** Never includes key material, so it is safe for logs. */
+    override fun toString() = "WireGuardConf(name=$name, addresses=$addresses, dns=$dns, mtu=$mtu, peers=${peers.map { "${it.host}:${it.port}" }})"
+}
+
+sealed interface ParseResult {
+    data class Ok(val conf: WireGuardConf, val warnings: List<String>) : ParseResult
+
+    data class Error(val message: String) : ParseResult
+}
+
+/**
+ * Parser for wg-quick style .conf files (as exported by Proton VPN and others).
+ * Mirrors reference/conf-merger.py, plus validation so a bad file gives a clear
+ * message instead of a broken sing-box config. Never throws.
+ */
+object WireGuardConfParser {
+    private val SECTION = Regex("""^\[(\w+)]$""")
+    private val HOSTNAME = Regex("""^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*\.?$""")
+    private val BOM = Char(0xFEFF).toString()
+    private val DEFAULT_ALLOWED_IPS = listOf("0.0.0.0/0", "::/0")
+
+    fun nameFromFileName(fileName: String): String = fileName.substringAfterLast('/').replace(Regex("""\.conf(\.txt)?$""", RegexOption.IGNORE_CASE), "")
+
+    fun parse(text: String, fileName: String): ParseResult = try {
+        parseInternal(text, nameFromFileName(fileName))
+    } catch (e: Exception) {
+        // Defensive: parsing bugs must never crash the app.
+        ParseResult.Error("$fileName: could not be read (${e.javaClass.simpleName})")
+    }
+
+    private class Invalid(message: String) : Exception(message)
+
+    private fun parseInternal(text: String, name: String): ParseResult {
+        val sections = mutableMapOf<String, MutableList<MutableMap<String, MutableList<String>>>>()
+        var current: MutableMap<String, MutableList<String>>? = null
+        for (raw in text.removePrefix(BOM).lines()) {
+            val line = raw.substringBefore('#').trim()
+            if (line.isEmpty()) continue
+            SECTION.matchEntire(line)?.let {
+                current = mutableMapOf<String, MutableList<String>>().also { s -> sections.getOrPut(it.groupValues[1].lowercase()) { mutableListOf() }.add(s) }
+                continue
+            }
+            val section = current ?: continue
+            if ('=' !in line) continue
+            val key = line.substringBefore('=').trim().lowercase()
+            section.getOrPut(key) { mutableListOf() }.add(line.substringAfter('=').trim())
+        }
+
+        val iface = sections["interface"]?.firstOrNull() ?: return error(name, "missing [Interface] section")
+        return try {
+            val warnings = mutableListOf<String>()
+            val privateKey = iface.one("privatekey") ?: throw Invalid("missing PrivateKey")
+            checkKey(privateKey, "PrivateKey")
+
+            val addresses = splitList(iface["address"]).map { IpPrefix.parse(it) ?: throw Invalid("Address \"$it\" is not a valid IP address") }
+            if (addresses.none { it.address.isV4 }) throw Invalid("no IPv4 Address; BitProxy needs one for the TUN interface")
+
+            val dnsEntries = splitList(iface["dns"])
+            val dns = dnsEntries.mapNotNull(IpAddress::parse)
+            if (dns.isEmpty()) throw Invalid("no DNS server address")
+            dnsEntries.filter { IpAddress.parse(it) == null }.forEach { warnings += "ignored DNS search domain \"$it\"" }
+
+            val mtu = iface.one("mtu")?.let { it.toIntOrNull()?.takeIf { v -> v in 576..65535 } ?: throw Invalid("MTU \"$it\" is out of range (576-65535)") }
+
+            val peers = sections["peer"].orEmpty().mapIndexedNotNull { index, p -> parsePeer(p, index + 1, warnings) }
+            if (peers.isEmpty()) throw Invalid("no usable [Peer] section (needs PublicKey and Endpoint)")
+
+            ParseResult.Ok(WireGuardConf(name, addresses, privateKey, dns, mtu, peers), warnings.map { "$name: $it" })
+        } catch (e: Invalid) {
+            error(name, e.message!!)
+        }
+    }
+
+    private fun parsePeer(p: Map<String, List<String>>, number: Int, warnings: MutableList<String>): WireGuardPeer? {
+        val publicKey = p.one("publickey")
+        val endpoint = p.one("endpoint")
+        if (publicKey == null || endpoint == null) {
+            // Same as conf-merger.py: such peers are skipped, not fatal.
+            warnings += "skipped peer $number (missing ${if (publicKey == null) "PublicKey" else "Endpoint"})"
+            return null
+        }
+        checkKey(publicKey, "PublicKey of peer $number")
+        val (host, port) = parseEndpoint(endpoint) ?: throw Invalid("Endpoint \"$endpoint\" of peer $number must be host:port or [IPv6]:port")
+        val allowedIps = splitList(p["allowedips"]).onEach { if (IpPrefix.parse(it) == null) throw Invalid("AllowedIPs \"$it\" of peer $number is not a valid IP range") }
+            .ifEmpty { DEFAULT_ALLOWED_IPS }
+        val psk = p.one("presharedkey")?.also { checkKey(it, "PresharedKey of peer $number") }
+        val keepalive = p.one("persistentkeepalive")?.let {
+            if (it.equals("off", ignoreCase = true)) {
+                null
+            } else {
+                it.toIntOrNull()?.takeIf { v -> v in 0..65535 } ?: throw Invalid("PersistentKeepalive \"$it\" of peer $number is out of range (0-65535)")
+            }
+        }
+        return WireGuardPeer(host, port, publicKey, allowedIps, psk, keepalive)
+    }
+
+    /** Accepts "1.2.3.4:51820", "[2001:db8::1]:51820" and "vpn.example.com:51820". */
+    internal fun parseEndpoint(value: String): Pair<String, Int>? {
+        val colon = value.lastIndexOf(':')
+        if (colon <= 0) return null
+        val port = value.substring(colon + 1).toIntOrNull()?.takeIf { it in 1..65535 } ?: return null
+        val hostPart = value.substring(0, colon)
+        val host = if (hostPart.startsWith("[") && hostPart.endsWith("]")) {
+            hostPart.substring(1, hostPart.length - 1).takeIf { IpAddress.parse(it)?.isV4 == false }
+        } else {
+            // A bare IPv6 address without brackets is ambiguous with the port, so reject it.
+            hostPart.takeIf { ':' !in it && (IpAddress.parse(it) != null || HOSTNAME.matches(it)) }
+        }
+        return host?.let { it to port }
+    }
+
+    @OptIn(ExperimentalEncodingApi::class)
+    private fun checkKey(key: String, what: String) {
+        val bytes = try {
+            Base64.Default.decode(key)
+        } catch (_: IllegalArgumentException) {
+            null
+        }
+        if (bytes?.size != 32) throw Invalid("$what is not a valid WireGuard key (expected 44 base64 characters)")
+    }
+
+    private fun Map<String, List<String>>.one(key: String) = get(key)?.firstOrNull()?.takeIf { it.isNotEmpty() }
+
+    private fun splitList(values: List<String>?) = values.orEmpty().flatMap { it.split(',') }.map { it.trim() }.filter { it.isNotEmpty() }
+
+    private fun error(name: String, message: String) = ParseResult.Error("$name: $message")
+}
