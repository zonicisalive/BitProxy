+// SPDX-License-Identifier: GPL-3.0-or-later
+package io.nekohasekai.sfa.bitproxy.ui
+
+import io.nekohasekai.libbox.ConnectionEvents
+import io.nekohasekai.libbox.Libbox
+import io.nekohasekai.sfa.utils.CommandClient
+
+/** Per-uid bytes from sing-box connection events; [drain] returns and resets the window. */
+internal class AppTraffic : CommandClient.Handler {
+    private val uidOf = HashMap<String, Int>()
+    private val window = HashMap<Int, LongArray>() // uid -> [up, down]
+
+    @Synchronized
+    override fun writeConnectionEvents(events: ConnectionEvents) {
+        if (events.reset) uidOf.clear()
+        val it = events.iterator()
+        while (it.hasNext()) {
+            val e = it.next()
+            when (e.type) {
+                Libbox.ConnectionEventNew.toInt() -> e.connection?.processInfo?.let { uidOf[e.id] = it.userID }
+                Libbox.ConnectionEventUpdate.toInt() -> {
+                    val uid = uidOf[e.id] ?: e.connection?.processInfo?.userID ?: continue
+                    val w = window.getOrPut(uid) { LongArray(2) }
+                    w[0] += e.uplinkDelta
+                    w[1] += e.downlinkDelta
+                }
+                Libbox.ConnectionEventClosed.toInt() -> uidOf.remove(e.id)
+            }
+        }
+    }
+
+    @Synchronized
+    fun drain(): Map<Int, LongArray> = HashMap(window).also { window.clear() }
+}
+
+internal fun rateText(up: Long, down: Long, seconds: Double) = "↑ ${Libbox.formatBytes((up / seconds).toLong())}/s  ↓ ${Libbox.formatBytes((down / seconds).toLong())}/s"
