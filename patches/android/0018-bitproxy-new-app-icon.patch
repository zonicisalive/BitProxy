+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:pathData="M54,26 L76,34 V52 C76,66 66,77 54,82 C42,77 32,66 32,52 V34 Z" />
+    <path
+        android:strokeColor="#FF1D4ED8"
+        android:strokeWidth="4.5"
+        android:strokeLineCap="round"
+        android:strokeLineJoin="round"
+        android:pathData="M54,72 V58 M54,58 L45,47 M54,58 L63,47" />
+    <path
+        android:fillColor="#FF1D4ED8"
+        android:pathData="M40.5,41.5 L49.5,43.5 L42.5,50.5 Z M67.5,41.5 L58.5,43.5 L65.5,50.5 Z" />
+</vector>
diff --git a/app/src/main/res/drawable/ic_bitproxy_monochrome.xml b/app/src/main/res/drawable/ic_bitproxy_monochrome.xml
