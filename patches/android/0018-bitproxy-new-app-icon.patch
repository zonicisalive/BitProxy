diff --git a/app/src/main/res/mipmap-anydpi-v26/ic_launcher_bitproxy.xml b/app/src/main/res/mipmap-anydpi-v26/ic_launcher_bitproxy.xml
new file mode 100644
index 0000000..00f7832
--- /dev/null
+++ b/app/src/main/res/mipmap-anydpi-v26/ic_launcher_bitproxy.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@drawable/ic_bitproxy_background" />
+    <foreground android:drawable="@drawable/ic_bitproxy_foreground" />
+    <monochrome android:drawable="@drawable/ic_bitproxy_monochrome" />
+</adaptive-icon>
diff --git a/app/src/main/res/mipmap/ic_launcher_bitproxy.xml b/app/src/main/res/mipmap/ic_launcher_bitproxy.xml
new file mode 100644
index 0000000..7b8354d
--- /dev/null
+++ b/app/src/main/res/mipmap/ic_launcher_bitproxy.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
+<!-- Fallback for API 24-25 (no adaptive icons). -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:drawable="@drawable/ic_bitproxy_background" />
+    <item android:drawable="@drawable/ic_bitproxy_foreground" />
+</layer-list>
